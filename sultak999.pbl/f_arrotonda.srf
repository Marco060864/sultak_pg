global type f_arrotonda from function_object
end type

forward prototypes
global function decimal f_arrotonda (decimal adc_numero, integer ai_arrotondamento, string as_tipo_arrotondamento)
end prototypes

global function decimal f_arrotonda (decimal adc_numero, integer ai_arrotondamento, string as_tipo_arrotondamento);// ***********************************************************************************
//
//   Scopo: Arrotonda un numero adc_numero con una precisione ai_arrotondamento ed un tipo
//			di arrotondamento as_tipo_arrotondamento
//	Argomenti: 1) numero da arrotondare
//					2) cifra di arrotondamento
//             3) tipo di arrotondamento (I=inferiore, M=medio, S=superiore)
// ***********************************************************************************
decimal 	ldc_ret_number, ldc_precisione

If ai_arrotondamento >= 0 then
	ldc_precisione = 10^ai_arrotondamento
else
	ai_arrotondamento= - ai_arrotondamento
	ldc_precisione = 1 / (10^ai_arrotondamento)
end if

CHOOSE CASE as_tipo_arrotondamento
	CASE "I"
		
		ldc_ret_number = adc_numero / ldc_precisione
		ldc_ret_number = Truncate(ldc_ret_number, 0) * ldc_precisione
	CASE "M"
	
		ldc_ret_number = adc_numero / ldc_precisione
		ldc_ret_number = Round(ldc_ret_number, 0) * ldc_precisione
	CASE "S"
		
		ldc_ret_number = adc_numero / ldc_precisione
		ldc_ret_number = Ceiling(ldc_ret_number) * ldc_precisione
	CASE ELSE
END CHOOSE

RETURN ldc_ret_number
end function

