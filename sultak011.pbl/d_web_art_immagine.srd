 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"metallo~" )  TABLE(NAME=~"titolo~" )  TABLE(NAME=~"web_art~" ) COLUMN(NAME=~"titolo.tit_titolo~") COLUMN(NAME=~"metallo.met_metallo~") COLUMN(NAME=~"web_art.articolo_id~") COLUMN(NAME=~"web_art.codice~") COLUMN(NAME=~"web_art.descrizione~") COLUMN(NAME=~"web_art.id_web_categoria~") COLUMN(NAME=~"web_art.id_titolo~") COLUMN(NAME=~"web_art.peso~") COLUMN(NAME=~"web_art.misura~") COLUMN(NAME=~"web_art.coef_calo~") COLUMN(NAME=~"web_art.prezzo~") COLUMN(NAME=~"web_art.path_imm~") COLUMN(NAME=~"web_art.passato~") COLUMN(NAME=~"web_art.id_tubo~") COMPUTE(NAME=~"cast(0 as integer) as c_scelto~") COLUMN(NAME=~"web_art.des_fr~") COLUMN(NAME=~"web_art.des_en~")    JOIN (LEFT=~"metallo.met_id~"    OP =~"=~"RIGHT=~"titolo.tit_met_id~" )    JOIN (LEFT=~"web_art.id_titolo~"    OP =~"=~"RIGHT=~"titolo.tit_id~" )) " update="web_art" updatewhere=1 updatekeyinplace=yes  sort="codice A " )
