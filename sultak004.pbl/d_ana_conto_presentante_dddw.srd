 column=(type=long updatewhereclause=yes name=conto_id_tipo_conto dbname="conto.id_tipo_conto" )
 retrieve="  SELECT  conto.conto_id ,           conto.conto_codice ,           ana.ana_rag_sociale ,           conto.id_tipo_conto     FROM dba.ana ,          dba. conto ,           dba.val_base     WHERE ( conto.ana_id = ana.ana_id ) and          ( conto.id_tipo_conto = val_base.id_tipo_conto )   "  sort="conto_conto_codice A " )
