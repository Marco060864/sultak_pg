table(column=(type=char(8) updatewhereclause=yes name=listino_list_codice dbname="listino.list_codice" )
 column=(type=datetime updatewhereclause=yes name=validita_vali_da_data dbname="validita.vali_da_data" )
 column=(type=datetime updatewhereclause=yes name=validita_vali_a_data dbname="validita.vali_a_data" )
 column=(type=char(1) updatewhereclause=yes name=listino_list_tipo dbname="listino.list_tipo" )
 column=(type=char(1) updatewhereclause=yes name=listino_base dbname="listino.base" )
 column=(type=long updatewhereclause=yes identity=yes name=validita_vali_id dbname="validita.vali_id" )
 retrieve="  SELECT  listino.list_codice ,           validita.vali_da_data ,           validita.vali_a_data ,           listino.list_tipo ,           listino.base ,           validita.vali_id     
FROM dba.listino ,           dba.validita     WHERE ( validita.listino_id = listino.listino_id )   " )
compute(band=detail alignment="0" expression=" listino_list_codice +~" - Validità:~" +string( validita_vali_da_data )+ ~" fino ~"+string( validita_vali_a_data )+~" - Tipo:~"+ listino_list_tipo "border="0" color="0" x="7" y="3" height="77" width="1543" format="[GENERAL]" html.valueishtml="0"  name=compute_1 visible="1"  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
