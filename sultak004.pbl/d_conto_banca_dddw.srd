 retrieve="  SELECT  conto_banca.conto_id ,           conto_banca.banca_id ,           conto_banca.conto_banca_base ,           conto_banca.cin_internazionale ,         
  conto_banca.cin ,           conto_banca.c_c ,           conto_banca.conto_banca_id ,           banca.banca_den_abi ,        
   banca.banca_cod_cab ,           banca.banca_den_cab ,           banca.banca_cod_abi     FROM dba.conto_banca ,           dba.banca     WHERE ( conto_banca.banca_id = banca.banca_id ) and          ( ( conto_banca.conto_id = :id_conto ) )  " arguments=(("id_conto", number)) )
