release 10;
datawindow(units=0 timer_interval=0 color=80269524 processing=1 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes hidegrayline=no grid.lines=0 )
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=93 color="536870912" )
table(column=(type=long update=yes updatewhereclause=yes identity=yes name=reg_id dbname="registro.reg_id" )
 column=(type=char(32) update=yes updatewhereclause=yes name=reg_registro dbname="registro.reg_registro" )
 column=(type=long update=yes updatewhereclause=yes name=reg_numero dbname="registro.reg_numero" )
 column=(type=char(2) update=yes updatewhereclause=yes name=reg_tipo dbname="registro.reg_tipo" values="Iva Vendite	IV/Iva Acquisti	IA/Iva Corrispettivi	IC/Generico Acquisti	GA/Generico Vendite	GV/DDT Acquisti	DA/DDT Vendite 	DV/Preventivo Acquisti	PA/Preventivo Vendite	PV/Ordini Acquisti	OA/Ordini Vendite	OV/" )
 column=(type=long update=yes updatewhereclause=yes name=reg_ese_id dbname="registro.reg_ese_id" )
 column=(type=char(6) updatewhereclause=yes name=esercizio_ese_codice dbname="esercizio.ese_codice" )
 retrieve="  SELECT  registro.reg_id ,           registro.reg_registro ,           registro.reg_numero ,           registro.reg_tipo ,           registro.reg_ese_id ,           esercizio.ese_codice     FROM dba.registro , 
          dba.esercizio     WHERE ( registro.reg_ese_id = esercizio.ese_id )   "  sort="esercizio_ese_codice D reg_registro A reg_numero A " )
text(band=header alignment="2" text="Registro" border="2" color="33554432" x="7" y="10" height="64" width="922" html.valueishtml="0"  name=t_2 visible="1"  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=detail alignment="0" expression=" esercizio_ese_codice   + ~" - ~"+  reg_tipo +~" - ~"+string( reg_numero )  "border="5" color="0" x="7" y="10" height="64" width="922" format="[GENERAL]" html.valueishtml="0"  name=cod_univoco visible="1"  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
htmltable(border="1" )
htmlgen(clientevents="1" clientvalidation="1" clientcomputedfields="1" clientformatting="0" clientscriptable="0" generatejavascript="1" encodeselflinkargs="1" netscapelayers="0" )
xhtmlgen() cssgen(sessionspecific="0" )
xmlgen(inline="0" )
xsltgen()
jsgen()
export.xml(headgroups="1" includewhitespace="0" metadatatype=0 savemetadata=0 )
import.xml()
export.pdf(method=0 distill.custompostscript="0" xslfop.print="0" )
export.xhtml()
 