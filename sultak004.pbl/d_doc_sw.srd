 retrieve="  SELECT  doc.doc_id ,           doc.doc_num_prog ,           doc.doc_data_prog ,           doc.doc_numero ,           doc.doc_data ,      
     doc.doc_conto_id ,           doc.guida_id ,           doc.reg_id     FROM dba.doc    " update="dba.doc" updatewhere=1 updatekeyinplace=yes  sort="doc_data D doc_num_prog D doc_numero D " )
