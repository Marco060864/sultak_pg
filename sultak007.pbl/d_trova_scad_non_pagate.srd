 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_scadenza dbname="scadenza.id_scadenza" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scadenza~" ) COLUMN(NAME=~"scadenza.doc_id~") COLUMN(NAME=~"scadenza.scad_data~") COLUMN(NAME=~"scadenza.scad_importo~") COLUMN(NAME=~"scadenza.scad_pagato~") COLUMN(NAME=~"scadenza.ins_manualmente~") COLUMN(NAME=~"scadenza.data_pagamento~") COLUMN(NAME=~"scadenza.id_scadenza~")WHERE(    EXP1 =~"~~~"scadenza~~~".~~~"scad_data~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"scadenza~~~".~~~"scad_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " update="scadenza" updatewhere=1 updatekeyinplace=no arguments=(("da_data", date),("a_data", date))  sort="scad_data A " )
