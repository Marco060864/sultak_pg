table(column=(type=char(8) updatewhereclause=yes name=guida_guida_codice dbname="guida.guida_codice" )
 column=(type=long updatewhereclause=yes name=doc_doc_num_prog dbname="doc.doc_num_prog" )
 column=(type=datetime updatewhereclause=yes name=doc_doc_data_prog dbname="doc.doc_data_prog" )
 column=(type=char(16) updatewhereclause=yes name=doc_doc_numero dbname="doc.doc_numero" )
 column=(type=datetime updatewhereclause=yes name=doc_doc_data dbname="doc.doc_data" )
 column=(type=char(32) updatewhereclause=yes name=art_art_codice dbname="art.art_codice" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=rdoc_rdoc_peso dbname="rdoc.rdoc_peso" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=rdoc_rdoc_qta dbname="rdoc.rdoc_qta" )
 column=(type=char(1) update=yes updatewhereclause=yes name=rdoc_chius_forzata dbname="rdoc.chius_forzata" values="	S/	N" )
 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=rdoc_rdoc_id dbname="rdoc.rdoc_id" )
 retrieve="  SELECT  guida.guida_codice ,           doc.doc_num_prog ,           doc.doc_data_prog ,           doc.doc_numero ,           doc.doc_data ,        
   art.art_codice ,           rdoc.rdoc_peso ,           rdoc.rdoc_qta ,           rdoc.chius_forzata ,           rdoc.rdoc_id 
 FROM {oj dba.art RIGHT OUTER JOIN dba.rdoc ON art.art_id = rdoc.rdoc_art_id} ,           dba.doc ,           dba.guida    WHERE ( rdoc.rdoc_doc_id = doc.doc_id ) and          ( doc.guida_id = guida.guida_id ) and          ( ( rdoc.chius_forzata = 'S' ) )  " update="dba.rdoc" updatewhere=1 updatekeyinplace=yes )
