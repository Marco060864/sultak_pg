table(column=(type=long update=yes updatewhereclause=yes key=yes name=id_fattura dbname="ges_fatture.id_fattura" dbalias=".id_fattura" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=imp_riscosso dbname="ges_fatture.imp_riscosso" dbalias=".imp_riscosso" initial="0" )
 column=(type=date update=yes updatewhereclause=yes key=yes name=data_riscossione dbname="ges_fatture.data_riscossione" dbalias=".data_riscossione" )
 column=(type=char(16) updatewhereclause=yes name=doc_numero dbname="doc.doc_numero" dbalias=".doc_numero" )
 column=(type=date updatewhereclause=yes name=doc_data dbname="doc.doc_data" dbalias=".doc_data" )
 column=(type=decimal(4) updatewhereclause=yes name=c_tot_fattura dbname="c_tot_fattura" )
 column=(type=char(80) updatewhereclause=yes name=rag_sociale dbname="ana.ana_rag_sociale" dbalias=".ana_rag_sociale" )
 column=(type=char(2) updatewhereclause=yes name=registro_reg_tipo dbname="registro.reg_tipo" dbalias=".reg_tipo" )
 column=(type=long updatewhereclause=yes identity=yes name=doc_id dbname="doc.doc_id" dbalias=".doc_id" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ges_fatture~" )  TABLE(NAME=~"doc~" )  TABLE(NAME=~"ana~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"ges_fatture.id_fattura~") COLUMN(NAME=~"ges_fatture.imp_riscosso~") COLUMN(NAME=~"ges_fatture.data_riscossione~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COMPUTE(NAME=~"(select sum(civa_tot_iva) + sum(civa_tot_imp) from cast_iva where doc_id=ges_fatture.id_fattura) as c_tot_fattura~") COLUMN(NAME=~"ana.ana_rag_sociale~") COLUMN(NAME=~"registro.reg_tipo~") COLUMN(NAME=~"doc.doc_id~")    JOIN (LEFT=~"doc.doc_id~"    OP =~"=~"RIGHT=~"ges_fatture.id_fattura~"    OUTER1 =~"doc.doc_id~" )    JOIN (LEFT=~"ana.ana_id~"    OP =~"=~"RIGHT=~"conto.ana_id~" )    JOIN (LEFT=~"doc.doc_conto_id~"    OP =~"=~"RIGHT=~"conto.conto_id~" )    JOIN (LEFT=~"doc.reg_id~"    OP =~"=~"RIGHT=~"registro.reg_id~" )WHERE(    EXP1 =~"left(~~~"registro~~~".~~~"reg_tipo~~~", 1)~"   OP =~"=~"    EXP2 =~"'I'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " update="ges_fatture" updatewhere=1 updatekeyinplace=yes arguments=(("da_data", date),("a_data", date))  sort="rag_sociale A doc_data A doc_numero A id_fattura A " )
