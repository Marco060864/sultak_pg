table(column=(type=char(8) updatewhereclause=yes name=conto_codice dbname="conto.conto_codice" )
 column=(type=date update=yes updatewhereclause=yes name=scad_data dbname="scadenza.scad_data" )
 column=(type=long update=yes updatewhereclause=yes name=doc_id dbname="scadenza.doc_id" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=scad_importo dbname="scadenza.scad_importo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=scad_pagato dbname="scadenza.scad_pagato" values="Scadenza	N/Distinta	D/Pagata	P/Insoluta	I/" )
 column=(type=char(16) updatewhereclause=yes name=doc_doc_numero dbname="doc.doc_numero" )
 column=(type=date updatewhereclause=yes name=doc_doc_data dbname="doc.doc_data" )
 column=(type=long updatewhereclause=yes name=registro_reg_numero dbname="registro.reg_numero" )
 column=(type=char(2) updatewhereclause=yes name=registro_reg_tipo dbname="registro.reg_tipo" )
 column=(type=char(6) updatewhereclause=yes name=esercizio_ese_codice dbname="esercizio.ese_codice" )
 column=(type=char(80) updatewhereclause=yes name=ana_ana_rag_sociale dbname="ana.ana_rag_sociale" )
 column=(type=date update=yes updatewhereclause=yes name=scadenza_data_pagamento dbname="scadenza.data_pagamento" )
 column=(type=long update=yes updatewhereclause=yes name=scadenza_ins_manualmente dbname="scadenza.ins_manualmente" values="	1/	0" )
 column=(type=long updatewhereclause=yes name=c_scegli dbname="c_scegli" values="	1/	0" )
 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=scadenza_id_scadenza dbname="scadenza.id_scadenza" )
 column=(type=long updatewhereclause=yes name=riga_dis_banca_num_riga dbname="riga_dis_banca.num_riga" )
 column=(type=long updatewhereclause=yes name=riga_dis_banca_id_distinta_banca dbname="riga_dis_banca.id_distinta_banca" )
 column=(type=long updatewhereclause=yes name=distinta_banca_numero dbname="distinta_banca.numero" )
 column=(type=date updatewhereclause=yes name=distinta_banca_data dbname="distinta_banca.data" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"ana~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"doc~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"riga_dis_banca~" )  TABLE(NAME=~"distinta_banca~" ) COLUMN(NAME=~"conto.conto_codice~") COLUMN(NAME=~"scadenza.scad_data~") COLUMN(NAME=~"scadenza.doc_id~") COLUMN(NAME=~"scadenza.scad_importo~") COLUMN(NAME=~"scadenza.scad_pagato~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"registro.reg_numero~") COLUMN(NAME=~"registro.reg_tipo~") COLUMN(NAME=~"esercizio.ese_codice~") COLUMN(NAME=~"ana.ana_rag_sociale~") COLUMN(NAME=~"scadenza.data_pagamento~") COLUMN(NAME=~"scadenza.ins_manualmente~") COMPUTE(NAME=~"0 as c_scegli~") COLUMN(NAME=~"scadenza.id_scadenza~") COLUMN(NAME=~"riga_dis_banca.num_riga~") COLUMN(NAME=~"riga_dis_banca.id_distinta_banca~") COLUMN(NAME=~"distinta_banca.numero~") COLUMN(NAME=~"distinta_banca.data~")    JOIN (LEFT=~"riga_dis_banca.id_scadenza~"    OP =~"=~"RIGHT=~"scadenza.id_scadenza~"    OUTER2 =~"scadenza.id_scadenza~" )    JOIN (LEFT=~"riga_dis_banca.id_distinta_banca~"    OP =~"=~"RIGHT=~"distinta_banca.id_dist_banca~"    OUTER1 =~"riga_dis_banca.id_distinta_banca~" )   JOIN (LEFT=~"ana.ana_id~"    OP =~"=~"RIGHT=~"conto.ana_id~" )    JOIN (LEFT=~"doc.doc_conto_id~"    OP =~"=~"RIGHT=~"conto.conto_id~" )    JOIN (LEFT=~"scadenza.doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~" )    JOIN (LEFT=~"doc.reg_id~"    OP =~"=~"RIGHT=~"registro.reg_id~" )    JOIN (LEFT=~"registro.reg_ese_id~"    OP =~"=~"RIGHT=~"esercizio.ese_id~" ) ) " update="scadenza" updatewhere=1 updatekeyinplace=yes  sort="scad_data D ana_ana_rag_sociale A " )
