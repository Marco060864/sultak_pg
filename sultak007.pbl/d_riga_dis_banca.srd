 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"riga_dis_banca~" )  TABLE(NAME=~"doc~" ) COLUMN(NAME=~"riga_dis_banca.id_distinta_banca~") COLUMN(NAME=~"riga_dis_banca.id_scadenza~") COLUMN(NAME=~"riga_dis_banca.num_riga~") COLUMN(NAME=~"scadenza.scad_data~") COLUMN(NAME=~"scadenza.scad_importo~") COLUMN(NAME=~"scadenza.scad_pagato~") COLUMN(NAME=~"scadenza.data_pagamento~") COLUMN(NAME=~"doc.doc_num_prog~") COLUMN(NAME=~"doc.doc_data_prog~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"doc.doc_id~")    JOIN (LEFT=~"scadenza.id_scadenza~"    OP =~"=~"RIGHT=~"riga_dis_banca.id_scadenza~" )    JOIN (LEFT=~"doc.doc_id~"    OP =~"=~"RIGHT=~"scadenza.doc_id~" )WHERE(    EXP1 =~"~~~"riga_dis_banca~~~".~~~"id_distinta_banca~~~"~"   OP =~"=~"    EXP2 =~":id_distinta~" ) ) ARG(NAME = ~"id_distinta~" TYPE = number) " update="riga_dis_banca" updatewhere=1 updatekeyinplace=yes arguments=(("id_distinta", number)) )
