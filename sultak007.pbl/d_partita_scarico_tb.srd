 retrieve="  SELECT  partita_scarico.id_scarico ,           partita_scarico.id_apertura ,           partita_scarico.scarico ,       
    partita_scarico.numero ,           rdoc_b.rdoc_id ,           rdoc_b.finoecalo ,           doc_b.doc_num_prog ,  
         doc_b.doc_data_prog ,           doc_b.doc_numero ,           doc_b.doc_data ,           doc_a.doc_num_prog ,        
   doc_a.doc_data_prog ,           doc_a.doc_numero ,           doc_a.doc_data ,           rdoc_a.finoecalo ,           rdoc_b.rdoc_numero , 
          rdoc_a.rdoc_numero     FROM dba.partita_scarico ,           dba.rdoc rdoc_a ,           dba.rdoc rdoc_b ,           dba.doc doc_a ,           dba.doc doc_b   
  WHERE ( rdoc_a.rdoc_id = partita_scarico.id_apertura ) and          ( partita_scarico.id_scarico = rdoc_b.rdoc_id ) and          ( doc_a.doc_id = rdoc_a.rdoc_doc_id ) and          ( rdoc_b.rdoc_doc_id = doc_b.doc_id )   " filter=" doc_doc_data >DATE('2011-12-31')" sort="partita_scarico_id_apertura A partita_scarico_id_scarico A doc_doc_data A doc_doc_numero A partita_scarico_numero A " )
