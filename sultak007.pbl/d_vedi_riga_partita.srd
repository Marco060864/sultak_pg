 column=(type=long updatewhereclause=yes name=doc_doc_num_prog dbname="doc.doc_num_prog" )
 column=(type=datetime updatewhereclause=yes name=doc_doc_data_prog dbname="doc.doc_data_prog" )
 column=(type=char(16) updatewhereclause=yes name=doc_doc_numero dbname="doc.doc_numero" )
 column=(type=datetime updatewhereclause=yes name=doc_doc_data dbname="doc.doc_data" )
 column=(type=long updatewhereclause=yes name=rdoc_rdoc_numero dbname="rdoc.rdoc_numero" )
 column=(type=decimal(4) updatewhereclause=yes name=rdoc_rdoc_peso dbname="rdoc.rdoc_peso" )
 column=(type=decimal(4) updatewhereclause=yes name=rdoc_rdoc_qta dbname="rdoc.rdoc_qta" )
 column=(type=decimal(2) updatewhereclause=yes name=rdoc_rdoc_calo dbname="rdoc.rdoc_calo" )
 column=(type=decimal(4) updatewhereclause=yes name=rdoc_finoecalo dbname="rdoc.finoecalo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=rdoc_partita_oro dbname="rdoc.partita_oro" initial="S" values="	S/	N" )
 column=(type=long updatewhereclause=yes key=yes identity=yes name=rdoc_rdoc_id dbname="rdoc.rdoc_id" )
 column=(type=char(8) updatewhereclause=yes name=causale_caus_codice dbname="causale.caus_codice" )
 column=(type=char(8) updatewhereclause=yes name=guida_guida_codice dbname="guida.guida_codice" )
 retrieve="  SELECT  art.art_codice ,           doc.doc_num_prog ,           doc.doc_data_prog ,           doc.doc_numero ,   
        doc.doc_data ,           rdoc.rdoc_numero ,           rdoc.rdoc_peso ,           rdoc.rdoc_qta ,           rdoc.rdoc_calo ,     
      rdoc.finoecalo ,           rdoc.partita_oro ,           rdoc.rdoc_id ,           causale.caus_codice ,           guida.guida_codice     
FROM   dba.art ,           dba.doc ,           dba.rdoc ,           dba.guida ,           dba.causale     WHERE ( rdoc.rdoc_doc_id = doc.doc_id ) and          ( rdoc.rdoc_art_id = art.art_id ) and          ( guida.guida_id = doc.guida_id ) and          ( rdoc.causale_id = causale.caus_id )   " update="dba.rdoc" updatewhere=1 updatekeyinplace=yes  sort="doc_doc_data A doc_doc_num_prog A doc_doc_numero A " )
