PBSELECT( VERSION(400) TABLE(NAME="partita_scarico" )  TABLE(NAME="rdoc" ALIAS="rdoc_a" )  TABLE(NAME="rdoc" ALIAS="rdoc_b" )  TABLE(NAME="doc" ALIAS="doc_a" )  TABLE(NAME="doc" ALIAS="doc_b" ) COLUMN(NAME="partita_scarico.id_scarico") COLUMN(NAME="partita_scarico.id_apertura") COLUMN(NAME="partita_scarico.scarico") COLUMN(NAME="partita_scarico.numero") COLUMN(NAME="rdoc_b.rdoc_id") COLUMN(NAME="rdoc_b.finoecalo") COLUMN(NAME="doc_b.doc_num_prog") COLUMN(NAME="doc_b.doc_data_prog") COLUMN(NAME="doc_b.doc_numero") COLUMN(NAME="doc_b.doc_data") COLUMN(NAME="doc_a.doc_num_prog") COLUMN(NAME="doc_a.doc_data_prog") COLUMN(NAME="doc_a.doc_numero") COLUMN(NAME="doc_a.doc_data") COLUMN(NAME="rdoc_a.finoecalo")    JOIN (LEFT="rdoc_a.rdoc_id"    OP ="="RIGHT="partita_scarico.id_apertura" )    JOIN (LEFT="partita_scarico.id_scarico"    OP ="="RIGHT="rdoc_b.rdoc_id" )    JOIN (LEFT="doc_a.doc_id"    OP ="="RIGHT="rdoc_a.rdoc_doc_id" )    JOIN (LEFT="rdoc_b.rdoc_doc_id"    OP ="="RIGHT="doc_b.doc_id" )) 