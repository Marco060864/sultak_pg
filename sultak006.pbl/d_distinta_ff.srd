table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=distinta_id dbname="distinta.distinta_id" )
 column=(type=char(32) update=yes updatewhereclause=yes name=codice dbname="distinta.codice" )
 column=(type=char(96) update=yes updatewhereclause=yes name=descrizione dbname="distinta.descrizione" )
 column=(type=long update=yes updatewhereclause=yes name=art_id dbname="distinta.art_id" )
 column=(type=date update=yes updatewhereclause=yes name=data_inizio dbname="distinta.data_inizio" initial="today" )
 column=(type=date update=yes updatewhereclause=yes name=data_fine dbname="distinta.data_fine" )
 column=(type=long updatewhereclause=yes name=c_qta dbname="c_qta" )
 column=(type=char(32766) update=yes updatewhereclause=no name=nota dbname="distinta.nota" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"distinta~" ) COLUMN(NAME=~"distinta.distinta_id~") COLUMN(NAME=~"distinta.codice~") COLUMN(NAME=~"distinta.descrizione~") COLUMN(NAME=~"distinta.art_id~") COLUMN(NAME=~"distinta.data_inizio~") COLUMN(NAME=~"distinta.data_fine~") COMPUTE(NAME=~"0 AS c_qta~") COLUMN(NAME=~"distinta.nota~")WHERE(    EXP1 =~"( distinta.distinta_id~"   OP =~"=~"    EXP2 =~":id_distinta )~" ) ) ARG(NAME = ~"id_distinta~" TYPE = number) " update="distinta" updatewhere=1 updatekeyinplace=yes arguments=(("id_distinta", number)) )
