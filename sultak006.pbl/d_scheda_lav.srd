table(column=(type=long updatewhereclause=yes identity=yes name=distinta_distinta_id dbname="distinta.distinta_id" dbalias=".distinta_id" )
 column=(type=char(32) updatewhereclause=yes name=distinta_codice dbname="distinta.codice" dbalias=".codice" )
 column=(type=char(32) updatewhereclause=yes name=art_art_codice dbname="art.art_codice" dbalias=".art_codice" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_distinta_qta dbname="riga_distinta.qta" dbalias=".qta" )
 column=(type=decimal(4) updatewhereclause=yes name=riga_distinta_lunghezza dbname="riga_distinta.lunghezza" dbalias=".lunghezza" )
