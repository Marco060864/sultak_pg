 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"distinta~" )  TABLE(NAME=~"riga_distinta~" )  TABLE(NAME=~"art~" )  TABLE(NAME=~"art_foto~" ) COLUMN(NAME=~"distinta.distinta_id~") COLUMN(NAME=~"distinta.codice~") COLUMN(NAME=~"art.art_codice~") COLUMN(NAME=~"riga_distinta.qta~") COLUMN(NAME=~"riga_distinta.lunghezza~") COLUMN(NAME=~"riga_distinta.variabile~") COLUMN(NAME=~"riga_distinta.peso~") COLUMN(NAME=~"art_foto.art_foto~") COMPUTE(NAME=~"0 as a_qta~") COLUMN(NAME=~"distinta.descrizione~")    JOIN (LEFT=~"art.art_id~"    OP =~"=~"RIGHT=~"art_foto.art_id~"    OUTER1 =~"art.art_id~" )    JOIN (LEFT=~"riga_distinta.distinta_id~"    OP =~"=~"RIGHT=~"distinta.distinta_id~" )    JOIN (LEFT=~"art.art_id~"    OP =~"=~"RIGHT=~"riga_distinta.art_id~" )WHERE(    EXP1 =~"~~~"distinta~~~".~~~"distinta_id~~~"~"   OP =~"=~"    EXP2 =~":id_distinta~" ) ) ARG(NAME = ~"id_distinta~" TYPE = number) " arguments=(("id_distinta", number)) )
