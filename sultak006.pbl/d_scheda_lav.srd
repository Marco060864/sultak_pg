 column=(type=decimal(2) updatewhereclause=yes name=riga_distinta_peso dbname="riga_distinta.peso" dbalias=".peso" )
 column=(type=char(128) updatewhereclause=yes name=art_foto_art_foto dbname="art_foto.art_foto" dbalias=".art_foto" )
