 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_iva~" ) COLUMN(NAME=~"mov_iva.id_pd~") COLUMN(NAME=~"mov_iva.id_mov_iva~") COLUMN(NAME=~"mov_iva.iva_id~") COLUMN(NAME=~"mov_iva.imponibile~") COLUMN(NAME=~"mov_iva.imposta~") COMPUTE(NAME=~"cast(0.00 as numeric(18,2)) as  c_importo~") COMPUTE(NAME=~"'' as c_ultimo~")WHERE(    EXP1 =~"~~~"mov_iva~~~".~~~"id_pd~~~"~"   OP =~"=~"    EXP2 =~":id_pd~" ) ) ARG(NAME = ~"id_pd~" TYPE = number) " update="mov_iva" updatewhere=1 updatekeyinplace=yes arguments=(("id_pd", number)) )
