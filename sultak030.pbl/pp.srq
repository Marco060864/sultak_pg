PBSELECT( VERSION(400) TABLE(NAME="pnotaabic" ) COLUMN(NAME="pnotaabic.num_prog") COLUMN(NAME="pnotaabic.id_pnabic") COLUMN(NAME="pnotaabic.descrizione") COLUMN(NAME="pnotaabic.rif_matrice") COLUMN(NAME="pnotaabic.entrate") COLUMN(NAME="pnotaabic.uscite") COLUMN(NAME="pnotaabic.data_reg") COLUMN(NAME="pnotaabic.data_doc") COLUMN(NAME="pnotaabic.importata") COLUMN(NAME="pnotaabic.causale") COMPUTE(NAME="cast(today() as date) as data_giorno")) 