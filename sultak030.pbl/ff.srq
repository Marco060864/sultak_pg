PBSELECT( VERSION(400) TABLE(NAME="partita_doppia" )  TABLE(NAME="mov_iva" ) COLUMN(NAME="partita_doppia.id_pd") COLUMN(NAME="partita_doppia.data_registrazione") COLUMN(NAME="partita_doppia.data_documento") COLUMN(NAME="partita_doppia.num_registrazione") COLUMN(NAME="partita_doppia.num_documento") COLUMN(NAME="partita_doppia.descrizione") COLUMN(NAME="partita_doppia.val_id") COLUMN(NAME="partita_doppia.importo") COLUMN(NAME="partita_doppia.conto_id") COLUMN(NAME="partita_doppia.data_competenza") COLUMN(NAME="partita_doppia.data_comp_iva") COLUMN(NAME="partita_doppia.reg_id") COLUMN(NAME="partita_doppia.guida_pd_id") COLUMN(NAME="mov_iva.id_mov_iva") COLUMN(NAME="mov_iva.iva_id") COLUMN(NAME="mov_iva.imponibile") COLUMN(NAME="mov_iva.imposta")    JOIN (LEFT="mov_iva.id_pd"    OP ="="RIGHT="partita_doppia.id_pd" )WHERE(    EXP1 ="~"partita_doppia~".~"data_comp_iva~""   OP =">="    EXP2 =":da_data"    LOGIC ="And" ) WHERE(    EXP1 ="~"partita_doppia~".~"data_comp_iva~""   OP ="<="    EXP2 =":a_data" ) ) ARG(NAME = "da_data" TYPE = date)  ARG(NAME = "a_data" TYPE = date) 