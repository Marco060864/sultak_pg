 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"partita_doppia~" )  TABLE(NAME=~"mov_iva~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"ana~" )  TABLE(NAME=~"iva~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"azienda~" ) COLUMN(NAME=~"partita_doppia.id_pd~") COLUMN(NAME=~"partita_doppia.data_registrazione~") COLUMN(NAME=~"partita_doppia.data_documento~") COLUMN(NAME=~"partita_doppia.num_registrazione~") COLUMN(NAME=~"partita_doppia.num_documento~") COLUMN(NAME=~"partita_doppia.descrizione~") COLUMN(NAME=~"partita_doppia.val_id~") COLUMN(NAME=~"partita_doppia.importo~") COLUMN(NAME=~"partita_doppia.conto_id~") COLUMN(NAME=~"partita_doppia.data_competenza~") COLUMN(NAME=~"partita_doppia.data_comp_iva~") COLUMN(NAME=~"partita_doppia.reg_id~") COLUMN(NAME=~"partita_doppia.guida_pd_id~") COLUMN(NAME=~"mov_iva.id_mov_iva~") COLUMN(NAME=~"mov_iva.iva_id~") COLUMN(NAME=~"mov_iva.imponibile~") COLUMN(NAME=~"mov_iva.imposta~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"ana.ana_rag_sociale~") COLUMN(NAME=~"iva.iva_codice~") COLUMN(NAME=~"registro.reg_registro~") COLUMN(NAME=~"registro.reg_numero~") COLUMN(NAME=~"registro.reg_tipo~") COLUMN(NAME=~"azienda.az_rag_sociale~") COLUMN(NAME=~"partita_doppia.segno_iva~")    JOIN (LEFT=~"conto.ana_id~"    OP =~"=~"RIGHT=~"ana.ana_id~"    OUTER1 =~"conto.ana_id~" )    JOIN (LEFT=~"mov_iva.id_pd~"    OP =~"=~"RIGHT=~"partita_doppia.id_pd~"    OUTER2 =~"partita_doppia.id_pd~" )    JOIN (LEFT=~"iva.iva_id~"    OP =~"=~"RIGHT=~"mov_iva.iva_id~"    OUTER2 =~"mov_iva.iva_id~" )    JOIN (LEFT=~"conto.conto_id~"    OP =~"=~"RIGHT=~"partita_doppia.conto_id~" )    JOIN (LEFT=~"partita_doppia.reg_id~"    OP =~"=~"RIGHT=~"registro.reg_id~" )WHERE(    EXP1 =~"~~~"partita_doppia~~~".~~~"data_comp_iva~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"partita_doppia~~~".~~~"data_comp_iva~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"partita_doppia~~~".~~~"reg_id~~~"~"   OP =~"=~"    EXP2 =~":id_registro~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"id_registro~" TYPE = number) " arguments=(("da_data", date),("a_data", date),("id_registro", number))  sort="partita_doppia_data_registrazione A partita_doppia_num_registrazione A " )
