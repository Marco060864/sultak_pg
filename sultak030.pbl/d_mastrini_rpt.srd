table(column=(type=char(8) updatewhereclause=yes name=conto_conto_codice dbname="conto.conto_codice" dbalias=".conto_codice" )
 column=(type=char(255) updatewhereclause=yes name=conto_descrizione dbname="conto.descrizione" dbalias=".descrizione" )
 column=(type=long updatewhereclause=yes name=mov_pd_numero dbname="mov_pd.numero" dbalias=".numero" )
 column=(type=char(255) updatewhereclause=yes name=mov_pd_descrizione dbname="mov_pd.descrizione" dbalias=".descrizione" )
 column=(type=char(1) updatewhereclause=yes name=mov_pd_segno dbname="mov_pd.segno" dbalias=".segno" )
 column=(type=decimal(4) updatewhereclause=yes name=mov_pd_importo dbname="mov_pd.importo" dbalias=".importo" )
