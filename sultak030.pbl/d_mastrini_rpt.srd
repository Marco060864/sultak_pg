 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto~" )  TABLE(NAME=~"mov_pd~" )  TABLE(NAME=~"partita_doppia~" )  TABLE(NAME=~"registro~" ) COLUMN(NAME=~"conto.conto_codice~") COLUMN(NAME=~"conto.descrizione~") COLUMN(NAME=~"mov_pd.numero~") COLUMN(NAME=~"mov_pd.descrizione~") COLUMN(NAME=~"mov_pd.segno~") COLUMN(NAME=~"mov_pd.importo~") COLUMN(NAME=~"partita_doppia.data_registrazione~") COLUMN(NAME=~"partita_doppia.num_registrazione~") COLUMN(NAME=~"registro.reg_tipo~") COLUMN(NAME=~"partita_doppia.id_pd~")    JOIN (LEFT=~"partita_doppia.reg_id~"    OP =~"=~"RIGHT=~"registro.reg_id~" )    JOIN (LEFT=~"partita_doppia.id_pd~"    OP =~"=~"RIGHT=~"mov_pd.id_pd~" )    JOIN (LEFT=~"conto.conto_id~"    OP =~"=~"RIGHT=~"mov_pd.conto_id~" )WHERE(    EXP1 =~"~~~"partita_doppia~~~".~~~"data_registrazione~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"partita_doppia~~~".~~~"data_registrazione~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="conto_conto_codice A partita_doppia_data_registrazione A partita_doppia_num_registrazione A mov_pd_numero A " )
