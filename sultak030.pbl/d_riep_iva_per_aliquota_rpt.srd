 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"partita_doppia~" )  TABLE(NAME=~"mov_iva~" )  TABLE(NAME=~"iva~" ) COLUMN(NAME=~"partita_doppia.id_pd~") COLUMN(NAME=~"mov_iva.id_mov_iva~") COLUMN(NAME=~"mov_iva.iva_id~") COLUMN(NAME=~"mov_iva.imponibile~") COLUMN(NAME=~"mov_iva.imposta~") COLUMN(NAME=~"iva.iva_codice~") COLUMN(NAME=~"iva.iva_des~") COLUMN(NAME=~"iva.perc_detraibile~") COLUMN(NAME=~"iva.tipo~") COLUMN(NAME=~"iva.iva_aliquota~") COLUMN(NAME=~"partita_doppia.segno_iva~")    JOIN (LEFT=~"mov_iva.id_pd~"    OP =~"=~"RIGHT=~"partita_doppia.id_pd~" )    JOIN (LEFT=~"iva.iva_id~"    OP =~"=~"RIGHT=~"mov_iva.iva_id~" )WHERE(    EXP1 =~"~~~"partita_doppia~~~".~~~"data_comp_iva~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"partita_doppia~~~".~~~"data_comp_iva~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"partita_doppia~~~".~~~"reg_id~~~"~"   OP =~"=~"    EXP2 =~":id_reg~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"id_reg~" TYPE = number) " arguments=(("da_data", date),("a_data", date),("id_reg", number))  sort="iva_iva_codice A " )
