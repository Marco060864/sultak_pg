 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"mov_pd~" ) COLUMN(NAME=~"mov_pd.id_pd~") COLUMN(NAME=~"mov_pd.id_mov_pd~") COLUMN(NAME=~"mov_pd.numero~") COLUMN(NAME=~"mov_pd.descrizione~") COLUMN(NAME=~"mov_pd.conto_id~") COLUMN(NAME=~"mov_pd.segno~") COLUMN(NAME=~"mov_pd.importo~") COMPUTE(NAME=~"'' as ultimo~")WHERE(    EXP1 =~"~~~"mov_pd~~~".~~~"id_pd~~~"~"   OP =~"=~"    EXP2 =~":id_pd~" ) ) ARG(NAME = ~"id_pd~" TYPE = number) " update="mov_pd" updatewhere=1 updatekeyinplace=yes arguments=(("id_pd", number)) )
