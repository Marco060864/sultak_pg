table(column=(type=long update=yes updatewhereclause=yes name=num_prog dbname="pnotaabic.num_prog" dbalias=".num_prog" )
 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=id_pnabic dbname="pnotaabic.id_pnabic" dbalias=".id_pnabic" )
 column=(type=char(64) update=yes updatewhereclause=yes name=descrizione dbname="pnotaabic.descrizione" dbalias=".descrizione" )
 column=(type=long update=yes updatewhereclause=yes name=rif_matrice dbname="pnotaabic.rif_matrice" dbalias=".rif_matrice" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=entrate dbname="pnotaabic.entrate" dbalias=".entrate" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=uscite dbname="pnotaabic.uscite" dbalias=".uscite" )
 column=(type=date update=yes updatewhereclause=yes name=data_reg dbname="pnotaabic.data_reg" dbalias=".data_reg" initial="today" )
 column=(type=date update=yes updatewhereclause=yes name=data_doc dbname="pnotaabic.data_doc" dbalias=".data_doc" initial="today" )
 column=(type=char(1) update=yes updatewhereclause=yes name=importata dbname="pnotaabic.importata" dbalias=".importata" )
 column=(type=char(2) update=yes updatewhereclause=yes name=causale dbname="pnotaabic.causale" dbalias=".causale" )
 column=(type=long update=yes updatewhereclause=yes name=id_mov_domus dbname="pnotaabic.id_mov_domus" dbalias=".id_mov_domus" initial="0" )
 retrieve="  SELECT  ~"pnotaabic~".~"num_prog~" ,           ~"pnotaabic~".~"id_pnabic~" ,           ~"pnotaabic~".~"descrizione~" ,           ~"pnotaabic~".~"rif_matrice~" ,           ~"pnotaabic~".~"entrate~" ,           ~"pnotaabic~".~"uscite~" ,           ~"pnotaabic~".~"data_reg~" ,   
        ~"pnotaabic~".~"data_doc~" ,           ~"pnotaabic~".~"importata~" ,           ~"pnotaabic~".~"causale~" ,           ~"pnotaabic~".~"id_mov_domus~"            FROM ~"pnotaabic~"    " update="pnotaabic" updatewhere=1 updatekeyinplace=yes  sort="data_doc A c_ordina A rif_matrice A num_prog A " )
