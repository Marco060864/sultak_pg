RE(    EXP1 =~"~~~"partita_doppia~~~".~~~"data_comp_iva~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"partita_doppia~~~".~~~"data_comp_iva~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"partita_doppia~~~".~~~"reg_id~~~"~"   OP =~"=~"    EXP2 =~":id_registro~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"id_registro~" TYPE = number) " arguments=(("da_data", date),("a_data", date),("id_registro", number))  sort="partita_doppia_data_registrazione A partita_doppia_num_registrazione A " )
