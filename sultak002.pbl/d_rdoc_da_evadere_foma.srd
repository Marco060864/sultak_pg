 column=(type=decimal(4) updatewhereclause=yes name=rdoc_finoecalo dbname="rdoc.finoecalo" )
 column=(type=decimal(4) updatewhereclause=yes name=rdoc_finoecalo_evaso dbname="rdoc.finoecalo_evaso" )
 column=(type=char(1) updatewhereclause=yes name=doc_chius_forzata dbname="doc.chius_forzata" values="	S/	N" )
 column=(type=char(1) updatewhereclause=yes name=rdoc_chius_forzata dbname="rdoc.chius_forzata" values="	S/	N" )
 column=(type=long updatewhereclause=yes name=doc_paga_id dbname="doc.paga_id" )
 column=(type=long updatewhereclause=yes name=rdoc_causale_id dbname="rdoc.causale_id" )
 column=(type=decimal(2) updatewhereclause=yes name=rdoc_tara dbname="rdoc.tara" )
 column=(type=long updatewhereclause=yes name=rdoc_num_bollettina dbname="rdoc.num_bollettina" )
 column=(type=date updatewhereclause=yes name=rdoc_data_doc_rif dbname="rdoc.data_doc_rif" )
 column=(type=char(16) updatewhereclause=yes name=rdoc_num_doc_rif dbname="rdoc.num_doc_rif" )
 column=(type=long updatewhereclause=yes name=rdoc_num_riga_doc_rif dbname="rdoc.num_riga_doc_rif" )
 column=(type=char(36) updatewhereclause=yes name=rdoc_id_sdi_doc_rif dbname="rdoc.id_sdi_doc_rif" )
 column=(type=long updatewhereclause=yes name=rdoc_n_lacci dbname="rdoc.n_lacci" )
 column=(type=long updatewhereclause=yes name=rdoc_n_fili dbname="rdoc.n_fili" )
 retrieve="  SELECT ~"doc~".~"doc_id~",   
         ~"doc~".~"doc_num_prog~",   
         ~"doc~".~"doc_data_prog~",   
         ~"doc~".~"doc_numero~",   
         ~"doc~".~"doc_data~",   
         ~"ana~".~"ana_rag_sociale~",   
         ~"doc~".~"doc_conto_id~",   
         ~"doc~".~"val_id~",   
         ~"valuta~".~"val_codice~",   
         ~"doc~".~"nota~",   
         ~"doc~".~"guida_id~",   
         'N' as c_scegli,   
         ~"rdoc~".~"rdoc_id~",   
         ~"rdoc~".~"rdoc_art_id~",   
         ~"rdoc~".~"rdoc_peso~",   
         ~"rdoc~".~"rdoc_qta~",   
         ~"rdoc~".~"rdoc_qta_evasa~",   
         ~"rdoc~".~"rdoc_peso_evaso~",   
         ~"rdoc~".~"tit_id~",   
         ~"rdoc~".~"rdoc_calo~",   
         ~"rdoc~".~"rdoc_numero~",   
         'N' as c_tutto_doc,   
         ~"doc~".~"doc_a_mezzo~",   
         ~"rdoc~".~"finoecalo~",   
         ~"rdoc~".~"finoecalo_evaso~",   
         ~"doc~".~"chius_forzata~",   
         ~"rdoc~".~"chius_forzata~",   
         ~"doc~".~"paga_id~",   
         ~"rdoc~".~"causale_id~",   
         ~"rdoc~".~"tara~",   
         ~"rdoc~".~"num_bollettina~",   
         ~"rdoc~".~"data_doc_rif~",   
         ~"rdoc~".~"num_doc_rif~",   
         ~"rdoc~".~"num_riga_doc_rif~",   
         ~"rdoc~".~"id_sdi_doc_rif~",
~"rdoc~".~"n_lacci~",
~"rdoc~".~"n_fili~"

    FROM ~"doc~",   
         ~"ana~",   
         ~"conto~",   
         ~"valuta~",   
         ~"rdoc~"  
   WHERE ( ~"ana~".~"ana_id~" = ~"conto~".~"ana_id~" ) and  
         ( ~"doc~".~"doc_conto_id~" = ~"conto~".~"conto_id~" ) and  
         ( ~"doc~".~"val_id~" = ~"valuta~".~"val_id~" ) and  
         ( ~"rdoc~".~"rdoc_doc_id~" = ~"doc~".~"doc_id~" ) and  
         ( ( ~"doc~".~"doc_id~" = :id_doc ) AND  
         (~"rdoc~".~"chius_forzata~" <> 'S' OR  
         ~"rdoc~".~"chius_forzata~" is null) AND  
         ~"rdoc~".~"finoecalo~" - isnull( ~"rdoc~".~"finoecalo_evaso~", 0) > 0 )    
" arguments=(("id_doc", number)) )
