 column=(type=long update=yes updatewhereclause=yes name=lingua_id dbname="ana.lingua_id" initial="1" )
 column=(type=char(20) update=yes updatewhereclause=yes name=bollo dbname="ana.bollo" )
 column=(type=char(32766) update=yes updatewhereclause=yes name=nota dbname="ana.nota" )
