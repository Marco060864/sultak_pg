 column=(type=char(128) update=yes updatewhereclause=yes name=pec dbname="ana.pec" )
 column=(type=char(17) update=yes updatewhereclause=yes name=codeori dbname="ana.codeori" )
 column=(type=char(20) update=yes updatewhereclause=yes name=num_lic_guida dbname="ana.num_lic_guida" )
 column=(type=char(1) update=yes updatewhereclause=yes name=nat_giuridica dbname="ana.nat_giuridica" values="Persona Fisica	F/Persona Giuridica	G/" )
