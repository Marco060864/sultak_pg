 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ana~" ) COLUMN(NAME=~"ana.ana_id~") COLUMN(NAME=~"ana.ana_rag_sociale~") COLUMN(NAME=~"ana.ana_indirizzo~") COLUMN(NAME=~"ana.ana_localita~") COLUMN(NAME=~"ana.ana_cap~") COLUMN(NAME=~"ana.ana_citta~") COLUMN(NAME=~"ana.ana_provincia~") COLUMN(NAME=~"ana.ana_c_f~") COLUMN(NAME=~"ana.val_id~") COLUMN(NAME=~"ana.lingua_id~") COLUMN(NAME=~"ana.bollo~") COLUMN(NAME=~"ana.nota~") COLUMN(NAME=~"ana.rag_soc_2~") COLUMN(NAME=~"ana.ana_p_iva~") COLUMN(NAME=~"ana.nazione~") COLUMN(NAME=~"ana.barcode~") COLUMN(NAME=~"ana.e_mail_1~") COLUMN(NAME=~"ana.e_mail_2~") COLUMN(NAME=~"ana.cod_interscambio_ae~") COLUMN(NAME=~"ana.pec~") COLUMN(NAME=~"ana.codeori~") COLUMN(NAME=~"ana.num_lic_guida~") COLUMN(NAME=~"ana.nat_giuridica~") COLUMN(NAME=~"ana.cog_ritenute~") COLUMN(NAME=~"ana.nome_ritenute~")WHERE(    EXP1 =~"( ~~~"ana~~~".~~~"ana_id~~~"~"   OP =~"=~"    EXP2 =~":al_ana_id )~" ) ) ARG(NAME = ~"al_ana_id~" TYPE = number) " update="ana" updatewhere=1 updatekeyinplace=yes arguments=(("al_ana_id", number))  sort="ana_rag_sociale A " )
