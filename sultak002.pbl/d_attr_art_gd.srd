 column=(type=char(32) updatewhereclause=yes name=art_art_codice dbname="art.art_codice" )
 retrieve="  SELECT  ~"attr_articolo~".~"ata_id_articolo~" ,           ~"attr_articolo~".~"ata_id_attr_articolo~" ,  
         ~"attr_articolo~".~"ata_id_um_mov~" ,           ~"attr_articolo~".~"ata_id_um_mis~" ,           ~"attr_articolo~".~"ata_peso~" ,     
      ~"attr_articolo~".~"ata_misura~" ,           ~"attr_articolo~".~"ata_peso_non_prezioso~" ,           ~"art~".~"art_codice~" 
          FROM ~"attr_articolo~" ,      
     ~"art~"     WHERE ( ~"attr_articolo~".~"ata_id_attr_articolo~" = ~"art~".~"art_id~" ) and          ( ( ~"dba~".~"attr_articolo~".~"ata_id_articolo~" = :id_art ) )  " update="attr_articolo" updatewhere=1 updatekeyinplace=yes arguments=(("id_art", number))  sort="art_art_codice A " )
