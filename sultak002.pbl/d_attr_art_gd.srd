 column=(type=long update=yes updatewhereclause=yes name=ata_id_um_mov dbname="attr_articolo.ata_id_um_mov" )
 column=(type=long update=yes updatewhereclause=yes name=ata_id_um_mis dbname="attr_articolo.ata_id_um_mis" )
