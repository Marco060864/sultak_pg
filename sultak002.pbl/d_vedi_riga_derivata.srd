 column=(type=long updatewhereclause=yes identity=yes name=rdoc_rdoc_id dbname="rdoc.rdoc_id" dbalias=".rdoc_id" )
 column=(type=long updatewhereclause=yes name=rdoc_rdoc_numero dbname="rdoc.rdoc_numero" dbalias=".rdoc_numero" )
 column=(type=char(32766) updatewhereclause=no name=rdoc_rdoc_descrizione dbname="rdoc.rdoc_descrizione" dbalias=".rdoc_descrizione" )
