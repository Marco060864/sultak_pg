 column=(type=char(2) updatewhereclause=yes name=metallo_met_metallo dbname="metallo.met_metallo" dbalias=".met_metallo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"doc~" )  TABLE(NAME=~"art~" )  TABLE(NAME=~"titolo~" )  TABLE(NAME=~"metallo~" ) COLUMN(NAME=~"doc.doc_num_prog~") COLUMN(NAME=~"doc.doc_data_prog~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"rdoc.rdoc_id~") COLUMN(NAME=~"rdoc.rdoc_numero~") COLUMN(NAME=~"rdoc.rdoc_descrizione~") COLUMN(NAME=~"art.art_codice~") COLUMN(NAME=~"rdoc.rdoc_art_id~") COLUMN(NAME=~"rdoc.rdoc_peso~") COLUMN(NAME=~"rdoc.rdoc_qta~") COLUMN(NAME=~"titolo.tit_titolo~") COLUMN(NAME=~"metallo.met_metallo~")    JOIN (LEFT=~"doc.doc_id~"    OP =~"=~"RIGHT=~"rdoc.rdoc_doc_id~" )    JOIN (LEFT=~"art.art_id~"    OP =~"=~"RIGHT=~"rdoc.rdoc_art_id~" )    JOIN (LEFT=~"rdoc.tit_id~"    OP =~"=~"RIGHT=~"titolo.tit_id~" )    JOIN (LEFT=~"titolo.tit_met_id~"    OP =~"=~"RIGHT=~"metallo.met_id~" )WHERE(    EXP1 =~"~~~"rdoc~~~".~~~"rdoc_id_riga_madre~~~"~"   OP =~"=~"    EXP2 =~":id_riga~" ) ) ARG(NAME = ~"id_riga~" TYPE = number) " arguments=(("id_riga", number)) )
