 retrieve="  SELECT  conto.ana_id ,           conto.conto_id ,           conto.conto_codice ,           conto.sottomastro_id ,           conto.iva_id ,           conto.paga_id ,       
    conto.id_tipo_conto ,           conto.descrizione     FROM dba.conto      WHERE ( ~"dba~".~"conto~".~"ana_id~" = :al_ana )   " update="dba.conto" updatewhere=1 updatekeyinplace=yes arguments=(("al_ana", number))  sort="conto_codice A " )
