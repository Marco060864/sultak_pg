 column=(type=long update=yes updatewhereclause=yes name=prop_caus_trasp_id dbname="guida.prop_caus_trasp_id" )
 column=(type=long update=yes updatewhereclause=yes name=prop_asp_beni_id dbname="guida.prop_asp_beni_id" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"guida~" ) COLUMN(NAME=~"guida.guida_id~") COLUMN(NAME=~"guida.guida_codice~") COLUMN(NAME=~"guida.guida_caus_id~") COLUMN(NAME=~"guida.guida_reg_id~") COLUMN(NAME=~"guida.guida_id_magazzino~") COLUMN(NAME=~"guida.guida_tipo_doc~") COLUMN(NAME=~"guida.report_stampa~") COLUMN(NAME=~"guida.scorporo_iva~") COLUMN(NAME=~"guida.pref_conto~") COLUMN(NAME=~"guida.guida_art_id~") COLUMN(NAME=~"guida.tipo_documento_ae~") COLUMN(NAME=~"guida.fat_senza_ddt~") COLUMN(NAME=~"guida.prop_doc_a_mezzo~") COLUMN(NAME=~"guida.prop_trasp_id~") COLUMN(NAME=~"guida.prop_caus_trasp_id~") COLUMN(NAME=~"guida.prop_asp_beni_id~")) " update="guida" updatewhere=1 updatekeyinplace=yes  sort="guida_codice A " )
