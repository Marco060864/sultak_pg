 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"doc~" )  TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"causale~" ) COLUMN(NAME=~"rdoc.rdoc_peso~") COLUMN(NAME=~"rdoc.rdoc_qta~") COLUMN(NAME=~"rdoc.finoecalo~") COLUMN(NAME=~"causale.caus_mag_fino~") COLUMN(NAME=~"causale.caus_mag_pezzi~") COLUMN(NAME=~"causale.caus_fiscale~")    JOIN (LEFT=~"rdoc.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~" )    JOIN (LEFT=~"rdoc.causale_id~"    OP =~"=~"RIGHT=~"causale.caus_id~" )WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~">=~"    EXP2 =~":data_inizio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":data_fine~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"rdoc~~~".~~~"rdoc_art_id~~~"~"   OP =~"=~"    EXP2 =~":id_art~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"causale~~~".~~~"caus_mag_fino~~~"~"   OP =~">~"    EXP2 =~"' ' ~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"causale~~~".~~~"caus_mag_pezzi~~~"~"   OP =~">~"    EXP2 =~"' ')~" ) ) ARG(NAME = ~"id_art~" TYPE = number)  ARG(NAME = ~"data_inizio~" TYPE = date)  ARG(NAME = ~"data_fine~" TYPE = date) " arguments=(("id_art", number),("data_inizio", date),("data_fine", date)) )
