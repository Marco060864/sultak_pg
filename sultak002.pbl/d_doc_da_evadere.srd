table(column=(type=long updatewhereclause=yes identity=yes name=doc_doc_id dbname="doc.doc_id" dbalias=".doc_id" )
 column=(type=long updatewhereclause=yes name=doc_doc_num_prog dbname="doc.doc_num_prog" dbalias=".doc_num_prog" )
 column=(type=date updatewhereclause=yes name=doc_doc_data_prog dbname="doc.doc_data_prog" dbalias=".doc_data_prog" )
 column=(type=char(16) updatewhereclause=yes name=doc_doc_numero dbname="doc.doc_numero" dbalias=".doc_numero" )
 column=(type=date updatewhereclause=yes name=doc_doc_data dbname="doc.doc_data" dbalias=".doc_data" )
 column=(type=char(80) updatewhereclause=yes name=ana_ana_rag_sociale dbname="ana.ana_rag_sociale" dbalias=".ana_rag_sociale" )
 column=(type=long updatewhereclause=yes name=doc_doc_conto_id dbname="doc.doc_conto_id" dbalias=".doc_conto_id" )
 column=(type=long updatewhereclause=yes name=doc_val_id dbname="doc.val_id" dbalias=".val_id" )
 column=(type=char(4) updatewhereclause=yes name=valuta_val_codice dbname="valuta.val_codice" dbalias=".val_codice" )
 column=(type=char(32766) updatewhereclause=no name=doc_nota dbname="doc.nota" dbalias=".nota" )
 column=(type=long updatewhereclause=yes name=doc_guida_id dbname="doc.guida_id" dbalias=".guida_id" )
 column=(type=char(1) updatewhereclause=yes name=c_scegli dbname="c_scegli" initial="N" )
 column=(type=char(1) updatewhereclause=yes name=c_tutto_doc dbname="c_tutto_doc" initial="N" values="	S/	N" )
 column=(type=char(1) updatewhereclause=yes name=scelto dbname="doc.doc_a_mezzo" dbalias=".doc_a_mezzo" values="	S/	N" )
 column=(type=long updatewhereclause=yes name=doc_paga_id dbname="doc.paga_id" dbalias=".paga_id" )
 column=(type=char(1) updatewhereclause=yes name=doc_chius_forzata dbname="doc.chius_forzata" dbalias=".chius_forzata" values="	S/	N" )
 retrieve="  SELECT DISTINCT ~"doc~".~"doc_id~",   
         ~"doc~".~"doc_num_prog~",   
         ~"doc~".~"doc_data_prog~",   
         ~"doc~".~"doc_numero~",   
         ~"doc~".~"doc_data~",   
         ~"ana~".~"ana_rag_sociale~",   
         ~"doc~".~"doc_conto_id~",   
         ~"doc~".~"val_id~",   
         ~"valuta~".~"val_codice~",   
         ~"doc~".~"nota~",   
         ~"doc~".~"guida_id~",   
         'N' as c_scegli,   
         'N' as c_tutto_doc,   
         ~"doc~".~"doc_a_mezzo~",   
         ~"doc~".~"paga_id~",   
         ~"doc~".~"chius_forzata~"  
    FROM ~"doc~",   
         ~"ana~",   
         ~"conto~",   
         ~"valuta~",   
         ~"rdoc~"  
   WHERE ( ~"ana~".~"ana_id~" = ~"conto~".~"ana_id~" ) and  
         ( ~"doc~".~"doc_conto_id~" = ~"conto~".~"conto_id~" ) and  
         ( ~"doc~".~"val_id~" = ~"valuta~".~"val_id~" ) and  
         ( ~"rdoc~".~"rdoc_doc_id~" = ~"doc~".~"doc_id~" ) and  
         ( ( ~"dba~".~"doc~".~"doc_data~" <= :a_data ) AND  
         ( ~"dba~".~"doc~".~"doc_data~" >= :da_data ) AND  
         ( ~"dba~".~"doc~".~"guida_id~" = :id_guida ) AND  
         ( ~"dba~".~"conto~".~"conto_id~" = :id_conto ) AND  
         (~"rdoc~".~"chius_forzata~" <> 'S' OR  
         ~"rdoc~".~"chius_forzata~" is null) AND  
         ((~"rdoc~".~"rdoc_peso~" - isnull(~"rdoc~".~"rdoc_peso_evaso~", 0) > 0 OR  
         ~"rdoc~".~"rdoc_qta~" - isnull(~"rdoc~".~"rdoc_qta_evasa~", 0) > 0 OR  
         ~"rdoc~".~"finoecalo~" - isnull( ~"rdoc~".~"finoecalo_evaso~", 0) > 0)) )    
" arguments=(("id_conto", number),("id_guida", number),("da_data", date),("a_data", date)) )
