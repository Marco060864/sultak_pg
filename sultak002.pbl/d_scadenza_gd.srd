 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scadenza~" ) COLUMN(NAME=~"scadenza.doc_id~") COLUMN(NAME=~"scadenza.scad_data~") COLUMN(NAME=~"scadenza.scad_importo~") COLUMN(NAME=~"scadenza.scad_pagato~") COLUMN(NAME=~"scadenza.ins_manualmente~")WHERE(    EXP1 =~"~~~"dba~~~".~~~"scadenza~~~".~~~"doc_id~~~"~"   OP =~"=~"    EXP2 =~":DOC_ID~" ) ) ARG(NAME = ~"DOC_ID~" TYPE = number) " update="scadenza" updatewhere=1 updatekeyinplace=yes arguments=(("DOC_ID", number))  sort="scad_data A " )
