 column=(type=long updatewhereclause=yes name=partita_oro_id_apertura dbname="partita_oro.id_apertura" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"doc~" ALIAS=~"doc_a~" )  TABLE(NAME=~"partita_oro~" )  TABLE(NAME=~"partita_scarico~" )  TABLE(NAME=~"rdoc~" ALIAS=~"rdoc_a~" )  TABLE(NAME=~"doc~" ALIAS=~"doc_b~" )  TABLE(NAME=~"rdoc~" ALIAS=~"rdoc_b~" )  TABLE(NAME=~"causale~" )  TABLE(NAME=~"titolo~" ) COLUMN(NAME=~"doc_a.doc_numero~") COLUMN(NAME=~"doc_a.doc_data~") COLUMN(NAME=~"doc_a.doc_conto_id~") COLUMN(NAME=~"rdoc_a.finoecalo~") COLUMN(NAME=~"partita_oro.chiusa~") COLUMN(NAME=~"partita_scarico.id_scarico~") COLUMN(NAME=~"partita_scarico.scarico~") COLUMN(NAME=~"partita_scarico.numero~") COLUMN(NAME=~"doc_b.doc_numero~") COLUMN(NAME=~"doc_b.doc_data~") COLUMN(NAME=~"rdoc_b.finoecalo~") COLUMN(NAME=~"titolo.tit_titolo~") COLUMN(NAME=~"partita_scarico.id_apertura~") COLUMN(NAME=~"partita_oro.id_apertura~")    JOIN (LEFT=~"partita_scarico.id_apertura~"    OP =~"=~"RIGHT=~"partita_oro.id_apertura~"    OUTER2 =~"partita_oro.id_apertura~" )    JOIN (LEFT=~"partita_scarico.id_scarico~"    OP =~"=~"RIGHT=~"rdoc_b.rdoc_id~"    OUTER1 =~"partita_scarico.id_scarico~" )    JOIN (LEFT=~"rdoc_b.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc_b.doc_id~"    OUTER1 =~"rdoc_b.rdoc_doc_id~" )    JOIN (LEFT=~"rdoc_a.rdoc_id~"    OP =~"=~"RIGHT=~"partita_oro.id_apertura~" )    JOIN (LEFT=~"rdoc_a.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc_a.doc_id~" )    JOIN (LEFT=~"rdoc_a.causale_id~"    OP =~"=~"RIGHT=~"causale.caus_id~" )    JOIN (LEFT=~"rdoc_a.tit_id~"    OP =~"=~"RIGHT=~"titolo.tit_id~" )WHERE(    EXP1 =~"~~~"causale~~~".~~~"caus_partita~~~"~"   OP =~"=~"    EXP2 =~":tipo_partita~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"doc_a~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":data_fine~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"doc_a~~~".~~~"doc_conto_id~~~"~"   OP =~"=~"    EXP2 =~":conto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"titolo~~~".~~~"tit_met_id~~~"~"   OP =~"=~"    EXP2 =~":id_metallo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"partita_oro~~~".~~~"chiusa~~~"~"   OP =~"<>~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"tipo_partita~" TYPE = string)  ARG(NAME = ~"data_fine~" TYPE = date)  ARG(NAME = ~"conto~" TYPE = number)  ARG(NAME = ~"id_metallo~" TYPE = number) " update="partita_scarico" updatewhere=1 updatekeyinplace=yes arguments=(("tipo_partita", string),("data_fine", date),("conto", number),("id_metallo", number))  sort="partita_oro_id_apertura A doc_data A doc_numero A " )
