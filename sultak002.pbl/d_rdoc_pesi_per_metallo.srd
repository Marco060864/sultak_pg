 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"u_misura~" ) COLUMN(NAME=~"rdoc.rdoc_numero~") COLUMN(NAME=~"rdoc.rdoc_id~") COLUMN(NAME=~"rdoc.rdoc_doc_id~") COLUMN(NAME=~"rdoc.rdoc_art_id~") COLUMN(NAME=~"rdoc.tit_id~") COLUMN(NAME=~"rdoc.lega_id~") COLUMN(NAME=~"rdoc.rdoc_peso~") COLUMN(NAME=~"rdoc.rdoc_qta~") COLUMN(NAME=~"rdoc.um_id~") COLUMN(NAME=~"rdoc.rdoc_pr_man~") COLUMN(NAME=~"rdoc.rdoc_quotazione~") COLUMN(NAME=~"rdoc.rdoc_pr_gr_complessivo~") COLUMN(NAME=~"rdoc.rdoc_pr_pezzo~") COLUMN(NAME=~"rdoc.rdoc_misura~") COLUMN(NAME=~"rdoc.mag_id~") COLUMN(NAME=~"rdoc.causale_id~") COLUMN(NAME=~"rdoc.rdoc_calo~") COLUMN(NAME=~"rdoc.iva_id~") COLUMN(NAME=~"rdoc.rdoc_descrizione~") COLUMN(NAME=~"rdoc.rdoc_non_prezioso~") COLUMN(NAME=~"rdoc.rdoc_sconto_imp~") COLUMN(NAME=~"rdoc.rdoc_sconto_perc~") COLUMN(NAME=~"rdoc.rdoc_qta_evasa~") COLUMN(NAME=~"rdoc.rdoc_peso_evaso~") COLUMN(NAME=~"rdoc.rdoc_id_riga_madre~") COLUMN(NAME=~"rdoc.finoecalo~") COLUMN(NAME=~"rdoc.stampa~") COLUMN(NAME=~"rdoc.finoecalo_evaso~") COLUMN(NAME=~"rdoc.id_riga_articolo_padre~") COLUMN(NAME=~"rdoc.ata_id_attr_articolo~") COLUMN(NAME=~"rdoc.vali_id~") COLUMN(NAME=~"rdoc.tara~") COLUMN(NAME=~"u_misura.um_tipo~")    JOIN (LEFT=~"rdoc.um_id~"    OP =~"=~"RIGHT=~"u_misura.um_id~"    OUTER1 =~"rdoc.um_id~" )WHERE(    EXP1 =~"~~~"dba~~~".~~~"rdoc~~~".~~~"rdoc_doc_id~~~"~"   OP =~"=~"    EXP2 =~":al_doc_id~" ) ) ARG(NAME = ~"al_doc_id~" TYPE = number) " arguments=(("al_doc_id", number))  sort="rdoc_numero A " )
