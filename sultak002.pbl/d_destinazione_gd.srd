 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dba.destinazione~" ) COLUMN(NAME=~"dba.destinazione.ana_id~") COLUMN(NAME=~"dba.destinazione.dest_codice~") COLUMN(NAME=~"dba.destinazione.dest_id~") COLUMN(NAME=~"dba.destinazione.dest_rag_soc~") COLUMN(NAME=~"dba.destinazione.dest_indirizzo~") COLUMN(NAME=~"dba.destinazione.dest_cap~") COLUMN(NAME=~"dba.destinazione.dest_localita~") COLUMN(NAME=~"dba.destinazione.dest_provincia~") COLUMN(NAME=~"dba.destinazione.dest_nazione~") COLUMN(NAME=~"dba.destinazione.dest_tipo~")WHERE(    EXP1 =~"~~~"dba~~~".~~~"destinazione~~~".~~~"ana_id~~~"~"   OP =~"=~"    EXP2 =~":al_ana~" ) ) ARG(NAME = ~"al_ana~" TYPE = number) " update="dba.destinazione" updatewhere=1 updatekeyinplace=yes arguments=(("al_ana", number))  sort="dest_rag_soc A " )
