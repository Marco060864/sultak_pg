table(column=(type=long updatewhereclause=no name=doc_doc_id dbname="doc.doc_id" )
 column=(type=long updatewhereclause=no name=doc_doc_num_prog dbname="doc.doc_num_prog" )
 column=(type=date updatewhereclause=no name=doc_doc_data_prog dbname="doc.doc_data_prog" )
 column=(type=char(16) updatewhereclause=no name=doc_doc_numero dbname="doc.doc_numero" )
 column=(type=date updatewhereclause=no name=doc_doc_data dbname="doc.doc_data" )
 column=(type=long updatewhereclause=no name=doc_conto_id dbname="doc.doc_conto_id" )
 column=(type=long updatewhereclause=yes key=yes identity=yes name=rdoc_rdoc_id dbname="rdoc.rdoc_id" )
 column=(type=long updatewhereclause=yes name=rdoc_rdoc_numero dbname="rdoc.rdoc_numero" )
 column=(type=decimal(2) updatewhereclause=yes name=rdoc_rdoc_peso dbname="rdoc.rdoc_peso" )
 column=(type=char(1) update=yes updatewhereclause=yes name=rdoc_partita_oro dbname="rdoc.partita_oro" values="CHIUSA	C/APERTA	S/" )
 column=(type=decimal(2) updatewhereclause=yes name=rdoc_rdoc_calo dbname="rdoc.rdoc_calo" )
 column=(type=decimal(2) updatewhereclause=yes name=rdoc_finoecalo dbname="rdoc.finoecalo" )
 column=(type=long updatewhereclause=yes name=rdoc_tit_id dbname="rdoc.tit_id" )
 column=(type=decimal(3) updatewhereclause=no name=tot_scarico dbname="tot_scarico" )
 retrieve="  SELECT ~"doc~".~"doc_id~",   
         ~"doc~".~"doc_num_prog~",   
         ~"doc~".~"doc_data_prog~",   
         ~"doc~".~"doc_numero~",   
         ~"doc~".~"doc_data~",   
		~"doc~".~"doc_conto_id~",
         ~"rdoc~".~"rdoc_id~",   
         ~"rdoc~".~"rdoc_numero~",   
         ~"rdoc~".~"rdoc_peso~",   
         ~"rdoc~".~"partita_oro~",   
         ~"rdoc~".~"rdoc_calo~",   
         ~"rdoc~".~"finoecalo~"  ,  ~"rdoc~".~"tit_id~",
cast((select sum(scarico) from partita_scarico where id_apertura=rdoc_id) as decimal(10,3)) as tot_scarico
	 
    FROM ~"doc~", 
         ~"rdoc~" , ~"causale~"
   WHERE ( ~"rdoc~".~"rdoc_doc_id~" = ~"doc~".~"doc_id~" )  and  ~"rdoc~".~"rdoc_peso~">0
and causale.caus_c_s='C' and causale.caus_id=rdoc.causale_id" update="rdoc" updatewhere=2 updatekeyinplace=yes )
