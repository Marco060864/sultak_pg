table(column=(type=long update=yes updatewhereclause=yes key=yes name=paga_id dbname="rpaga.paga_id" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=rpaga_numero dbname="rpaga.rpaga_numero" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=rpaga_gg_decorrenza dbname="rpaga.rpaga_gg_decorrenza" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=rpaga_num_rate dbname="rpaga.rpaga_num_rate" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=rpaga_gg_rate dbname="rpaga.rpaga_gg_rate" )
 column=(type=char(1) update=yes updatewhereclause=yes name=rpaga_scadenza dbname="rpaga.rpaga_scadenza" values="Data Fattura	D/Fine Mese	M/" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=rpaga_fisso dbname="rpaga.rpaga_fisso" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=rpaga_per_iva dbname="rpaga.rpaga_per_iva" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=rpaga_per_imponibile dbname="rpaga.rpaga_per_imponibile" )
 column=(type=char(1) update=yes updatewhereclause=yes name=prima_rata dbname="rpaga.prima_rata" values="Come la altre	U/Solo IVA	I/" )
 retrieve="  SELECT  rpaga.paga_id ,           rpaga.rpaga_numero ,           rpaga.rpaga_gg_decorrenza ,           rpaga.rpaga_num_rate ,       
    rpaga.rpaga_gg_rate ,           rpaga.rpaga_scadenza ,           rpaga.rpaga_fisso ,           rpaga.rpaga_per_iva ,           rpaga.rpaga_per_imponibile ,           rpaga.prima_rata    
 FROM dba.rpaga      WHERE ( dba.rpaga.paga_id = :id_paga )   " update="dba.rpaga" updatewhere=1 updatekeyinplace=yes arguments=(("id_paga", number))  sort="rpaga_numero A " )
