table(column=(type=char(16) updatewhereclause=yes name=doc_numero dbname="doc.doc_numero" dbalias=".doc_numero" )
 column=(type=date updatewhereclause=yes name=doc_data dbname="doc.doc_data" dbalias=".doc_data" )
 column=(type=long updatewhereclause=yes name=doc_doc_conto_id dbname="doc.doc_conto_id" dbalias=".doc_conto_id" )
 column=(type=decimal(4) updatewhereclause=yes name=finoecalo_apertura_old dbname="rdoc.finoecalo" dbalias=".finoecalo" )
 column=(type=decimal(4) updatewhereclause=yes name=finoecalo_apertura dbname="finocalo_calcolato" )
 column=(type=decimal(2) updatewhereclause=yes name=titolo_tit_titolo dbname="titolo.tit_titolo" dbalias=".tit_titolo" )
 column=(type=decimal(3) updatewhereclause=yes name=tot_scarico dbname="tot_scarico" )
 column=(type=decimal(3) updatewhereclause=yes name=c_scarico dbname="c_scarico" )
 column=(type=long updatewhereclause=yes identity=yes name=rdoc_id dbname="rdoc.rdoc_id" dbalias=".rdoc_id" )
 column=(type=decimal(2) updatewhereclause=yes name=c_coef_calo dbname="c_coef_calo" )
 retrieve="  SELECT ~"doc~".~"doc_numero~",   
         ~"doc~".~"doc_data~",   
         ~"doc~".~"doc_conto_id~",   
         ~"rdoc~".~"finoecalo~",    (~"rdoc~".~"rdoc_peso~") as finocalo_calcolato,
         ~"titolo~".~"tit_titolo~",   
         cast((select sum(scarico) from partita_scarico where id_apertura=rdoc_id) as decimal(10,3)) as tot_scarico,   
         cast(0 as decimal(10,3))as c_scarico,   
         ~"rdoc~".~"rdoc_id~",   
         cast(0 as decimal(7,2)) as c_coef_calo  
    FROM ~"doc~",   
         ~"rdoc~",   
         ~"causale~",   
         ~"titolo~"  
   WHERE ( ~"rdoc~".~"rdoc_doc_id~" = ~"doc~".~"doc_id~" ) and  
         ( ~"rdoc~".~"causale_id~" = ~"causale~".~"caus_id~" ) and  
         ( ~"rdoc~".~"tit_id~" = ~"titolo~".~"tit_id~" ) and  
         ( ( ~"causale~".~"caus_partita~" = :tipo_partita ) AND  
         ( ~"doc~".~"doc_data~" <= :data_fine ) AND  
         ( ~"doc~".~"doc_conto_id~" = :conto ) AND  
         ( ~"titolo~".~"tit_met_id~" = :id_metallo ) AND  
		( ~"titolo~".~"tit_id~"=:id_titolo or ~"titolo~".~"tit_titolo~"=1000) and
         ( ~"causale~".~"caus_c_s~" = 'C' ) AND  
         ( ~"doc~".~"doc_data~" >= :data_inizio_saldi ) AND  
         (~"rdoc~".~"partita_oro~" <> 'C' OR  
         ~"rdoc~".~"partita_oro~" is null)   )    
" arguments=(("tipo_partita", string),("data_fine", date),("conto", number),("id_metallo", number),("data_inizio_saldi", date),("id_titolo", number))  sort="doc_data A doc_numero A " )
