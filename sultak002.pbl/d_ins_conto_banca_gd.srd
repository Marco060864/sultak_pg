 retrieve="  SELECT  conto_banca.conto_id ,           conto_banca.banca_id ,           conto_banca.conto_banca_base , 
          conto_banca.cin_internazionale ,           conto_banca.cin ,           conto_banca.c_c ,           conto_banca.conto_banca_id ,      
     conto.conto_codice ,           ana.ana_rag_sociale     FROM dba.ana ,           dba.conto ,      
     dba.conto_banca    
 WHERE ( conto.ana_id = ana.ana_id )
 and     
     ( conto.conto_id = conto_banca.conto_id )   " update="conto_banca" updatewhere=1 updatekeyinplace=yes  sort="ana_ana_rag_sociale A " )
