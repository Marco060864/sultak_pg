 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dba.sp_doc~" )  TABLE(NAME=~"dba.spesa~" ) COLUMN(NAME=~"dba.sp_doc.spesa_id~") COLUMN(NAME=~"dba.sp_doc.doc_id~") COLUMN(NAME=~"dba.sp_doc.iva_id~") COLUMN(NAME=~"dba.sp_doc.sp_doc_importo~") COLUMN(NAME=~"dba.sp_doc.sp_doc_percentuale~") COLUMN(NAME=~"dba.spesa.spesa_codice~")    JOIN (LEFT=~"dba.sp_doc.spesa_id~"    OP =~"=~"RIGHT=~"dba.spesa.spesa_id~" )WHERE(    EXP1 =~"~~~"dba~~~".~~~"sp_doc~~~".~~~"doc_id~~~"~"   OP =~"=~"    EXP2 =~":al_id_doc~" ) ) ARG(NAME = ~"al_id_doc~" TYPE = number) " update="dba.sp_doc" updatewhere=1 updatekeyinplace=yes arguments=(("al_id_doc", number))  sort="spesa_spesa_codice A " )
