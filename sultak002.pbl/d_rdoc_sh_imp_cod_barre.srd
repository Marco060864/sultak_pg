table(column=(type=long update=yes updatewhereclause=yes name=rdoc_numero dbname="rdoc.rdoc_numero" )
 column=(type=long update=yes updatewhereclause=yes identity=yes name=rdoc_id dbname="rdoc.rdoc_id" )
 column=(type=long update=yes updatewhereclause=yes name=rdoc_doc_id dbname="rdoc.rdoc_doc_id" )
 column=(type=long update=yes updatewhereclause=yes name=rdoc_art_id dbname="rdoc.rdoc_art_id" )
 column=(type=long update=yes updatewhereclause=yes name=tit_id dbname="rdoc.tit_id" )
 column=(type=long update=yes updatewhereclause=yes name=lega_id dbname="rdoc.lega_id" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=rdoc_peso dbname="rdoc.rdoc_peso" initial="0" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=rdoc_qta dbname="rdoc.rdoc_qta" initial="0" )
 column=(type=long update=yes updatewhereclause=yes name=um_id_tipo dbname="rdoc.um_id" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=rdoc_pr_man dbname="rdoc.rdoc_pr_man" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=rdoc_quotazione dbname="rdoc.rdoc_quotazione" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=rdoc_pr_gr_complessivo dbname="rdoc.rdoc_pr_gr_complessivo" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=rdoc_pr_pezzo dbname="rdoc.rdoc_pr_pezzo" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=rdoc_misura dbname="rdoc.rdoc_misura" )
 column=(type=long update=yes updatewhereclause=yes name=mag_id dbname="rdoc.mag_id" )
 column=(type=long update=yes updatewhereclause=yes name=causale_id dbname="rdoc.causale_id" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=rdoc_calo dbname="rdoc.rdoc_calo" )
 column=(type=long update=yes updatewhereclause=yes name=iva_id dbname="rdoc.iva_id" )
 column=(type=char(32766) update=yes updatewhereclause=no name=rdoc_descrizione dbname="rdoc.rdoc_descrizione" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=rdoc_non_prezioso dbname="rdoc.rdoc_non_prezioso" initial="0" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=rdoc_sconto_imp dbname="rdoc.rdoc_sconto_imp" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=rdoc_sconto_perc dbname="rdoc.rdoc_sconto_perc" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=rdoc_qta_evasa dbname="rdoc.rdoc_qta_evasa" initial="0" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=rdoc_peso_evaso dbname="rdoc.rdoc_peso_evaso" initial="0" )
 column=(type=long update=yes updatewhereclause=yes name=rdoc_id_riga_madre dbname="rdoc.rdoc_id_riga_madre" )
 column=(type=decimal(4) updatewhereclause=yes name=finoecalo dbname="rdoc.finoecalo" initial="0" )
 column=(type=char(1) update=yes updatewhereclause=yes name=stampa dbname="rdoc.stampa" initial="S" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=finoecalo_evaso dbname="rdoc.finoecalo_evaso" initial="0" )
 column=(type=long update=yes updatewhereclause=yes name=id_riga_articolo_padre dbname="rdoc.id_riga_articolo_padre" )
 column=(type=long updatewhereclause=yes name=ata_id_attr_articolo dbname="rdoc.ata_id_attr_articolo" )
 column=(type=long update=yes updatewhereclause=yes name=vali_id dbname="rdoc.vali_id" )
 column=(type=decimal(2) updatewhereclause=yes name=tara dbname="rdoc.tara" )
 column=(type=char(1) update=yes updatewhereclause=yes name=chius_forzata dbname="rdoc.chius_forzata" )
 column=(type=long update=yes updatewhereclause=yes name=id_taglia dbname="rdoc.id_taglia" )
 column=(type=long update=yes updatewhereclause=yes name=id_colore dbname="rdoc.id_colore" )
 column=(type=char(1) update=yes updatewhereclause=yes name=partita_oro dbname="rdoc.partita_oro" )
 column=(type=long update=yes updatewhereclause=yes name=num_bollettina dbname="rdoc.num_bollettina" )
 column=(type=date updatewhereclause=yes name=rdoc_data_doc_rif dbname="rdoc.data_doc_rif" )
 column=(type=char(16) updatewhereclause=yes name=rdoc_num_doc_rif dbname="rdoc.num_doc_rif" )
 column=(type=long updatewhereclause=yes name=rdoc_num_riga_doc_rif dbname="rdoc.num_riga_doc_rif" )
 column=(type=char(36) updatewhereclause=yes name=rdoc_id_sdi_doc_rif dbname="rdoc.id_sdi_doc_rif" )
 column=(type=long updatewhereclause=yes name=rdoc_n_lacci dbname="rdoc.n_lacci" )
 column=(type=long updatewhereclause=yes name=rdoc_n_fili dbname="rdoc.n_fili" )
 column=(type=char(1) updatewhereclause=yes name=um_tipo dbname="u_misura.um_tipo" )
 retrieve="  SELECT ~"rdoc~".~"rdoc_numero~",   
         ~"rdoc~".~"rdoc_id~",   
         ~"rdoc~".~"rdoc_doc_id~",   
         ~"rdoc~".~"rdoc_art_id~",   
         ~"rdoc~".~"tit_id~",   
         ~"rdoc~".~"lega_id~",   
         ~"rdoc~".~"rdoc_peso~",   
         ~"rdoc~".~"rdoc_qta~",   
         ~"rdoc~".~"um_id~",   
         ~"rdoc~".~"rdoc_pr_man~",   
         ~"rdoc~".~"rdoc_quotazione~",   
         ~"rdoc~".~"rdoc_pr_gr_complessivo~",   
         ~"rdoc~".~"rdoc_pr_pezzo~",   
         ~"rdoc~".~"rdoc_misura~",   
         ~"rdoc~".~"mag_id~",   
         ~"rdoc~".~"causale_id~",   
         ~"rdoc~".~"rdoc_calo~",   
         ~"rdoc~".~"iva_id~",   
         ~"rdoc~".~"rdoc_descrizione~",   
         ~"rdoc~".~"rdoc_non_prezioso~",   
         ~"rdoc~".~"rdoc_sconto_imp~",   
         ~"rdoc~".~"rdoc_sconto_perc~",   
         ~"rdoc~".~"rdoc_qta_evasa~",   
         ~"rdoc~".~"rdoc_peso_evaso~",   
         ~"rdoc~".~"rdoc_id_riga_madre~",   
         ~"rdoc~".~"finoecalo~",   
         ~"rdoc~".~"stampa~",   
         ~"rdoc~".~"finoecalo_evaso~",   
         ~"rdoc~".~"id_riga_articolo_padre~",   
         ~"rdoc~".~"ata_id_attr_articolo~",   
         ~"rdoc~".~"vali_id~",   
         ~"rdoc~".~"tara~",   
         ~"rdoc~".~"chius_forzata~",   
         ~"rdoc~".~"id_taglia~",   
         ~"rdoc~".~"id_colore~",   
         ~"rdoc~".~"partita_oro~",   
         ~"rdoc~".~"num_bollettina~",   
         ~"rdoc~".~"data_doc_rif~",   
         ~"rdoc~".~"num_doc_rif~",   
         ~"rdoc~".~"num_riga_doc_rif~",   
         ~"rdoc~".~"id_sdi_doc_rif~",   
         ~"rdoc~".~"n_lacci~",   
         ~"rdoc~".~"n_fili~",   
         ~"u_misura~".~"um_tipo~"  
    FROM {oj ~"rdoc~" LEFT OUTER JOIN ~"u_misura~" ON ~"rdoc~".~"um_id~" = ~"u_misura~".~"um_id~"},   
         ~"doc~",   
         ~"registro~"  
   WHERE ( ~"registro~".~"reg_id~" = ~"doc~".~"reg_id~" ) and  
         ( ~"rdoc~".~"rdoc_doc_id~" = ~"doc~".~"doc_id~" ) and  
         ( ( ~"rdoc~".~"num_bollettina~" = :al_doc_id ) AND  
         ( ~"registro~".~"reg_tipo~" = 'DA' ) )    
		order by ~"doc~".~"doc_id~" desc " arguments=(("al_doc_id", number))  sort="rdoc_id D " )
