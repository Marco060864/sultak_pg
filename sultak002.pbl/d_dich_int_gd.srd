 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto~" )  TABLE(NAME=~"sottomastro~" )  TABLE(NAME=~"mastro~" )  TABLE(NAME=~"dich_intento~" ) COLUMN(NAME=~"conto.di_ns_prot~") COLUMN(NAME=~"conto.di_vs_prot~") COLUMN(NAME=~"conto.di_ns_data~") COLUMN(NAME=~"conto.di_vs_data~") COLUMN(NAME=~"conto.di_ns_pag~") COLUMN(NAME=~"conto.di_uff_iva~") COLUMN(NAME=~"conto.anno_dich_intento~") COLUMN(NAME=~"dich_intento.id_dich_intento~") COLUMN(NAME=~"dich_intento.id_conto~") COLUMN(NAME=~"dich_intento.anno~") COLUMN(NAME=~"dich_intento.ns_numero~") COLUMN(NAME=~"dich_intento.vs_numero~") COLUMN(NAME=~"dich_intento.ns_data~") COLUMN(NAME=~"dich_intento.vs_data~") COLUMN(NAME=~"conto.conto_id~")    JOIN (LEFT=~"dich_intento.id_conto~"    OP =~"=~"RIGHT=~"conto.conto_id~"    OUTER2 =~"conto.conto_id~" )    JOIN (LEFT=~"conto.sottomastro_id~"    OP =~"=~"RIGHT=~"sottomastro.sottomastro_id~" )    JOIN (LEFT=~"mastro.mastro_id~"    OP =~"=~"RIGHT=~"sottomastro.mastro_id~" )WHERE(    EXP1 =~"( ( ~~~"mastro~~~".~~~"mastro_tipo~~~"~"   OP =~"=~"    EXP2 =~"'F' )~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"( ~~~"mastro~~~".~~~"mastro_tipo~~~"~"   OP =~"=~"    EXP2 =~"'C' ) )~" ) ) " update="dich_intento" updatewhere=1 updatekeyinplace=yes )
