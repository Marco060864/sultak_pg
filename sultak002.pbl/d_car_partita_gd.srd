table(column=(type=char(16) updatewhereclause=no name=doc_numero dbname="doc.doc_numero" )
 column=(type=date updatewhereclause=no name=doc_data dbname="doc.doc_data" )
 column=(type=long updatewhereclause=no name=doc_doc_conto_id dbname="doc.doc_conto_id" )
 column=(type=decimal(2) updatewhereclause=yes name=finoecalo_apertura dbname="rdoc.finoecalo" )
 column=(type=decimal(2) updatewhereclause=no name=titolo_tit_titolo dbname="titolo.tit_titolo" )
 column=(type=long updatewhereclause=yes key=yes identity=yes name=rdoc_id dbname="rdoc.rdoc_id" )
 column=(type=decimal(11) updatewhereclause=no name=f_c_da_peso dbname="f_c_da_peso" )
 column=(type=char(1) update=yes updatewhereclause=yes name=rdoc_partita_oro dbname="rdoc.partita_oro" )
 retrieve="  SELECT ~"doc~".~"doc_numero~",   
         ~"doc~".~"doc_data~",   
         ~"doc~".~"doc_conto_id~",   
         ~"rdoc~".~"finoecalo~",   
         ~"titolo~".~"tit_titolo~",   
         
         ~"rdoc~".~"rdoc_id~", (rdoc.rdoc_peso*rdoc_calo/1000) as f_c_da_peso, ~"rdoc~".~"partita_oro~"
    FROM ~"doc~",   
         ~"rdoc~",   
         ~"causale~",   
         ~"titolo~"  
   WHERE ( ~"rdoc~".~"rdoc_doc_id~" = ~"doc~".~"doc_id~" ) and  
         ( ~"rdoc~".~"causale_id~" = ~"causale~".~"caus_id~" ) and  
         ( ~"rdoc~".~"tit_id~" = ~"titolo~".~"tit_id~" ) and  
         ( ( ~"causale~".~"caus_partita~" = :tipo_partita ) AND  
         ( ~"doc~".~"doc_data~" <= :data_fine ) AND  
         ( ~"doc~".~"doc_conto_id~" = :conto ) AND  
         ( ~"titolo~".~"tit_met_id~" = :id_metallo ) AND  
         ( ~"causale~".~"caus_c_s~" = 'C' ) AND  
         ( ~"doc~".~"doc_data~" >= :data_inizio_saldi ) )
//AND   (~"rdoc~".~"partita_oro~" <> 'C' OR           ~"rdoc~".~"partita_oro~" is null)   )    
" update="rdoc" updatewhere=2 updatekeyinplace=yes arguments=(("tipo_partita", string),("data_fine", date),("conto", number),("id_metallo", number),("data_inizio_saldi", date))  sort="doc_data A doc_numero A " )
