 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"art~" ) COLUMN(NAME=~"art.art_id~") COLUMN(NAME=~"art.art_codice~") COLUMN(NAME=~"art.art_descrizione~") COLUMN(NAME=~"art.art_id_codifica~") COLUMN(NAME=~"art.art_creato~") COLUMN(NAME=~"art.art_modificato~") COLUMN(NAME=~"art.art_tit_preferenziale~") COLUMN(NAME=~"art.art_calo_preferenziale~") COLUMN(NAME=~"art.ruota~") COLUMN(NAME=~"art.st_in_catalogo~") COLUMN(NAME=~"art.peso~") COLUMN(NAME=~"art.um_id~") COLUMN(NAME=~"art.misura~") COLUMN(NAME=~"art.usa_in_magazzino~")WHERE(    EXP1 =~"~~~"art~~~".~~~"art_id~~~"~"   OP =~"=~"    EXP2 =~":art_id~" ) ) ARG(NAME = ~"art_id~" TYPE = number) " update="art" updatewhere=1 updatekeyinplace=yes arguments=(("art_id", number))  sort="art_codice A " )
