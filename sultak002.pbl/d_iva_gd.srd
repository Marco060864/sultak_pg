table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=iva_id dbname="iva.iva_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=iva_codice dbname="iva.iva_codice" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=iva_aliquota dbname="iva.iva_aliquota" )
 column=(type=char(100) update=yes updatewhereclause=yes name=iva_des dbname="iva.iva_des" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=perc_detraibile dbname="iva.perc_detraibile" )
 column=(type=char(2) update=yes updatewhereclause=yes name=tipo dbname="iva.tipo" values="Detraibile	DE/Non Detraibile	ND/Non Imponibile	NI/Esente	ES/Fuori Campo	FC/Esclusa	EX/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=esigibilita dbname="iva.esigibilita" values="Immediata	I/Differita	D/Scissione Pagamenti	S/" )
 column=(type=char(4) update=yes updatewhereclause=yes name=natura dbname="iva.natura" values="Escluse ex art.15	N1/non soggette ad IVA  artt. da 7 a 7-septies del DPR 633//1972	N2.1/non soggette – altri casi	N2.2/non imponibili – esportazioni	N3.1/non impi – cess. intracomunitarie	N3.2/non imp – cess. San Marino	N3.3/non imp– oper. assimilate alle cessioni all’esportazione	N3.4/non imp – a seguito di dich. intento	N3.5/non imp– altre operazioni NO plafond	N3.6/esenti	N4/regime margine // IVA non esposta in fattura	N5/inv. cont– cessione di rottami e altri materiali di recupero	N6.1/inv cont. – cessione di oro e argento puro	N6.2/inv cont– subappalto nel settore edile	N6.3/inv contabile – cessione di fabbricati	N6.4/inv cont – cessione di telefoni cellulari	N6.5/inv cont– cessione di prodotti elettronici	N6.6/inv cont– prestazioni comparto edile e settori connessi	N6.7/inv cont– operazioni settore energetico	N6.8/inv cont– altri casi	N6.9/IVA assolta in altro Stato UE (vendite a distanza ex art. 40 commi 3 e 4 e art. 41 comma 1 lett. b, DL 331//93; prestazione di servizi di telecomunicazioni, tele-radiodiffusione ed elettronici ex art. 7-sexies lett. f, g, DPR 633//72 e art. 74-sexies, DPR 6	N7/" )
 column=(type=char(2) update=yes updatewhereclause=yes name=deducibile dbname="iva.deducibile" values="Sì	SI/NO	NO/" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"iva~" ) COLUMN(NAME=~"iva.iva_id~") COLUMN(NAME=~"iva.iva_codice~") COLUMN(NAME=~"iva.iva_aliquota~") COLUMN(NAME=~"iva.iva_des~") COLUMN(NAME=~"iva.perc_detraibile~") COLUMN(NAME=~"iva.tipo~") COLUMN(NAME=~"iva.esigibilita~") COLUMN(NAME=~"iva.natura~") COLUMN(NAME=~"iva.deducibile~")) " update="iva" updatewhere=1 updatekeyinplace=yes  sort="iva_codice A " )
