 column=(type=long updatewhereclause=yes name=rdoc_num_bollettina dbname="rdoc.num_bollettina" dbalias=".num_bollettina" )
 column=(type=long updatewhereclause=yes name=rdoc_n_lacci dbname="rdoc.n_lacci" dbalias=".n_lacci" )
 column=(type=long updatewhereclause=yes name=rdoc_n_fili dbname="rdoc.n_fili" dbalias=".n_fili" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"doc~" )  TABLE(NAME=~"ana~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"valuta~" )  TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"titolo~" ) COLUMN(NAME=~"doc.doc_id~") COLUMN(NAME=~"doc.doc_num_prog~") COLUMN(NAME=~"doc.doc_data_prog~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"ana.ana_rag_sociale~") COLUMN(NAME=~"doc.doc_conto_id~") COLUMN(NAME=~"doc.val_id~") COLUMN(NAME=~"valuta.val_codice~") COLUMN(NAME=~"doc.nota~") COLUMN(NAME=~"doc.guida_id~") COMPUTE(NAME=~"'N' as c_scegli~") COLUMN(NAME=~"rdoc.rdoc_id~") COLUMN(NAME=~"rdoc.rdoc_art_id~") COLUMN(NAME=~"rdoc.rdoc_peso~") COLUMN(NAME=~"rdoc.rdoc_qta~") COLUMN(NAME=~"rdoc.rdoc_qta_evasa~") COLUMN(NAME=~"rdoc.rdoc_peso_evaso~") COLUMN(NAME=~"rdoc.tit_id~") COLUMN(NAME=~"rdoc.rdoc_calo~") COLUMN(NAME=~"rdoc.rdoc_numero~") COMPUTE(NAME=~"'N' as c_tutto_doc~") COLUMN(NAME=~"doc.doc_a_mezzo~") COLUMN(NAME=~"rdoc.finoecalo~") COLUMN(NAME=~"rdoc.finoecalo_evaso~") COLUMN(NAME=~"doc.chius_forzata~") COLUMN(NAME=~"rdoc.chius_forzata~") COLUMN(NAME=~"doc.paga_id~") COLUMN(NAME=~"rdoc.causale_id~") COLUMN(NAME=~"rdoc.num_bollettina~") COLUMN(NAME=~"rdoc.n_lacci~") COLUMN(NAME=~"rdoc.n_fili~")    JOIN (LEFT=~"ana.ana_id~"    OP =~"=~"RIGHT=~"conto.ana_id~" )    JOIN (LEFT=~"doc.doc_conto_id~"    OP =~"=~"RIGHT=~"conto.conto_id~" )    JOIN (LEFT=~"doc.val_id~"    OP =~"=~"RIGHT=~"valuta.val_id~" )    JOIN (LEFT=~"rdoc.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~" )    JOIN (LEFT=~"rdoc.tit_id~"    OP =~"=~"RIGHT=~"titolo.tit_id~" )WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_conto_id~~~"~"   OP =~"=~"    EXP2 =~":id_conto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"titolo~~~".~~~"tit_met_id~~~"~"   OP =~"=~"    EXP2 =~":id_metallo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"guida_id~~~"~"   OP =~"=~"    EXP2 =~":id_guida~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"rdoc~~~".~~~"chius_forzata~~~"~"   OP =~"<>~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(~~~"rdoc~~~".~~~"rdoc_peso~~~" - isnull(~~~"rdoc~~~".~~~"rdoc_peso_evaso~~~", 0)~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"rdoc~~~".~~~"rdoc_qta~~~" - isnull(~~~"rdoc~~~".~~~"rdoc_qta_evasa~~~", 0)~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"rdoc~~~".~~~"finoecalo~~~" - isnull( ~~~"rdoc~~~".~~~"finoecalo_evaso~~~", 0)~"   OP =~">~"    EXP2 =~"0)~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"id_guida~" TYPE = number)  ARG(NAME = ~"id_conto~" TYPE = number)  ARG(NAME = ~"id_metallo~" TYPE = number) " arguments=(("da_data", date),("a_data", date),("id_guida", number),("id_conto", number),("id_metallo", number)) )
