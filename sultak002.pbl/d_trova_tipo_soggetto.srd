 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ana~" )  TABLE(NAME=~"conto~" ) COLUMN(NAME=~"ana.ana_id~") COLUMN(NAME=~"ana.ana_rag_sociale~") COLUMN(NAME=~"conto.conto_id~") COLUMN(NAME=~"conto.conto_codice~")    JOIN (LEFT=~"ana.ana_id~"    OP =~"=~"RIGHT=~"conto.ana_id~" )WHERE(    EXP1 =~"~~~"ana~~~".~~~"ana_id~~~"~"   OP =~"=~"    EXP2 =~":id_ana~" ) ) ORDER(NAME=~"ana.ana_rag_sociale~" ASC=yes )  ORDER(NAME=~"conto.conto_codice~" ASC=yes ) ARG(NAME = ~"id_ana~" TYPE = number) " arguments=(("id_ana", number)) )
