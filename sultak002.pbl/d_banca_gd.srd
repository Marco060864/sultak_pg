 column=(type=long updatewhereclause=yes key=yes identity=yes name=banca_id dbname="banca.banca_id" )
 retrieve="  SELECT  banca.banca_cod_abi ,           banca.banca_den_abi ,           banca.banca_cod_cab ,           banca.banca_den_cab ,           banca.banca_id     FROM dba.banca    " update="dba.banca" updatewhere=0 updatekeyinplace=no  sort="banca_den_abi A " )
text(band=header alignment="2" text="Abi e Cab" border="2" color="0" x="7" y="10" height="64" width="472" html.valueishtml="0"  name=t_1 visible="1"  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
