compute(band=detail alignment="0" expression=" banca_den_abi +~" - ~"+if(isnull( banca_den_cab) , ~"-~", banca_den_cab )"border="0" color="33554432" x="486" y="10" height="80" width="1335" format="[GENERAL]" html.valueishtml="0"  name=compute_2 visible="1"  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1073741824" )
