 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cast_iva~" )  TABLE(NAME=~"iva~" )  TABLE(NAME=~"doc~" ) COLUMN(NAME=~"cast_iva.iva_id~") COLUMN(NAME=~"cast_iva.doc_id~") COLUMN(NAME=~"cast_iva.civa_spese~") COLUMN(NAME=~"cast_iva.civa_tot_imp~") COLUMN(NAME=~"cast_iva.civa_tot_iva~") COLUMN(NAME=~"iva.iva_codice~") COLUMN(NAME=~"doc.acconto~")    JOIN (LEFT=~"iva.iva_id~"    OP =~"=~"RIGHT=~"cast_iva.iva_id~" )    JOIN (LEFT=~"doc.doc_id~"    OP =~"=~"RIGHT=~"cast_iva.doc_id~" )WHERE(    EXP1 =~"~~~"dba~~~".~~~"cast_iva~~~".~~~"doc_id~~~"~"   OP =~"=~"    EXP2 =~":al_id_doc~" ) ) ARG(NAME = ~"al_id_doc~" TYPE = number) " update="cast_iva" updatewhere=1 updatekeyinplace=yes arguments=(("al_id_doc", number))  sort="iva_iva_codice A " )
