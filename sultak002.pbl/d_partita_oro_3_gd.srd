table(column=(type=char(16) updatewhereclause=yes name=doc_numero dbname="doc.doc_numero" )
 column=(type=date updatewhereclause=yes name=doc_data dbname="doc.doc_data" )
 column=(type=long updatewhereclause=yes name=doc_doc_conto_id dbname="doc.doc_conto_id" )
 column=(type=decimal(4) updatewhereclause=yes name=finoecalo_apertura dbname="rdoc.finoecalo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=partita_oro_chiusa dbname="partita_oro.chiusa" )
 column=(type=decimal(2) updatewhereclause=yes name=titolo_tit_titolo dbname="titolo.tit_titolo" )
 column=(type=long updatewhereclause=yes name=partita_oro_id_apertura dbname="partita_oro.id_apertura" )
 column=(type=decimal(2) updatewhereclause=yes name=tot_scarico dbname="tot_scarico" )
 column=(type=decimal(2) updatewhereclause=yes name=c_scarico dbname="c_scarico" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"doc~" )  TABLE(NAME=~"partita_oro~" )  TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"causale~" )  TABLE(NAME=~"titolo~" ) COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"doc.doc_conto_id~") COLUMN(NAME=~"rdoc.finoecalo~") COLUMN(NAME=~"partita_oro.chiusa~") COLUMN(NAME=~"titolo.tit_titolo~") COLUMN(NAME=~"partita_oro.id_apertura~") COMPUTE(NAME=~"cast((select sum(scarico) from partita_scarico where id_apertura=partita_oro.id_apertura) as decimal(10,2)) as tot_scarico~") COMPUTE(NAME=~"cast(0 as decimal(10,2))as c_scarico~")    JOIN (LEFT=~"rdoc.rdoc_id~"    OP =~"=~"RIGHT=~"partita_oro.id_apertura~" )    JOIN (LEFT=~"rdoc.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~" )    JOIN (LEFT=~"rdoc.causale_id~"    OP =~"=~"RIGHT=~"causale.caus_id~" )    JOIN (LEFT=~"rdoc.tit_id~"    OP =~"=~"RIGHT=~"titolo.tit_id~" )WHERE(    EXP1 =~"~~~"causale~~~".~~~"caus_partita~~~"~"   OP =~"=~"    EXP2 =~":tipo_partita~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":data_fine~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_conto_id~~~"~"   OP =~"=~"    EXP2 =~":conto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"titolo~~~".~~~"tit_met_id~~~"~"   OP =~"=~"    EXP2 =~":id_metallo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"partita_oro~~~".~~~"chiusa~~~"~"   OP =~"<>~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"tipo_partita~" TYPE = string)  ARG(NAME = ~"data_fine~" TYPE = date)  ARG(NAME = ~"conto~" TYPE = number)  ARG(NAME = ~"id_metallo~" TYPE = number) " arguments=(("tipo_partita", string),("data_fine", date),("conto", number),("id_metallo", number))  sort="partita_oro_id_apertura A doc_data A doc_numero A " )
