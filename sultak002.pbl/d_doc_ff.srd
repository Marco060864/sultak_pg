table(column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=doc_id dbname="doc.doc_id" )
 column=(type=long update=yes updatewhereclause=yes name=guida_id dbname="doc.guida_id" )
 column=(type=long update=yes updatewhereclause=yes name=doc_num_prog dbname="doc.doc_num_prog" )
 column=(type=date update=yes updatewhereclause=yes name=doc_data_prog dbname="doc.doc_data_prog" )
 column=(type=char(16) update=yes updatewhereclause=yes name=doc_numero dbname="doc.doc_numero" )
 column=(type=date update=yes updatewhereclause=yes name=doc_data dbname="doc.doc_data" )
 column=(type=long update=yes updatewhereclause=yes name=doc_conto_id dbname="doc.doc_conto_id" )
 column=(type=long update=yes updatewhereclause=yes name=reg_id dbname="doc.reg_id" )
 column=(type=char(1) update=yes updatewhereclause=yes name=doc_a_mezzo dbname="doc.doc_a_mezzo" values="Mittente	M/Destinatario	D/Vettore	V/Mittente-Vettore	U/" )
 column=(type=long update=yes updatewhereclause=yes name=caus_trasporto_id dbname="doc.caus_trasporto_id" )
 column=(type=long update=yes updatewhereclause=yes name=trasp_id dbname="doc.trasp_id" )
 column=(type=long update=yes updatewhereclause=yes name=val_id dbname="doc.val_id" )
 column=(type=long update=yes updatewhereclause=yes name=dest_id dbname="doc.dest_id" )
 column=(type=long update=yes updatewhereclause=yes name=conto_id_vettore dbname="doc.conto_id_vettore" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=doc_sconto_imp dbname="doc.doc_sconto_imp" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=doc_sconto_perc dbname="doc.doc_sconto_perc" )
 column=(type=long update=yes updatewhereclause=yes name=asp_beni_id dbname="doc.asp_beni_id" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=doc_colli dbname="doc.doc_colli" initial="1" )
 column=(type=long update=yes updatewhereclause=yes name=paga_id dbname="doc.paga_id" )
 column=(type=long update=yes updatewhereclause=yes name=banca_id dbname="doc.banca_id" )
 column=(type=char(32766) update=yes updatewhereclause=no name=nota dbname="doc.nota" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=peso_netto dbname="doc.peso_netto" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=peso_lordo dbname="doc.peso_lordo" )
 column=(type=datetime update=yes updatewhereclause=yes name=data_ora_trasporto dbname="doc.data_ora_trasporto" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=acconto dbname="doc.acconto" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=cambio dbname="doc.cambio" initial="1" )
 column=(type=long update=yes updatewhereclause=yes name=iva_sconto_importo dbname="doc.iva_sconto_importo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"doc~" ) COLUMN(NAME=~"doc.doc_id~") COLUMN(NAME=~"doc.guida_id~") COLUMN(NAME=~"doc.doc_num_prog~") COLUMN(NAME=~"doc.doc_data_prog~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"doc.doc_conto_id~") COLUMN(NAME=~"doc.reg_id~") COLUMN(NAME=~"doc.doc_a_mezzo~") COLUMN(NAME=~"doc.caus_trasporto_id~") COLUMN(NAME=~"doc.trasp_id~") COLUMN(NAME=~"doc.val_id~") COLUMN(NAME=~"doc.dest_id~") COLUMN(NAME=~"doc.conto_id_vettore~") COLUMN(NAME=~"doc.doc_sconto_imp~") COLUMN(NAME=~"doc.doc_sconto_perc~") COLUMN(NAME=~"doc.asp_beni_id~") COLUMN(NAME=~"doc.doc_colli~") COLUMN(NAME=~"doc.paga_id~") COLUMN(NAME=~"doc.banca_id~") COLUMN(NAME=~"doc.nota~") COLUMN(NAME=~"doc.peso_netto~") COLUMN(NAME=~"doc.peso_lordo~") COLUMN(NAME=~"doc.data_ora_trasporto~") COLUMN(NAME=~"doc.acconto~") COLUMN(NAME=~"doc.cambio~") COLUMN(NAME=~"doc.iva_sconto_importo~")WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_id~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" ) ) ARG(NAME = ~"id_doc~" TYPE = number) " update="doc" updatewhere=1 updatekeyinplace=yes arguments=(("id_doc", number))  sort="doc_data A doc_numero A " )
