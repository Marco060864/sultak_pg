 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"art~" )  TABLE(NAME=~"m_m_art_sog~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"ana~" ) COLUMN(NAME=~"prezzo.vali_id~") COLUMN(NAME=~"prezzo.art_id~") COLUMN(NAME=~"prezzo.pr_pezzo~") COLUMN(NAME=~"prezzo.pr_peso~") COLUMN(NAME=~"prezzo.pr_c_calo~") COLUMN(NAME=~"prezzo.pr_aggiuntivo~") COLUMN(NAME=~"art.art_codice~") COLUMN(NAME=~"prezzo.ins_manuale~") COLUMN(NAME=~"ana.ana_rag_sociale~")    JOIN (LEFT=~"prezzo.art_id~"    OP =~"=~"RIGHT=~"m_m_art_sog.id_art~"    OUTER1 =~"prezzo.art_id~" )    JOIN (LEFT=~"conto.conto_id~"    OP =~"=~"RIGHT=~"m_m_art_sog.id_sog~"    OUTER2 =~"m_m_art_sog.id_sog~" )    JOIN (LEFT=~"ana.ana_id~"    OP =~"=~"RIGHT=~"conto.ana_id~"    OUTER2 =~"conto.ana_id~" )   JOIN (LEFT=~"art.art_id~"    OP =~"=~"RIGHT=~"prezzo.art_id~" ) WHERE(    EXP1 =~"( ~~~"prezzo~~~".~~~"vali_id~~~"~"   OP =~"=~"    EXP2 =~":val_id )~" ) ) ARG(NAME = ~"val_id~" TYPE = number) " update="prezzo" updatewhere=1 updatekeyinplace=yes arguments=(("val_id", number))  sort="art_art_codice A " )
