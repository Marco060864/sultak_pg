PIPELINE(source_connect=prosperior,destination_connect=prosperior,type=update,commit=100,errors=1,keyname="conto")
SOURCE(name="ana/sog_commerciale_gen/sottomastro/mastro",COLUMN(type=long,name="id",dbtype="integer",nulls_allowed=no)
 COLUMN(type=varchar,name="sog_commerciale_gen.codice",dbtype="varchar(8)",nulls_allowed=no)
 COLUMN(type=long,name="sottomastro.sottomastro_id",dbtype="integer",nulls_allowed=no)
 COLUMN(type=long,name="ana.ana_id",dbtype="integer",key=yes,nulls_allowed=no))
RETRIEVE(statement="PBSELECT( VERSION(400) TABLE(NAME=~"ana~" )  TABLE(NAME=~"sog_commerciale_gen~" )  TABLE(NAME=~"sottomastro~" )  TABLE(NAME=~"mastro~" ) COMPUTE(NAME=~"cast(0 as integer) as id~") COLUMN(NAME=~"sog_commerciale_gen.codice~") COLUMN(NAME=~"sottomastro.sottomastro_id~") COLUMN(NAME=~"ana.ana_id~")    JOIN (LEFT=~"ana.ana_rag_sociale~"    OP =~"=~"RIGHT=~"sog_commerciale_gen.rag_soc_1~" )    JOIN (LEFT=~"mastro.mastro_id~"    OP =~"=~"RIGHT=~"sottomastro.mastro_id~" )WHERE(    EXP1 =~"~~~"sottomastro~~~".~~~"sottomastro_codice~~~"~"   OP =~"=~"    EXP2 =~"substr(~~~"sog_commerciale_gen~~~".~~~"codice~~~",3,2)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"mastro~~~".~~~"mastro_codice~~~"~"   OP =~"=~"    EXP2 =~"left(~~~"sog_commerciale_gen~~~".~~~"codice~~~",2)~" ) )")
DESTINATION(name="conto",COLUMN(type=long,name="conto_id",dbtype="integer",nulls_allowed=no,initial_value="exclude",default_value="autoincrement")
 COLUMN(type=varchar,name="conto_codice",dbtype="char(8)",key=yes,nulls_allowed=no,initial_value="spaces")
 COLUMN(type=long,name="sottomastro_id",dbtype="integer",nulls_allowed=no,initial_value="0")
 COLUMN(type=long,name="ana_id",dbtype="integer",nulls_allowed=yes)
 COLUMN(type=long,name="iva_id",dbtype="integer",nulls_allowed=yes)
 COLUMN(type=long,name="listino_id",dbtype="integer",nulls_allowed=yes)
 COLUMN(type=long,name="paga_id",dbtype="integer",nulls_allowed=yes)
 COLUMN(type=long,name="di_ns_prot",dbtype="integer",nulls_allowed=yes)
 COLUMN(type=long,name="di_vs_prot",dbtype="integer",nulls_allowed=yes)
 COLUMN(type=date,name="di_ns_data",dbtype="date",nulls_allowed=yes)
 COLUMN(type=date,name="di_vs_data",dbtype="date",nulls_allowed=yes)
 COLUMN(type=long,name="di_ns_pag",dbtype="integer",nulls_allowed=yes)
 COLUMN(type=varchar,name="di_uff_iva",dbtype="varchar(32)",nulls_allowed=yes))
