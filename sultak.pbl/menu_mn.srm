global menu_mn menu_mn

on menu_mn.create
menu_mn=this
call super::create
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_contabilita=create m_contabilita
this.m_soggetti=create m_soggetti
this.m_menu=create m_menu
this.m_utility=create m_utility
this.m_grafica=create m_grafica
this.m_sistema=create m_sistema
this.m_help=create m_help
this.m_distinteeriba=create m_distinteeriba
this.m_web=create m_web
this.m_new=create m_new
this.Item[UpperBound(this.Item)+1]=this.m_contabilita
this.Item[UpperBound(this.Item)+1]=this.m_soggetti
this.Item[UpperBound(this.Item)+1]=this.m_menu
this.Item[UpperBound(this.Item)+1]=this.m_utility
this.Item[UpperBound(this.Item)+1]=this.m_grafica
this.Item[UpperBound(this.Item)+1]=this.m_sistema
this.Item[UpperBound(this.Item)+1]=this.m_help
this.Item[UpperBound(this.Item)+1]=this.m_distinteeriba
this.Item[UpperBound(this.Item)+1]=this.m_web
this.Item[UpperBound(this.Item)+1]=this.m_new
end on

on menu_mn.destroy
call super::destroy
destroy(this.m_contabilita)
destroy(this.m_soggetti)
destroy(this.m_menu)
destroy(this.m_utility)
destroy(this.m_grafica)
destroy(this.m_sistema)
destroy(this.m_help)
destroy(this.m_distinteeriba)
destroy(this.m_web)
destroy(this.m_new)
end on

event clicked;OpenSheet(w_pnota, w_mdi, 2, Original!)
end event

