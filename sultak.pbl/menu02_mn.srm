global menu02_mn menu02_mn

on menu02_mn.create
menu02_mn=this
call super::create
this.m_anagrafichevarie=create m_anagrafichevarie
this.m_soggetti=create m_soggetti
this.m_anagrafichemagazzino=create m_anagrafichemagazzino
this.m_menu=create m_menu
this.m_stampe=create m_stampe
this.m_utility=create m_utility
this.m_grafica=create m_grafica
this.m_sistema=create m_sistema
this.m_help=create m_help
this.m_contabilità=create m_contabilità
this.Item[UpperBound(this.Item)+1]=this.m_anagrafichevarie
this.Item[UpperBound(this.Item)+1]=this.m_soggetti
this.Item[UpperBound(this.Item)+1]=this.m_anagrafichemagazzino
this.Item[UpperBound(this.Item)+1]=this.m_menu
this.Item[UpperBound(this.Item)+1]=this.m_stampe
this.Item[UpperBound(this.Item)+1]=this.m_utility
this.Item[UpperBound(this.Item)+1]=this.m_grafica
this.Item[UpperBound(this.Item)+1]=this.m_sistema
this.Item[UpperBound(this.Item)+1]=this.m_help
this.Item[UpperBound(this.Item)+1]=this.m_contabilità
end on

on menu02_mn.destroy
call super::destroy
destroy(this.m_anagrafichevarie)
destroy(this.m_soggetti)
destroy(this.m_anagrafichemagazzino)
destroy(this.m_menu)
destroy(this.m_stampe)
destroy(this.m_utility)
destroy(this.m_grafica)
destroy(this.m_sistema)
destroy(this.m_help)
destroy(this.m_contabilità)
end on

