PIPELINE(source_connect=fomacometa,destination_connect=fomasultak,type=update,commit=100,errors=100,keyname="ana")
SOURCE(name="anagrafica",COLUMN(type=long,name="id_anagrafica",dbtype="integer",key=yes,nulls_allowed=no)
 COLUMN(type=varchar,name="rag_soc_1",dbtype="char(40)",nulls_allowed=no)
 COLUMN(type=varchar,name="indirizzo",dbtype="char(40)",nulls_allowed=yes)
 COLUMN(type=varchar,name="localita",dbtype="char(40)",nulls_allowed=yes)
 COLUMN(type=varchar,name="cap",dbtype="char(10)",nulls_allowed=yes)
 COLUMN(type=varchar,name="provincia",dbtype="char(5)",nulls_allowed=yes)
 COLUMN(type=varchar,name="nazione",dbtype="char(5)",nulls_allowed=yes)
 COLUMN(type=varchar,name="cod_fiscale",dbtype="char(16)",nulls_allowed=yes)
 COLUMN(type=varchar,name="par_iva",dbtype="char(16)",nulls_allowed=yes)
 COLUMN(type=varchar,name="bollo",dbtype="char(20)",nulls_allowed=yes))
RETRIEVE(statement="PBSELECT( VERSION(400) TABLE(NAME=~"anagrafica~" ) COLUMN(NAME=~"anagrafica.id_anagrafica~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.indirizzo~") COLUMN(NAME=~"anagrafica.localita~") COLUMN(NAME=~"anagrafica.cap~") COLUMN(NAME=~"anagrafica.provincia~") COLUMN(NAME=~"anagrafica.nazione~") COLUMN(NAME=~"anagrafica.cod_fiscale~") COLUMN(NAME=~"anagrafica.par_iva~") COLUMN(NAME=~"anagrafica.bollo~")) ")
DESTINATION(name="ana",COLUMN(type=long,name="ana_id",dbtype="integer",key=yes,nulls_allowed=no,initial_value="0",default_value="autoincrement")
 COLUMN(type=varchar,name="ana_rag_sociale",dbtype="varchar(80)",nulls_allowed=no,initial_value="spaces")
 COLUMN(type=varchar,name="ana_indirizzo",dbtype="varchar(40)",nulls_allowed=yes)
 COLUMN(type=varchar,name="ana_localita",dbtype="varchar(40)",nulls_allowed=yes)
 COLUMN(type=varchar,name="ana_cap",dbtype="char(5)",nulls_allowed=yes)
 COLUMN(type=varchar,name="ana_citta",dbtype="char(16)",nulls_allowed=yes)
 COLUMN(type=varchar,name="ana_provincia",dbtype="char(2)",nulls_allowed=yes)
 COLUMN(type=varchar,name="ana_p_iva",dbtype="varchar(16)",nulls_allowed=yes)
 COLUMN(type=varchar,name="ana_c_f",dbtype="char(16)",nulls_allowed=yes)
 COLUMN(type=long,name="val_id",dbtype="integer",nulls_allowed=yes)
 COLUMN(type=long,name="lingua_id",dbtype="integer",nulls_allowed=yes)
 COLUMN(type=varchar,name="bollo",dbtype="char(20)",nulls_allowed=yes)
 COLUMN(type=string,name="nota",dbtype="long varchar",nulls_allowed=yes)
 COLUMN(type=varchar,name="rag_soc_2",dbtype="varchar(80)",nulls_allowed=yes)
 COLUMN(type=varchar,name="nazione",dbtype="char(3)",nulls_allowed=yes))
