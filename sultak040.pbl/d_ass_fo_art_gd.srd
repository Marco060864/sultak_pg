 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"doc~" ) COLUMN(NAME=~"rdoc.rdoc_numero~") COLUMN(NAME=~"rdoc.rdoc_id~") COLUMN(NAME=~"rdoc.rdoc_art_id~") COLUMN(NAME=~"rdoc.rdoc_pr_pezzo~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_conto_id~")    JOIN (LEFT=~"doc.doc_id~"    OP =~"=~"RIGHT=~"rdoc.rdoc_doc_id~" )WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("da_data", date),("a_data", date))  sort="art_id A conto_id A doc_doc_data A doc_doc_numero A " )
