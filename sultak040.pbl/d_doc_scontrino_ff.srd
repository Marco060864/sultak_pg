 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"doc~" ) COLUMN(NAME=~"doc.doc_id~") COLUMN(NAME=~"doc.doc_conto_id~") COLUMN(NAME=~"doc.reg_id~") COLUMN(NAME=~"doc.val_id~") COLUMN(NAME=~"doc.guida_id~") COLUMN(NAME=~"doc.nota~") COLUMN(NAME=~"doc.doc_num_prog~") COLUMN(NAME=~"doc.doc_data_prog~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~")WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_id~~~"~"   OP =~"=~"    EXP2 =~":ll_id_doc~" ) ) ARG(NAME = ~"ll_id_doc~" TYPE = number) " update="doc" updatewhere=1 updatekeyinplace=yes arguments=(("ll_id_doc", number)) )
