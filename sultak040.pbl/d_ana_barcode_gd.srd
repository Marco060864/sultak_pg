 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ana~" )  TABLE(NAME=~"conto~" ) COLUMN(NAME=~"ana.ana_id~") COLUMN(NAME=~"ana.ana_rag_sociale~") COLUMN(NAME=~"conto.conto_id~") COLUMN(NAME=~"conto.conto_codice~") COLUMN(NAME=~"conto.barcode~") COMPUTE(NAME=~"0 as scelto~")    JOIN (LEFT=~"conto.ana_id~"    OP =~"=~"RIGHT=~"ana.ana_id~" )WHERE(    EXP1 =~"left(~~~"conto~~~".~~~"conto_codice~~~", 2)~"   OP =~"=~"    EXP2 =~"'CL'~" ) ) " update="conto" updatewhere=1 updatekeyinplace=yes )
