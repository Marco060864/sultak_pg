         ~"ana_a~".~"ana_p_iva~",   
         ~"iva~".~"iva_codice~",   
         ~"art~".~"art_codice~",   
         ~"art~".~"art_descrizione~",   
         ~"rdoc_a~".~"rdoc_numero~",   
         ~"rdoc_a~".~"rdoc_qta~",   
         ~"rdoc_a~".~"rdoc_pr_man~",   
         ~"rdoc_a~".~"rdoc_quotazione~",   
