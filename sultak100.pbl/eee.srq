PBSELECT( VERSION(400) TABLE(NAME="doc" )  TABLE(NAME="partita_scarico" )  TABLE(NAME="rdoc" ALIAS="rdoc_a" )  TABLE(NAME="rdoc" ALIAS="rdoc_b" ) COLUMN(NAME="doc.doc_numero") COLUMN(NAME="doc.doc_data")    JOIN (LEFT="rdoc_a.rdoc_id"    OP ="="RIGHT="partita_scarico.id_apertura" )    JOIN (LEFT="rdoc_a.rdoc_doc_id"    OP ="="RIGHT="doc.doc_id" )    JOIN (LEFT="rdoc_b.rdoc_id"    OP ="="RIGHT="partita_scarico.id_scarico" )WHERE(    EXP1 ="~"rdoc_b~".~"rdoc_doc_id~""   OP ="="    EXP2 =":id_doc_scarico" ) ) ARG(NAME = "id_doc_scarico" TYPE = number) 