 retrieve="  SELECT ~"doc_a~".~"doc_numero~",   
         ~"doc_a~".~"doc_data~",   
         ~"doc_a~".~"doc_a_mezzo~",   
         ~"valuta~".~"val_codice~",   
         ~"ana_a~".~"ana_rag_sociale~",   
         ~"ana_a~".~"ana_indirizzo~",   
