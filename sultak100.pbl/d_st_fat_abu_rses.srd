         (select codice_art from m_m_art_sog where id_art=~"rdoc_a~".~"rdoc_art_id~" and id_sog=~"doc_a~".~"doc_conto_id~") as cod_clfo,   
         ~"causale~".~"caus_partita~",   
         ~"conto_a~".~"conto_id~",   
         ~"azienda~".~"az_nota~",   
         ~"azienda~".~"az_email~",   
         ~"azienda~".~"rag_soc2~",   
         ~"val_base~".~"vedi_saldi_bolla~",   
