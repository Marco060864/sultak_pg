 retrieve="  SELECT ~"doc~".~"doc_numero~",   
         ~"doc~".~"doc_data~",   
         ~"doc~".~"doc_a_mezzo~",   
         ~"valuta~".~"val_codice~",   
         ~"ana_a~".~"ana_rag_sociale~",   
         ~"ana_a~".~"ana_indirizzo~",   
         ~"ana_a~".~"ana_localita~",   
         ~"ana_a~".~"ana_cap~",   
         ~"ana_a~".~"ana_citta~",   
         ~"ana_a~".~"ana_provincia~",   
         ~"ana_a~".~"ana_p_iva~",   
         ~"iva~".~"iva_codice~",   
         ~"art~".~"art_codice~",   
         ~"art~".~"art_descrizione~",   
         ~"rdoc~".~"rdoc_numero~",   
         ~"rdoc~".~"rdoc_qta~",   
         ~"rdoc~".~"rdoc_pr_man~",   
         ~"rdoc~".~"rdoc_quotazione~",   
         ~"rdoc~".~"rdoc_pr_gr_complessivo~",   
         ~"rdoc~".~"rdoc_pr_pezzo~",   
         ~"rdoc~".~"rdoc_misura~",   
         ~"rdoc~".~"rdoc_calo~",   
         ~"rdoc~".~"rdoc_descrizione~",   
         ~"titolo~".~"tit_titolo~",   
         ~"metallo~".~"met_metallo~",   
         ~"u_misura~".~"um_codice~",   
         ~"guida~".~"guida_tipo_doc~",   
         ~"ana_a~".~"ana_c_f~",   
         ~"doc~".~"nota~",   
         ~"destinazione~".~"dest_rag_soc~",   
         ~"destinazione~".~"dest_indirizzo~",   
         ~"destinazione~".~"dest_cap~",   
         ~"destinazione~".~"dest_localita~",   
         ~"destinazione~".~"dest_provincia~",   
         ~"destinazione~".~"dest_nazione~",   
         ~"azienda~".~"az_codice~",   
         ~"azienda~".~"az_indirizzo~",   
         ~"azienda~".~"az_cap~",   
         ~"azienda~".~"az_localita~",   
         ~"azienda~".~"az_citta~",   
         ~"azienda~".~"az_provincia~",   
         ~"azienda~".~"az_pi~",   
         ~"azienda~".~"az_cciaa~",   
         ~"azienda~".~"az_trib~",   
         ~"azienda~".~"az_logo~",   
         ~"azienda~".~"az_tel~",   
         ~"azienda~".~"az_fax~",   
         ~"rdoc~".~"rdoc_peso~",   
         ~"rdoc~".~"rdoc_sconto_imp~",   
         ~"rdoc~".~"rdoc_sconto_perc~",   
         ~"doc~".~"doc_sconto_perc~",   
         ~"banca~".~"banca_den_abi~",   
         ~"banca~".~"banca_den_cab~",   
         ~"doc~".~"doc_colli~",   
         ~"asp_beni~".~"asp_beni_descrizione~",   
         ~"azienda~".~"az_rag_sociale~",   
         ~"azienda~".~"az_cf~",   
         ~"trasporto~".~"trasp_descrizione~",   
         ~"doc~".~"data_ora_trasporto~",   
         ~"ana_b~".~"ana_rag_sociale~",   
         ~"ana_b~".~"ana_indirizzo~",   
         ~"ana_b~".~"ana_localita~",   
         ~"ana_b~".~"ana_cap~",   
         ~"ana_b~".~"ana_citta~",   
         ~"ana_b~".~"ana_provincia~",   
         ~"registro~".~"reg_tipo~",   
         ~"azienda~".~"az_nota~",   
         ~"pagamento~".~"paga_descrizione~",   
         ~"conto_banca~".~"cin_internazionale~",   
         ~"conto_banca~".~"cin~",   
         ~"conto_banca~".~"c_c~",   
         ~"banca~".~"banca_cod_abi~",   
         ~"banca~".~"banca_cod_cab~",   
         ~"conto_a~".~"di_ns_prot~",   
         ~"conto_a~".~"di_vs_prot~",   
         ~"conto_a~".~"di_ns_data~",   
         ~"conto_a~".~"di_vs_data~",   
         ~"conto_a~".~"di_ns_pag~",   
         ~"conto_a~".~"di_uff_iva~",   
         ~"conto_a~".~"anno_dich_intento~",   
         ~"doc~".~"doc_conto_id~",
		~"causale~".~"caus_partita~"  
    FROM {oj ~"rdoc~" LEFT OUTER JOIN ~"titolo~" ON ~"rdoc~".~"tit_id~" = ~"titolo~".~"tit_id~" LEFT OUTER JOIN ~"iva~" ON ~"rdoc~".~"iva_id~" = ~"iva~".~"iva_id~"}, 
{oj ~"doc~" LEFT OUTER JOIN ~"destinazione~" ON ~"doc~".~"dest_id~" = ~"destinazione~".~"dest_id~"}, 
{oj ~"rdoc~" LEFT OUTER JOIN ~"art~" ON ~"rdoc~".~"rdoc_art_id~" = ~"art~".~"art_id~" LEFT OUTER JOIN ~"u_misura~" ON ~"rdoc~".~"um_id~" = ~"u_misura~".~"um_id~"}, 
{oj ~"doc~" LEFT OUTER JOIN ~"pagamento~" ON ~"doc~".~"paga_id~" = ~"pagamento~".~"paga_id~"}, {oj ~"titolo~" LEFT OUTER JOIN ~"metallo~" ON ~"titolo~".~"tit_met_id~" = ~"metallo~".~"met_id~"}, 
{oj ~"doc~" LEFT OUTER JOIN ~"asp_beni~" ON ~"doc~".~"asp_beni_id~" = ~"asp_beni~".~"asp_beni_id~" LEFT OUTER JOIN ~"conto~" ~"conto_b~" ON ~"doc~".~"conto_id_vettore~" = ~"conto_b~".~"conto_id~" LEFT OUTER JOIN
 ~"ana~" ~"ana_b~" ON ~"conto_b~".~"ana_id~" = ~"ana_b~".~"ana_id~" LEFT OUTER JOIN ~"trasporto~" ON ~"doc~".~"trasp_id~" = ~"trasporto~".~"trasp_id~"}, 
{oj ~"conto_banca~" RIGHT OUTER JOIN ~"doc~" ON ~"conto_banca~".~"conto_banca_id~" = ~"doc~".~"banca_id~" LEFT OUTER JOIN ~"banca~" ON ~"conto_banca~".~"banca_id~" = ~"banca~".~"banca_id~"},   
{oj ~"rdoc~" LEFT OUTER JOIN ~"causale~" ON ~"rdoc~".~"causale_id~" = ~"causale~".~"caus_id~"}, 
         ~"ana~" ~"ana_a~",   
         ~"valuta~",   
         ~"conto~" ~"conto_a~",   
         ~"guida~",   
         ~"azienda~",   
         ~"registro~",   
         ~"causale~"  
   WHERE ( ~"doc~".~"doc_id~" = ~"rdoc~".~"rdoc_doc_id~" ) and  
         ( ~"doc~".~"val_id~" = ~"valuta~".~"val_id~" ) and  
         ( ~"doc~".~"doc_conto_id~" = ~"conto_a~".~"conto_id~" ) and  
         ( ~"conto_a~".~"ana_id~" = ~"ana_a~".~"ana_id~" ) and  
         ( ~"doc~".~"guida_id~" = ~"guida~".~"guida_id~" ) and  
         ( ~"doc~".~"reg_id~" = ~"registro~".~"reg_id~" ) and  
         ( ( ~"dba~".~"doc~".~"doc_id~" = :doc_id ) AND  
         ( ~"rdoc~".~"stampa~" = 'S' ) )    
" arguments=(("doc_id", number))  sort="rdoc_rdoc_numero A " )
