~") COLUMN(NAME=~"azienda.az_citta~") COLUMN(NAME=~"azienda.az_provincia~") COLUMN(NAME=~"azienda.az_pi~") COLUMN(NAME=~"azienda.az_cciaa~") COLUMN(NAME=~"azienda.az_trib~") COLUMN(NAME=~"azienda.az_logo~") COLUMN(NAME=~"azienda.az_tel~") COLUMN(NAME=~"azienda.az_fax~") COLUMN(NAME=~"rdoc.rdoc_peso~") COLUMN(NAME=~"rdoc.rdoc_sconto_imp~") COLUMN(NAME=~"rdoc.rdoc_sconto_perc~") COLUMN(NAME=~"doc.doc_sconto_perc~") COLUMN(NAME=~"banca.banca_den_abi~") COLUMN(NAME=~"banca.banca_den_cab~") COLUMN(NAME=~"doc.doc_colli~") COLUMN(NAME=~"asp_beni.asp_beni_descrizione~") COLUMN(NAME=~"azienda.az_rag_sociale~") COLUMN(NAME=~"azienda.az_cf~") COLUMN(NAME=~"trasporto.trasp_descrizione~") COLUMN(NAME=~"doc.data_ora_trasporto~") COLUMN(NAME=~"ana_b.ana_rag_sociale~") COLUMN(NAME=~"ana_b.ana_indirizzo~") COLUMN(NAME=~"ana_b.ana_localita~") COLUMN(NAME=~"ana_b.ana_cap~") COLUMN(NAME=~"ana_b.ana_citta~") COLUMN(NAME=~"ana_b.ana_provincia~") COLUMN(NAME=~"registro.reg_tipo~") COLUMN(NAME=~"azienda.az_nota~") COLUMN(NAME=~"pagamento.paga_descrizione~")    JOIN (LEFT=~"rdoc.tit_id~"    OP =~"=~"RIGHT=~"titolo.tit_id~"    OUTER1 =~"rdoc.tit_id~" )    JOIN (LEFT=~"rdoc.iva_id~"    OP =~"=~"RIGHT=~"iva.iva_id~"    OUTER1 =~"rdoc.iva_id~" )    JOIN (LEFT=~"doc.dest_id~"    OP =~"=~"RIGHT=~"destinazione.dest_id~"    OUTER1 =~"doc.dest_id~" )    JOIN (LEFT=~"rdoc.rdoc_art_id~"    OP =~"=~"RIGHT=~"art.art_id~"    OUTER1 =~"rdoc.rdoc_art_id~" )    JOIN (LEFT=~"rdoc.um_id~"    OP =~"=~"RIGHT=~"u_misura.um_id~"    OUTER1 =~"rdoc.um_id~" )    JOIN (LEFT=~"doc.paga_id~"    OP =~"=~"RIGHT=~"pagamento.paga_id~"    OUTER1 =~"doc.paga_id~" )    JOIN (LEFT=~"titolo.tit_met_id~"    OP =~"=~"RIGHT=~"metallo.met_id~"    OUTER1 =~"titolo.tit_met_id~" )    JOIN (LEFT=~"doc.banca_id~"    OP =~"=~"RIGHT=~"banca.banca_id~"    OUTER1 =~"doc.banca_id~" )    JOIN (LEFT=~"doc.asp_beni_id~"    OP =~"=~"RIGHT=~"asp_beni.asp_beni_id~"    OUTER1 =~"doc.asp_beni_id~" )    JOIN (LEFT=~"doc.conto_id_vettore~"    OP =~"=~"RIGHT=~"conto_b.conto_id~"    OUTER1 =~"doc.conto_id_vettore~" )    JOIN (LEFT=~"conto_b.ana_id~"    OP =~"=~"RIGHT=~"ana_b.ana_id~"    OUTER1 =~"conto_b.ana_id~" )    JOIN (LEFT=~"doc.trasp_id~"    OP =~"=~"RIGHT=~"trasporto.trasp_id~"    OUTER1 =~"doc.trasp_id~" )    JOIN (LEFT=~"doc.doc_id~"    OP =~"=~"RIGHT=~"rdoc.rdoc_doc_id~" )    JOIN (LEFT=~"doc.val_id~"    OP =~"=~"RIGHT=~"valuta.val_id~" )    JOIN (LEFT=~"doc.doc_conto_id~"    OP =~"=~"RIGHT=~"conto_a.conto_id~" )    JOIN (LEFT=~"conto_a.ana_id~"    OP =~"=~"RIGHT=~"ana_a.ana_id~" )    JOIN (LEFT=~"doc.guida_id~"    OP =~"=~"RIGHT=~"guida.guida_id~" )    JOIN (LEFT=~"doc.reg_id~"    OP =~"=~"RIGHT=~"registro.reg_id~" )WHERE(    EXP1 =~"~~~"dba~~~".~~~"doc~~~".~~~"doc_id~~~"~"   OP =~"=~"    EXP2 =~":doc_id~" ) ) ARG(NAME = ~"doc_id~" TYPE = number) " arguments=(("doc_id", number)) )
