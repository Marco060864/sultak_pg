 retrieve="  SELECT ~"doc_a~".~"doc_numero~",   
         ~"doc_a~".~"doc_data~",   
         ~"doc_a~".~"doc_a_mezzo~",   
         ~"valuta~".~"val_codice~",   
         ~"ana_a~".~"ana_rag_sociale~",   
         ~"ana_a~".~"ana_indirizzo~",   
         ~"ana_a~".~"ana_localita~",   
         ~"ana_a~".~"ana_cap~",   
         ~"ana_a~".~"ana_citta~",   
         ~"ana_a~".~"ana_provincia~",   
         ~"ana_a~".~"ana_p_iva~",   
         ~"iva~".~"iva_codice~",   
         ~"art~".~"art_codice~",   
         ~"art~".~"art_descrizione~",   
         ~"rdoc_a~".~"rdoc_numero~",   
         ~"rdoc_a~".~"rdoc_qta~",   
         ~"rdoc_a~".~"rdoc_pr_man~",   
         ~"rdoc_a~".~"rdoc_quotazione~",   
         ~"rdoc_a~".~"rdoc_pr_gr_complessivo~",   
         ~"rdoc_a~".~"rdoc_pr_pezzo~",   
         ~"rdoc_a~".~"rdoc_misura~",   
         ~"rdoc_a~".~"rdoc_calo~",   
         ~"rdoc_a~".~"rdoc_descrizione~",   
         ~"titolo~".~"tit_titolo~",   
         ~"metallo~".~"met_metallo~",   
         ~"u_misura~".~"um_codice~",   
         ~"guida~".~"guida_tipo_doc~",   
         ~"ana_a~".~"ana_c_f~",   
         ~"doc_a~".~"nota~",   
         ~"destinazione~".~"dest_rag_soc~",   
         ~"destinazione~".~"dest_indirizzo~",   
         ~"destinazione~".~"dest_cap~",   
         ~"destinazione~".~"dest_localita~",   
         ~"destinazione~".~"dest_provincia~",   
         ~"destinazione~".~"dest_nazione~",   
         ~"azienda~".~"az_codice~",   
         ~"azienda~".~"az_indirizzo~",   
         ~"azienda~".~"az_cap~",   
         ~"azienda~".~"az_localita~",   
         ~"azienda~".~"az_citta~",   
         ~"azienda~".~"az_provincia~",   
         ~"azienda~".~"az_pi~",   
         ~"azienda~".~"az_cciaa~",   
         ~"azienda~".~"az_trib~",   
         ~"azienda~".~"az_logo~",   
         ~"azienda~".~"az_tel~",   
         ~"azienda~".~"az_fax~",   
         ~"rdoc_a~".~"rdoc_peso~",   
         ~"rdoc_a~".~"rdoc_sconto_imp~",   
         ~"rdoc_a~".~"rdoc_sconto_perc~",   
         ~"doc_a~".~"doc_sconto_perc~",   
         ~"banca~".~"banca_den_abi~",   
         ~"banca~".~"banca_den_cab~",   
         ~"doc_a~".~"doc_colli~",   
         ~"asp_beni~".~"asp_beni_descrizione~",   
         ~"azienda~".~"az_rag_sociale~",   
         ~"azienda~".~"az_cf~",   
         ~"trasporto~".~"trasp_descrizione~",   
         ~"doc_a~".~"data_ora_trasporto~",   
         ~"ana_b~".~"ana_rag_sociale~",   
         ~"ana_b~".~"ana_indirizzo~",   
         ~"ana_b~".~"ana_localita~",   
         ~"ana_b~".~"ana_cap~",   
         ~"ana_b~".~"ana_citta~",   
         ~"ana_b~".~"ana_provincia~",   
         ~"registro~".~"reg_tipo~",   
         ~"conto_a~".~"di_ns_prot~",   
         ~"conto_a~".~"di_vs_prot~",   
         ~"conto_a~".~"di_ns_data~",   
         ~"conto_a~".~"di_vs_data~",   
         ~"conto_a~".~"di_ns_pag~",   
         ~"doc_b~".~"doc_numero~",   
         ~"doc_b~".~"doc_data~",   
         ~"pagamento~".~"paga_descrizione~",   
         ~"conto_banca~".~"cin_internazionale~",   
         ~"conto_banca~".~"cin~",   
         ~"conto_banca~".~"c_c~",   
         ~"banca~".~"banca_cod_abi~",   
         ~"banca~".~"banca_cod_cab~",   
         ~"doc_a~".~"peso_netto~",   
         ~"doc_a~".~"peso_lordo~",   
         (select codice_art from m_m_art_sog where id_art=~"rdoc_a~".~"rdoc_art_id~" and id_sog=~"doc_a~".~"doc_conto_id~") as cod_clfo,   
         ~"causale~".~"caus_partita~",   
         ~"conto_a~".~"conto_id~",   
         ~"azienda~".~"az_nota~",   
         ~"azienda~".~"az_email~",   
         ~"azienda~".~"rag_soc2~",   
         ~"val_base~".~"vedi_saldi_bolla~",   
         ~"conto_a~".~"anno_dich_intento~",   
         ~"rdoc_a~".~"rdoc_non_prezioso~", 
~"val_base~".~"data_inizio_saldi~",
~"rdoc_a~".~"tara~",
~"guida~".~"guida_codice~", rdoc_a.num_bollettina,   ~"rdoc_a~".~"n_lacci~",     ~"rdoc_a~".~"n_fili~",
         (select list(distinct dc.doc_numero || ' del ' || dateformat(dc.doc_data,'dd/mm/yyyy'), ', ')
            from partita_scarico ps, rdoc rc, doc dc
           where ps.id_scarico = rdoc_a.rdoc_id
             and ps.id_apertura = rc.rdoc_id
             and rc.rdoc_doc_id = dc.doc_id) as carichi_partita
    FROM {oj ~"rdoc~" ~"rdoc_a~" LEFT OUTER JOIN ~"titolo~" ON ~"rdoc_a~".~"tit_id~" = ~"titolo~".~"tit_id~" LEFT OUTER JOIN ~"iva~" ON ~"rdoc_a~".~"iva_id~" = ~"iva~".~"iva_id~"}, {oj ~"doc~" ~"doc_a~" LEFT OUTER JOIN ~"destinazione~" ON ~"doc_a~".~"dest_id~" = ~"destinazione~".~"dest_id~"}, {oj ~"rdoc~" ~"rdoc_a~" LEFT OUTER JOIN ~"art~" ON ~"rdoc_a~".~"rdoc_art_id~" = ~"art~".~"art_id~" LEFT OUTER JOIN ~"u_misura~" ON ~"rdoc_a~".~"um_id~" = ~"u_misura~".~"um_id~"}, {oj ~"doc~" ~"doc_a~" LEFT OUTER JOIN ~"pagamento~" ON ~"doc_a~".~"paga_id~" = ~"pagamento~".~"paga_id~"}, {oj ~"titolo~" LEFT OUTER JOIN ~"metallo~" ON ~"titolo~".~"tit_met_id~" = ~"metallo~".~"met_id~"}, {oj ~"doc~" ~"doc_a~" LEFT OUTER JOIN ~"asp_beni~" ON ~"doc_a~".~"asp_beni_id~" = ~"asp_beni~".~"asp_beni_id~" LEFT OUTER JOIN ~"conto~" ~"conto_b~" ON ~"doc_a~".~"conto_id_vettore~" = ~"conto_b~".~"conto_id~" LEFT OUTER JOIN ~"ana~" ~"ana_b~" ON ~"conto_b~".~"ana_id~" = ~"ana_b~".~"ana_id~" LEFT OUTER JOIN ~"trasporto~" ON ~"doc_a~".~"trasp_id~" = ~"trasporto~".~"trasp_id~"}, {oj ~"rdoc~" ~"rdoc_b~" LEFT OUTER JOIN ~"doc~" ~"doc_b~" ON ~"rdoc_b~".~"rdoc_doc_id~" = ~"doc_b~".~"doc_id~"}, {oj ~"rdoc~" ~"rdoc_a~" LEFT OUTER JOIN ~"rdoc~" ~"rdoc_b~" ON ~"rdoc_a~".~"rdoc_id_riga_madre~" = ~"rdoc_b~".~"rdoc_id~"}, {oj ~"doc~" ~"doc_a~" LEFT OUTER JOIN ~"conto_banca~" ON ~"doc_a~".~"banca_id~" = ~"conto_banca~".~"conto_banca_id~" LEFT OUTER JOIN ~"banca~" ON ~"conto_banca~".~"banca_id~" = ~"banca~".~"banca_id~"}, {oj ~"rdoc~" ~"rdoc_a~" LEFT OUTER JOIN ~"causale~" ON ~"rdoc_a~".~"causale_id~" = ~"causale~".~"caus_id~"},   
         ~"ana~" ~"ana_a~",   
         ~"valuta~",   
         ~"conto~" ~"conto_a~",   
         ~"guida~",   
         ~"azienda~",   
         ~"registro~",   
         ~"val_base~"  
   WHERE ( ~"doc_a~".~"doc_id~" = ~"rdoc_a~".~"rdoc_doc_id~" ) and  
         ( ~"doc_a~".~"val_id~" = ~"valuta~".~"val_id~" ) and  
         ( ~"doc_a~".~"doc_conto_id~" = ~"conto_a~".~"conto_id~" ) and  
         ( ~"conto_a~".~"ana_id~" = ~"ana_a~".~"ana_id~" ) and  
         ( ~"doc_a~".~"guida_id~" = ~"guida~".~"guida_id~" ) and  
         ( ~"doc_a~".~"reg_id~" = ~"registro~".~"reg_id~" ) and  
         ( ( ~"doc_a~".~"doc_id~" = :doc_id ) AND  
         ( ~"rdoc_a~".~"stampa~" = 'S' ) )    
