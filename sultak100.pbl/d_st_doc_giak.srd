         ~"rdoc_a~".~"rdoc_non_prezioso~", 
~"val_base~".~"data_inizio_saldi~",
 ~"art~".~"art_id~", ~"caus_trasporto~".~"descrizione~" ,  ~"azienda~".~"az_cell1~", ~"azienda~".~"codice_interscambio_ae~"   
    FROM {oj ~"rdoc~" ~"rdoc_a~" LEFT OUTER JOIN ~"titolo~" ON ~"rdoc_a~".~"tit_id~" = ~"titolo~".~"tit_id~" LEFT OUTER JOIN ~"iva~" ON ~"rdoc_a~".~"iva_id~" = ~"iva~".~"iva_id~"}, {oj ~"doc~" ~"doc_a~" LEFT OUTER JOIN ~"destinazione~" ON ~"doc_a~".~"dest_id~" = ~"destinazione~".~"dest_id~"},
 {oj ~"rdoc~" ~"rdoc_a~" LEFT OUTER JOIN ~"art~" ON ~"rdoc_a~".~"rdoc_art_id~" = ~"art~".~"art_id~" LEFT OUTER JOIN ~"u_misura~" ON ~"rdoc_a~".~"um_id~" = ~"u_misura~".~"um_id~"}, {oj ~"doc~" ~"doc_a~" LEFT OUTER JOIN ~"pagamento~" ON ~"doc_a~".~"paga_id~" = ~"pagamento~".~"paga_id~"}, 
{oj ~"titolo~" LEFT OUTER JOIN ~"metallo~" ON ~"titolo~".~"tit_met_id~" = ~"metallo~".~"met_id~"},
 {oj ~"doc~" ~"doc_a~" LEFT OUTER JOIN ~"asp_beni~" ON ~"doc_a~".~"asp_beni_id~" = ~"asp_beni~".~"asp_beni_id~" LEFT OUTER JOIN ~"conto~" ~"conto_b~" ON ~"doc_a~".~"conto_id_vettore~" = ~"conto_b~".~"conto_id~" LEFT OUTER JOIN ~"ana~" ~"ana_b~" ON ~"conto_b~".~"ana_id~" = ~"ana_b~".~"ana_id~" LEFT OUTER JOIN ~"trasporto~" ON ~"doc_a~".~"trasp_id~" = ~"trasporto~".~"trasp_id~"},
 {oj ~"rdoc~" ~"rdoc_b~" LEFT OUTER JOIN ~"doc~" ~"doc_b~" ON ~"rdoc_b~".~"rdoc_doc_id~" = ~"doc_b~".~"doc_id~"},
 {oj ~"rdoc~" ~"rdoc_a~" LEFT OUTER JOIN ~"rdoc~" ~"rdoc_b~" ON ~"rdoc_a~".~"rdoc_id_riga_madre~" = ~"rdoc_b~".~"rdoc_id~"}, {oj ~"doc~" ~"doc_a~" LEFT OUTER JOIN ~"conto_banca~" ON ~"doc_a~".~"banca_id~" = ~"conto_banca~".~"conto_banca_id~" LEFT OUTER JOIN ~"banca~" ON ~"conto_banca~".~"banca_id~" = ~"banca~".~"banca_id~"}, 
{oj ~"rdoc~" ~"rdoc_a~" LEFT OUTER JOIN ~"causale~" ON ~"rdoc_a~".~"causale_id~" = ~"causale~".~"caus_id~"},    {oj ~"doc~" ~"doc_a~" LEFT OUTER JOIN ~"caus_trasporto~" ON ~"doc_a~".~"caus_trasporto_id~" = ~"caus_trasporto~".~"id_caus_trasporto~"},
         ~"ana~" ~"ana_a~",   
         ~"valuta~",   
         ~"conto~" ~"conto_a~",   
         ~"guida~",   
         ~"azienda~",   
         ~"registro~",   
         ~"val_base~"  
   WHERE ( ~"doc_a~".~"doc_id~" = ~"rdoc_a~".~"rdoc_doc_id~" ) and  
         ( ~"doc_a~".~"val_id~" = ~"valuta~".~"val_id~" ) and  
         ( ~"doc_a~".~"doc_conto_id~" = ~"conto_a~".~"conto_id~" ) and  
         ( ~"conto_a~".~"ana_id~" = ~"ana_a~".~"ana_id~" ) and  
         ( ~"doc_a~".~"guida_id~" = ~"guida~".~"guida_id~" ) and  
         ( ~"doc_a~".~"reg_id~" = ~"registro~".~"reg_id~" ) and  
         ( ( ~"doc_a~".~"doc_id~" = :doc_id ) AND  
         ( ~"rdoc_a~".~"stampa~" = 'S' ) )    
