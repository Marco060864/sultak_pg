PBSELECT( VERSION(400) TABLE(NAME="art" )  TABLE(NAME="art_foto" )  TABLE(NAME="attr_articolo" )  TABLE(NAME="prezzo" )  TABLE(NAME="u_misura" ) COLUMN(NAME="art.art_codice") COLUMN(NAME="art.art_descrizione") COLUMN(NAME="art_foto.art_foto") COLUMN(NAME="prezzo.pr_pezzo") COLUMN(NAME="prezzo.pr_peso") COLUMN(NAME="prezzo.pr_c_calo") COLUMN(NAME="u_misura.um_codice") COLUMN(NAME="attr_articolo.ata_peso") COLUMN(NAME="attr_articolo.ata_misura") COMPUTE(NAME="0 as c_scegli")    JOIN (LEFT="art.art_id"    OP ="="RIGHT="attr_articolo.ata_id_articolo"    OUTER1 ="art.art_id" )    JOIN (LEFT="attr_articolo.ata_id_attr_articolo"    OP ="="RIGHT="prezzo.ata_id_attr_articolo"    OUTER1 ="attr_articolo.ata_id_attr_articolo" )    JOIN (LEFT="attr_articolo.ata_id_um_mis"    OP ="="RIGHT="u_misura.um_id"    OUTER1 ="attr_articolo.ata_id_um_mis" )    JOIN (LEFT="art.art_id"    OP ="="RIGHT="art_foto.art_id" )) 