table(column=(type=char(32) updatewhereclause=yes name=art_codice dbname="art.art_codice" )
 column=(type=char(80) updatewhereclause=yes name=art_descrizione dbname="art.art_descrizione" )
 column=(type=char(128) updatewhereclause=yes name=art_foto dbname="art_foto.art_foto" )
 column=(type=decimal(6) updatewhereclause=yes name=pr_pezzo dbname="prezzo.pr_pezzo" )
 column=(type=decimal(6) updatewhereclause=yes name=pr_peso dbname="prezzo.pr_peso" )
 column=(type=decimal(2) updatewhereclause=yes name=pr_c_calo dbname="prezzo.pr_c_calo" )
 column=(type=char(2) updatewhereclause=yes name=um_codice dbname="u_misura.um_codice" )
 column=(type=decimal(4) updatewhereclause=yes name=art_peso dbname="art.peso" )
 column=(type=decimal(4) updatewhereclause=yes name=art_misura dbname="art.misura" )
 column=(type=long updatewhereclause=yes name=c_scegli dbname="c_scegli" values="	1/	0" )
 column=(type=long updatewhereclause=yes name=conto_id dbname="art_foto.conto_id" )
 column=(type=long updatewhereclause=yes name=lista_art_id dbname="lista_art_figlio.lista_art_id" )
 column=(type=long updatewhereclause=yes name=art_art_tit_preferenziale dbname="art.art_tit_preferenziale" )
 column=(type=decimal(2) updatewhereclause=yes name=art_art_calo_preferenziale dbname="art.art_calo_preferenziale" )
 column=(type=ulong updatewhereclause=yes name=art_ruota dbname="art.ruota" )
 column=(type=long updatewhereclause=yes identity=yes name=art_id dbname="art.art_id" )
 retrieve="  SELECT  art.art_codice ,           art.art_descrizione ,           art_foto.art_foto ,           prezzo.pr_pezzo ,           prezzo.pr_peso ,           prezzo.pr_c_calo ,   
        u_misura.um_codice ,           art.peso ,           art.misura ,           0 as c_scegli,           art_foto.conto_id ,           lista_art_figlio.lista_art_id ,    
       art.art_tit_preferenziale ,           art.art_calo_preferenziale ,           art.ruota ,           art.art_id 
 FROM {oj dba.lista_art_figlio RIGHT OUTER JOIN dba.art ON lista_art_figlio.art_id = art.art_id LEFT OUTER JOIN dba.prezzo ON art.art_id = prezzo.art_id LEFT OUTER JOIN dba.u_misura
 ON art.um_id = u_misura.um_id} ,           dba.art_foto    WHERE ( art_foto.art_id = art.art_id ) and          ( ( ~"lista_art_figlio~".~"lista_art_id~" = 0 ) ) and          ( art.st_in_catalogo = 'S' )   "  sort="art_codice A " )
