 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"partita_scarico~" )  TABLE(NAME=~"doc~" ALIAS=~"doc_a~" )  TABLE(NAME=~"rdoc~" ALIAS=~"rdoc_a~" )  TABLE(NAME=~"conto~" ALIAS=~"conto_a~" )  TABLE(NAME=~"conto~" ALIAS=~"conto_b~" )  TABLE(NAME=~"doc~" ALIAS=~"doc_b~" )  TABLE(NAME=~"rdoc~" ALIAS=~"rdoc_b~" ) COLUMN(NAME=~"doc_a.doc_numero~") COLUMN(NAME=~"doc_a.doc_data~") COLUMN(NAME=~"partita_scarico.id_scarico~") COLUMN(NAME=~"partita_scarico.id_apertura~") COLUMN(NAME=~"partita_scarico.scarico~") COLUMN(NAME=~"partita_scarico.numero~") COLUMN(NAME=~"doc_a.doc_conto_id~") COLUMN(NAME=~"conto_a.conto_codice~") COLUMN(NAME=~"conto_b.conto_codice~") COLUMN(NAME=~"doc_b.doc_numero~") COLUMN(NAME=~"doc_b.doc_data~") COLUMN(NAME=~"rdoc_b.finoecalo~")    JOIN (LEFT=~"rdoc_a.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc_a.doc_id~" )    JOIN (LEFT=~"rdoc_a.rdoc_id~"    OP =~"=~"RIGHT=~"partita_scarico.id_apertura~" )    JOIN (LEFT=~"doc_a.doc_conto_id~"    OP =~"=~"RIGHT=~"conto_a.conto_id~" )    JOIN (LEFT=~"conto_b.conto_id~"    OP =~"=~"RIGHT=~"doc_b.doc_conto_id~" )    JOIN (LEFT=~"doc_b.doc_id~"    OP =~"=~"RIGHT=~"rdoc_b.rdoc_doc_id~" )    JOIN (LEFT=~"partita_scarico.id_scarico~"    OP =~"=~"RIGHT=~"rdoc_b.rdoc_id~" )) ORDER(NAME=~"doc_a.doc_data~" ASC=yes )  ORDER(NAME=~"doc_a.doc_num_prog~" ASC=yes )  ORDER(NAME=~"doc_a.doc_numero~" ASC=yes ) " update="partita_scarico" updatewhere=1 updatekeyinplace=yes )
