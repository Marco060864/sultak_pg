 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"art~" )  TABLE(NAME=~"doc~" )  TABLE(NAME=~"rdoc~" ) COLUMN(NAME=~"art.art_codice~") COLUMN(NAME=~"doc.doc_num_prog~") COLUMN(NAME=~"doc.doc_data_prog~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"rdoc.rdoc_peso~") COLUMN(NAME=~"rdoc.rdoc_qta~") COLUMN(NAME=~"rdoc.causale_id~")    JOIN (LEFT=~"rdoc.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~" )    JOIN (LEFT=~"rdoc.rdoc_art_id~"    OP =~"=~"RIGHT=~"art.art_id~" )WHERE(    EXP1 =~"(~~~"rdoc~~~".~~~"causale_id~~~"~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"rdoc~~~".~~~"causale_id~~~"~"   OP =~"=~"    EXP2 =~"2~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"rdoc~~~".~~~"causale_id~~~"~"   OP =~"=~"    EXP2 =~"12~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"rdoc~~~".~~~"causale_id~~~"~"   OP =~"=~"    EXP2 =~"18)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"a_data~" TYPE = date) " filter="c_qta_g1>0"arguments=(("a_data", date))  sort="art_art_codice A doc_doc_data A " )
