d~" )    JOIN (LEFT=~"rdoc.rdoc_art_id~"    OP =~"=~"RIGHT=~"art.art_id~"    OUTER1 =~"rdoc.rdoc_art_id~" )    JOIN (LEFT=~"doc.reg_id~"    OP =~"=~"RIGHT=~"registro.reg_id~" )    JOIN (LEFT=~"registro.reg_ese_id~"    OP =~"=~"RIGHT=~"esercizio.ese_id~" )    JOIN (LEFT=~"rdoc.causale_id~"    OP =~"=~"RIGHT=~"causale.caus_id~" )    JOIN (LEFT=~"rdoc.um_id~"    OP =~"=~"RIGHT=~"u_misura.um_id~" )    JOIN (LEFT=~"doc.doc_conto_id~"    OP =~"=~"RIGHT=~"conto.conto_id~" )    JOIN (LEFT=~"rdoc.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~" )    JOIN (LEFT=~"conto.ana_id~"    OP =~"=~"RIGHT=~"ana.ana_id~" )    JOIN (LEFT=~"rdoc.mag_id~"    OP =~"=~"RIGHT=~"magazzino.maga_id~" )WHERE(    EXP1 =~"(~~~"dba~~~".~~~"causale~~~".~~~"caus_mag_euro~~~"~"   OP =~">~"    EXP2 =~"''~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"dba~~~".~~~"causale~~~".~~~"caus_clfo_pezzi~~~"~"   OP =~">~"    EXP2 =~"''~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"dba~~~".~~~"causale~~~".~~~"caus_clfo_fino~~~"~"   OP =~">~"    EXP2 =~"'')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"dba~~~".~~~"esercizio~~~".~~~"ese_data_inizio~~~"~"   OP =~">=~"    EXP2 =~":data_inizio_es )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"dba~~~".~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"data_inizio_es~" TYPE = date) " arguments=(("da_data", date),("a_data", date),("data_inizio_es", date))  sort="metallo_met_metallo A doc_doc_data A doc_doc_id A " )
