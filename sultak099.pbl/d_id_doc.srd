 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"doc~" ) COLUMN(NAME=~"doc.doc_id~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.reg_id~") COLUMN(NAME=~"doc.doc_conto_id~")WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " update="doc" updatewhere=1 updatekeyinplace=no arguments=(("da_data", date),("a_data", date))  sort="doc_data A doc_numero A " )
