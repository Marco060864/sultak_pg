 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"causale~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"doc~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"u_misura~" )  TABLE(NAME=~"titolo~" )  TABLE(NAME=~"metallo~" )  TABLE(NAME=~"ana~" )  TABLE(NAME=~"magazzino~" )  TABLE(NAME=~"iva~" )  TABLE(NAME=~"art~" ) COLUMN(NAME=~"conto.conto_codice~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"causale.caus_codice~") COLUMN(NAME=~"rdoc.rdoc_numero~") COLUMN(NAME=~"rdoc.rdoc_calo~") COLUMN(NAME=~"rdoc.rdoc_descrizione~") COLUMN(NAME=~"rdoc.rdoc_peso~") COLUMN(NAME=~"rdoc.rdoc_qta~") COLUMN(NAME=~"u_misura.um_codice~") COLUMN(NAME=~"titolo.tit_titolo~") COLUMN(NAME=~"metallo.met_metallo~") COLUMN(NAME=~"esercizio.ese_codice~") COLUMN(NAME=~"rdoc.rdoc_pr_man~") COLUMN(NAME=~"rdoc.rdoc_quotazione~") COLUMN(NAME=~"rdoc.rdoc_pr_gr_complessivo~") COLUMN(NAME=~"rdoc.rdoc_pr_pezzo~") COLUMN(NAME=~"registro.reg_id~") COLUMN(NAME=~"registro.reg_tipo~") COLUMN(NAME=~"ana.ana_rag_sociale~") COLUMN(NAME=~"rdoc.rdoc_sconto_imp~") COLUMN(NAME=~"rdoc.rdoc_sconto_perc~") COLUMN(NAME=~"doc.guida_id~") COLUMN(NAME=~"doc.doc_id~") COLUMN(NAME=~"magazzino.maga_id~") COLUMN(NAME=~"magazzino.maga_codice~") COLUMN(NAME=~"rdoc.rdoc_art_id~") COLUMN(NAME=~"metallo.met_id~") COLUMN(NAME=~"titolo.tit_id~") COLUMN(NAME=~"doc.doc_num_prog~") COLUMN(NAME=~"doc.doc_data_prog~") COLUMN(NAME=~"registro.reg_numero~") COLUMN(NAME=~"rdoc.iva_id~") COLUMN(NAME=~"iva.iva_codice~") COLUMN(NAME=~"iva.iva_aliquota~") COLUMN(NAME=~"rdoc.rdoc_qta_evasa~") COLUMN(NAME=~"rdoc.rdoc_peso_evaso~") COLUMN(NAME=~"rdoc.causale_id~") COLUMN(NAME=~"art.art_codice~") COLUMN(NAME=~"art.art_id_codifica~") COLUMN(NAME=~"u_misura.um_tipo~") COLUMN(NAME=~"causale.caus_mag_euro~") COLUMN(NAME=~"registro.reg_registro~")    JOIN (LEFT=~"rdoc.tit_id~"    OP =~"=~"RIGHT=~"titolo.tit_id~"    OUTER1 =~"rdoc.tit_id~" )    JOIN (LEFT=~"titolo.tit_met_id~"    OP =~"=~"RIGHT=~"metallo.met_id~"    OUTER1 =~"titolo.tit_met_id~" )    JOIN (LEFT=~"rdoc.iva_id~"    OP =~"=~"RIGHT=~"iva.iva_id~"    OUTER1 =~"rdoc.iva_id~" )    JOIN (LEFT=~"rdoc.um_id~"    OP =~"=~"RIGHT=~"u_misura.um_id~"    OUTER1 =~"rdoc.um_id~" )    JOIN (LEFT=~"rdoc.mag_id~"    OP =~"=~"RIGHT=~"magazzino.maga_id~"    OUTER1 =~"rdoc.mag_id~" )    JOIN (LEFT=~"rdoc.causale_id~"    OP =~"=~"RIGHT=~"causale.caus_id~"    OUTER1 =~"rdoc.causale_id~" )    JOIN (LEFT=~"rdoc.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~"    OUTER2 =~"doc.doc_id~" )    JOIN (LEFT=~"rdoc.rdoc_art_id~"    OP =~"=~"RIGHT=~"art.art_id~"    OUTER1 =~"rdoc.rdoc_art_id~" )    JOIN (LEFT=~"doc.reg_id~"    OP =~"=~"RIGHT=~"registro.reg_id~" )    JOIN (LEFT=~"registro.reg_ese_id~"    OP =~"=~"RIGHT=~"esercizio.ese_id~" )    JOIN (LEFT=~"doc.doc_conto_id~"    OP =~"=~"RIGHT=~"conto.conto_id~" )    JOIN (LEFT=~"conto.ana_id~"    OP =~"=~"RIGHT=~"ana.ana_id~" )WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~">=~"    EXP2 =~":da_data ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"dba~~~".~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"data_inizio_es~" TYPE = date) " arguments=(("da_data", date),("a_data", date),("data_inizio_es", date))  sort="doc_doc_data A doc_doc_numero A reg_registro A " )
