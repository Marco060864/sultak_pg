 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"art~" )  TABLE(NAME=~"listino~" )  TABLE(NAME=~"prezzo~" )  TABLE(NAME=~"validita~" ) COLUMN(NAME=~"art.art_codice~") COLUMN(NAME=~"prezzo.pr_pezzo~") COLUMN(NAME=~"prezzo.pr_peso~") COLUMN(NAME=~"prezzo.pr_c_calo~") COLUMN(NAME=~"prezzo.pr_aggiuntivo~") COLUMN(NAME=~"validita.vali_da_data~") COLUMN(NAME=~"validita.vali_a_data~") COLUMN(NAME=~"listino.list_codice~") COLUMN(NAME=~"listino.list_tipo~") COLUMN(NAME=~"listino.base~") COLUMN(NAME=~"art.art_descrizione~")    JOIN (LEFT=~"prezzo.art_id~"    OP =~"=~"RIGHT=~"art.art_id~" )    JOIN (LEFT=~"validita.vali_id~"    OP =~"=~"RIGHT=~"prezzo.vali_id~" )    JOIN (LEFT=~"validita.listino_id~"    OP =~"=~"RIGHT=~"listino.listino_id~" )WHERE(    EXP1 =~"~~~"prezzo~~~".~~~"vali_id~~~"~"   OP =~"=~"    EXP2 =~":val_id~" ) ) ARG(NAME = ~"val_id~" TYPE = number) " arguments=(("val_id", number))  sort="art_art_codice A " )
