table(column=(type=decimal(4) updatewhereclause=yes name=rdoc_rdoc_qta dbname="rdoc.rdoc_qta" )
 column=(type=decimal(4) updatewhereclause=yes name=rdoc_finoecalo dbname="rdoc.finoecalo" )
 column=(type=char(1) updatewhereclause=yes name=causale_caus_c_s dbname="causale.caus_c_s" )
 column=(type=char(2) updatewhereclause=yes name=metallo_met_metallo dbname="metallo.met_metallo" )
 column=(type=decimal(2) updatewhereclause=yes name=titolo_tit_titolo dbname="titolo.tit_titolo" )
 column=(type=char(16) updatewhereclause=yes name=doc_doc_numero dbname="doc.doc_numero" )
 column=(type=date updatewhereclause=yes name=doc_doc_data dbname="doc.doc_data" )
 column=(type=long updatewhereclause=yes name=rdoc_rdoc_numero dbname="rdoc.rdoc_numero" )
 column=(type=char(2) updatewhereclause=yes name=causale_caus_partita dbname="causale.caus_partita" )
 column=(type=decimal(2) updatewhereclause=yes name=rdoc_rdoc_calo dbname="rdoc.rdoc_calo" )
 column=(type=decimal(4) updatewhereclause=yes name=rdoc_rdoc_peso dbname="rdoc.rdoc_peso" )
 column=(type=date updatewhereclause=yes name=val_base_data_inizio_saldi dbname="val_base.data_inizio_saldi" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"doc~" )  TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"causale~" )  TABLE(NAME=~"metallo~" )  TABLE(NAME=~"titolo~" )  TABLE(NAME=~"val_base~" ) COLUMN(NAME=~"rdoc.rdoc_qta~") COLUMN(NAME=~"rdoc.finoecalo~") COLUMN(NAME=~"causale.caus_c_s~") COLUMN(NAME=~"metallo.met_metallo~") COLUMN(NAME=~"titolo.tit_titolo~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"rdoc.rdoc_numero~") COLUMN(NAME=~"causale.caus_partita~") COLUMN(NAME=~"rdoc.rdoc_calo~") COLUMN(NAME=~"rdoc.rdoc_peso~") COLUMN(NAME=~"val_base.data_inizio_saldi~")    JOIN (LEFT=~"rdoc.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~" )    JOIN (LEFT=~"rdoc.causale_id~"    OP =~"=~"RIGHT=~"causale.caus_id~" )    JOIN (LEFT=~"rdoc.tit_id~"    OP =~"=~"RIGHT=~"titolo.tit_id~" )    JOIN (LEFT=~"titolo.tit_met_id~"    OP =~"=~"RIGHT=~"metallo.met_id~" )WHERE(    EXP1 =~"( ( ~~~"doc~~~".~~~"doc_data~~~"~"   OP =~">=~"    EXP2 =~"~~~"val_base~~~".~~~"data_inizio_saldi~~~")~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"causale~~~".~~~"caus_partita~~~"~"   OP =~"=~"    EXP2 =~":caus_partita )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"doc~~~".~~~"doc_conto_id~~~"~"   OP =~"=~"    EXP2 =~":id_conto )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"causale~~~".~~~"caus_partita~~~"~"   OP =~">=~"    EXP2 =~"' ' ) )~" ) ) ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"caus_partita~" TYPE = string)  ARG(NAME = ~"id_conto~" TYPE = number) " arguments=(("a_data", date),("caus_partita", string),("id_conto", number))  sort="metallo_met_metallo A c_tit A doc_doc_data A causale_caus_c_s A doc_doc_numero A rdoc_rdoc_numero A " )
