 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"doc~" )  TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"causale~" )  TABLE(NAME=~"metallo~" )  TABLE(NAME=~"titolo~" ) COLUMN(NAME=~"rdoc.rdoc_qta~") COLUMN(NAME=~"rdoc.finoecalo~") COLUMN(NAME=~"causale.caus_c_s~") COLUMN(NAME=~"metallo.met_metallo~") COLUMN(NAME=~"titolo.tit_titolo~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"rdoc.rdoc_numero~") COLUMN(NAME=~"causale.caus_partita~") COLUMN(NAME=~"rdoc.rdoc_calo~") COLUMN(NAME=~"rdoc.rdoc_peso~")    JOIN (LEFT=~"rdoc.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~" )    JOIN (LEFT=~"rdoc.causale_id~"    OP =~"=~"RIGHT=~"causale.caus_id~" )    JOIN (LEFT=~"rdoc.tit_id~"    OP =~"=~"RIGHT=~"titolo.tit_id~" )    JOIN (LEFT=~"titolo.tit_met_id~"    OP =~"=~"RIGHT=~"metallo.met_id~" )WHERE(    EXP1 =~"( ( ~~~"doc~~~".~~~"doc_data~~~"~"   OP =~">=~"    EXP2 =~":da_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"causale~~~".~~~"caus_partita~~~"~"   OP =~"=~"    EXP2 =~":caus_partita )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"doc~~~".~~~"doc_conto_id~~~"~"   OP =~"=~"    EXP2 =~":id_conto )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"causale~~~".~~~"caus_partita~~~"~"   OP =~">=~"    EXP2 =~"' ' ) )~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"caus_partita~" TYPE = string)  ARG(NAME = ~"id_conto~" TYPE = number) " arguments=(("da_data", date),("a_data", date),("caus_partita", string),("id_conto", number))  sort="metallo_met_metallo A c_tit A doc_doc_data A causale_caus_c_s A doc_doc_numero A rdoc_rdoc_numero A " )
