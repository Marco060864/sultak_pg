table(column=(type=date updatewhereclause=yes name=doc_doc_data dbname="doc.doc_data" )
 column=(type=char(2) updatewhereclause=yes name=tipo_registro_tipo_registro dbname="tipo_registro.tipo_registro" )
 column=(type=char(8) updatewhereclause=yes name=iva_iva_codice dbname="iva.iva_codice" )
