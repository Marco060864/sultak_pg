 column=(type=decimal(4) updatewhereclause=yes name=cast_iva_civa_tot_iva dbname="cast_iva.civa_tot_iva" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"doc~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"tipo_registro~" )  TABLE(NAME=~"cast_iva~" )  TABLE(NAME=~"iva~" ) COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"tipo_registro.tipo_registro~") COLUMN(NAME=~"iva.iva_codice~") COLUMN(NAME=~"iva.iva_aliquota~") COLUMN(NAME=~"cast_iva.civa_tot_iva~")    JOIN (LEFT=~"doc.reg_id~"    OP =~"=~"RIGHT=~"registro.reg_id~" )    JOIN (LEFT=~"cast_iva.doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~" )    JOIN (LEFT=~"registro.reg_tipo~"    OP =~"=~"RIGHT=~"tipo_registro.tipo_registro~" )    JOIN (LEFT=~"iva.iva_id~"    OP =~"=~"RIGHT=~"cast_iva.iva_id~" )WHERE(    EXP1 =~"(~~~"tipo_registro~~~".~~~"tipo_registro~~~"~"   OP =~"=~"    EXP2 =~"'DA'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"left(~~~"tipo_registro~~~".~~~"tipo_registro~~~", 1)~"   OP =~"=~"    EXP2 =~"'I')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"iva~~~".~~~"iva_aliquota~~~"~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"cast_iva~~~".~~~"civa_tot_iva~~~"~"   OP =~">~"    EXP2 =~"0~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"ddt_come_ia~" TYPE = number) " arguments=(("da_data", date),("a_data", date),("ddt_come_ia", number))  sort="doc_doc_data A tipo_registro_tipo_registro A " )
