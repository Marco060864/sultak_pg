 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"causale~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"doc~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"u_misura~" )  TABLE(NAME=~"ana~" )  TABLE(NAME=~"magazzino~" )  TABLE(NAME=~"art~" )  TABLE(NAME=~"taglia~" )  TABLE(NAME=~"colore~" ) COLUMN(NAME=~"conto.conto_codice~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"causale.caus_codice~") COLUMN(NAME=~"rdoc.rdoc_numero~") COLUMN(NAME=~"rdoc.rdoc_calo~") COLUMN(NAME=~"rdoc.rdoc_descrizione~") COLUMN(NAME=~"rdoc.rdoc_peso~") COLUMN(NAME=~"rdoc.rdoc_qta~") COLUMN(NAME=~"u_misura.um_codice~") COLUMN(NAME=~"esercizio.ese_codice~") COLUMN(NAME=~"rdoc.rdoc_pr_man~") COLUMN(NAME=~"rdoc.rdoc_quotazione~") COLUMN(NAME=~"rdoc.rdoc_pr_gr_complessivo~") COLUMN(NAME=~"rdoc.rdoc_pr_pezzo~") COLUMN(NAME=~"registro.reg_id~") COLUMN(NAME=~"causale.caus_clfo_fino~") COLUMN(NAME=~"registro.reg_tipo~") COLUMN(NAME=~"ana.ana_rag_sociale~") COLUMN(NAME=~"rdoc.rdoc_sconto_imp~") COLUMN(NAME=~"rdoc.rdoc_sconto_perc~") COLUMN(NAME=~"causale.caus_partita~") COLUMN(NAME=~"doc.guida_id~") COLUMN(NAME=~"causale.caus_clfo_euro~") COLUMN(NAME=~"causale.caus_clfo_pezzi~") COLUMN(NAME=~"doc.doc_id~") COLUMN(NAME=~"magazzino.maga_id~") COLUMN(NAME=~"rdoc.rdoc_art_id~") COLUMN(NAME=~"art.art_codice~") COLUMN(NAME=~"art.art_id_codifica~") COLUMN(NAME=~"rdoc.causale_id~") COLUMN(NAME=~"causale.caus_mag_fino~") COLUMN(NAME=~"causale.caus_mag_euro~") COLUMN(NAME=~"causale.caus_mag_pezzi~") COLUMN(NAME=~"causale.caus_fiscale~") COLUMN(NAME=~"taglia.taglia~") COLUMN(NAME=~"colore.colore~") COMPUTE(NAME=~"cast((select pr_pezzo from prezzo, validita, listino where listino.base='S' and listino.list_tipo='A' and listino.listino_id=validita.listino_id and prezzo.art_id=rdoc_art_id and doc_data>= validita.vali_da_data and doc_data<= validita.vali_a_data and prezzo.vali_id=validita.vali_id)as decimal ) as c_valore~")    JOIN (LEFT=~"taglia.id_taglia~"    OP =~"=~"RIGHT=~"rdoc.id_taglia~"    OUTER2 =~"rdoc.id_taglia~" )    JOIN (LEFT=~"colore.id_colore~"    OP =~"=~"RIGHT=~"rdoc.id_colore~"    OUTER2 =~"rdoc.id_colore~" )    JOIN (LEFT=~"rdoc.rdoc_art_id~"    OP =~"=~"RIGHT=~"art.art_id~" )    JOIN (LEFT=~"doc.reg_id~"    OP =~"=~"RIGHT=~"registro.reg_id~" )    JOIN (LEFT=~"registro.reg_ese_id~"    OP =~"=~"RIGHT=~"esercizio.ese_id~" )    JOIN (LEFT=~"rdoc.causale_id~"    OP =~"=~"RIGHT=~"causale.caus_id~" )    JOIN (LEFT=~"rdoc.um_id~"    OP =~"=~"RIGHT=~"u_misura.um_id~" )    JOIN (LEFT=~"doc.doc_conto_id~"    OP =~"=~"RIGHT=~"conto.conto_id~" )    JOIN (LEFT=~"rdoc.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~" )    JOIN (LEFT=~"conto.ana_id~"    OP =~"=~"RIGHT=~"ana.ana_id~" )    JOIN (LEFT=~"rdoc.mag_id~"    OP =~"=~"RIGHT=~"magazzino.maga_id~" )WHERE(    EXP1 =~"(~~~"dba~~~".~~~"causale~~~".~~~"caus_mag_euro~~~"~"   OP =~">~"    EXP2 =~"''~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"dba~~~".~~~"causale~~~".~~~"caus_clfo_pezzi~~~"~"   OP =~">~"    EXP2 =~"''~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"dba~~~".~~~"causale~~~".~~~"caus_clfo_fino~~~"~"   OP =~">~"    EXP2 =~"'')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"dba~~~".~~~"esercizio~~~".~~~"ese_data_inizio~~~"~"   OP =~">=~"    EXP2 =~":data_inizio_es )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"dba~~~".~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"data_inizio_es~" TYPE = date) " arguments=(("da_data", date),("a_data", date),("data_inizio_es", date))  sort="art_codice A doc_doc_data A doc_doc_numero A taglia A colore A " )
