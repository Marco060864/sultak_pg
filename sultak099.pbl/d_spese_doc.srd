 column=(type=decimal(6) updatewhereclause=yes name=sp_doc_sp_doc_importo dbname="sp_doc.sp_doc_importo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sp_doc~" )  TABLE(NAME=~"spesa~" ) COLUMN(NAME=~"spesa.spesa_codice~") COLUMN(NAME=~"sp_doc.sp_doc_importo~")    JOIN (LEFT=~"sp_doc.spesa_id~"    OP =~"=~"RIGHT=~"spesa.spesa_id~" )WHERE(    EXP1 =~"~~~"sp_doc~~~".~~~"doc_id~~~"~"   OP =~"=~"    EXP2 =~":id_doc~" ) ) ARG(NAME = ~"id_doc~" TYPE = number) " arguments=(("id_doc", number)) )
