 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"metallo~" )  TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"titolo~" ) COLUMN(NAME=~"metallo.met_metallo~") COLUMN(NAME=~"titolo.tit_titolo~") COLUMN(NAME=~"rdoc.rdoc_peso~") COLUMN(NAME=~"rdoc.rdoc_calo~") COLUMN(NAME=~"rdoc.rdoc_quotazione~") COLUMN(NAME=~"rdoc.rdoc_pr_man~") COLUMN(NAME=~"rdoc.rdoc_non_prezioso~")    JOIN (LEFT=~"rdoc.tit_id~"    OP =~"=~"RIGHT=~"titolo.tit_id~" )    JOIN (LEFT=~"titolo.tit_met_id~"    OP =~"=~"RIGHT=~"metallo.met_id~" )WHERE(    EXP1 =~"( ( ~~~"dba~~~".~~~"rdoc~~~".~~~"rdoc_doc_id~~~"~"   OP =~"=~"    EXP2 =~":doc_id ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"titolo~~~".~~~"tit_titolo~~~"~"   OP =~">~"    EXP2 =~"0~" ) ) ARG(NAME = ~"doc_id~" TYPE = number)  ARG(NAME = ~"tipo_reg~" TYPE = string) " arguments=(("doc_id", number),("tipo_reg", string))  sort="metallo_met_metallo A titolo_tit_titolo A rdoc_rdoc_quotazione A " )
