 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cast_iva~" )  TABLE(NAME=~"iva~" )  TABLE(NAME=~"doc~" )  TABLE(NAME=~"valuta~" ) COLUMN(NAME=~"cast_iva.doc_id~") COLUMN(NAME=~"cast_iva.iva_id~") COLUMN(NAME=~"cast_iva.civa_spese~") COLUMN(NAME=~"cast_iva.civa_tot_imp~") COLUMN(NAME=~"cast_iva.civa_tot_iva~") COLUMN(NAME=~"iva.iva_codice~") COLUMN(NAME=~"iva.iva_aliquota~") COLUMN(NAME=~"iva.iva_des~") COLUMN(NAME=~"doc.acconto~") COLUMN(NAME=~"valuta.val_codice~") COLUMN(NAME=~"doc.cambio~") COLUMN(NAME=~"valuta.val_simbolo~") COLUMN(NAME=~"valuta.val_id~")    JOIN (LEFT=~"iva.iva_id~"    OP =~"=~"RIGHT=~"cast_iva.iva_id~" )    JOIN (LEFT=~"doc.doc_id~"    OP =~"=~"RIGHT=~"cast_iva.doc_id~" )    JOIN (LEFT=~"valuta.val_id~"    OP =~"=~"RIGHT=~"doc.val_id~" )WHERE(    EXP1 =~"~~~"dba~~~".~~~"cast_iva~~~".~~~"doc_id~~~"~"   OP =~"=~"    EXP2 =~":doc_id~" ) ) ARG(NAME = ~"doc_id~" TYPE = number) " arguments=(("doc_id", number)) )
