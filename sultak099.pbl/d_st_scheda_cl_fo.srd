 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"causale~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"doc~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"u_misura~" )  TABLE(NAME=~"titolo~" )  TABLE(NAME=~"metallo~" )  TABLE(NAME=~"ana~" )  TABLE(NAME=~"art~" )  TABLE(NAME=~"azienda~" ) COLUMN(NAME=~"conto.conto_codice~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"causale.caus_codice~") COLUMN(NAME=~"rdoc.rdoc_numero~") COLUMN(NAME=~"rdoc.rdoc_calo~") COLUMN(NAME=~"rdoc.rdoc_descrizione~") COLUMN(NAME=~"rdoc.rdoc_peso~") COLUMN(NAME=~"rdoc.rdoc_qta~") COLUMN(NAME=~"u_misura.um_codice~") COLUMN(NAME=~"titolo.tit_titolo~") COLUMN(NAME=~"metallo.met_metallo~") COLUMN(NAME=~"esercizio.ese_codice~") COLUMN(NAME=~"rdoc.rdoc_pr_man~") COLUMN(NAME=~"rdoc.rdoc_quotazione~") COLUMN(NAME=~"rdoc.rdoc_pr_gr_complessivo~") COLUMN(NAME=~"rdoc.rdoc_pr_pezzo~") COLUMN(NAME=~"registro.reg_id~") COLUMN(NAME=~"causale.caus_clfo_fino~") COLUMN(NAME=~"registro.reg_tipo~") COLUMN(NAME=~"ana.ana_rag_sociale~") COLUMN(NAME=~"rdoc.rdoc_sconto_imp~") COLUMN(NAME=~"rdoc.rdoc_sconto_perc~") COLUMN(NAME=~"causale.caus_partita~") COLUMN(NAME=~"doc.guida_id~") COLUMN(NAME=~"causale.caus_clfo_euro~") COLUMN(NAME=~"causale.caus_clfo_pezzi~") COLUMN(NAME=~"doc.doc_id~") COLUMN(NAME=~"art.art_codice~") COLUMN(NAME=~"art.art_id_codifica~") COLUMN(NAME=~"rdoc.causale_id~") COLUMN(NAME=~"rdoc.rdoc_non_prezioso~") COLUMN(NAME=~"rdoc.tit_id~") COLUMN(NAME=~"registro.reg_registro~") COLUMN(NAME=~"ana.ana_indirizzo~") COLUMN(NAME=~"ana.ana_cap~") COLUMN(NAME=~"ana.ana_citta~") COLUMN(NAME=~"ana.ana_provincia~") COLUMN(NAME=~"ana.ana_p_iva~") COLUMN(NAME=~"ana.ana_c_f~") COLUMN(NAME=~"azienda.az_rag_sociale~") COLUMN(NAME=~"azienda.az_indirizzo~") COLUMN(NAME=~"azienda.az_cap~") COLUMN(NAME=~"azienda.az_citta~") COLUMN(NAME=~"azienda.az_provincia~") COLUMN(NAME=~"azienda.az_pi~") COLUMN(NAME=~"azienda.az_cf~")    JOIN (LEFT=~"rdoc.tit_id~"    OP =~"=~"RIGHT=~"titolo.tit_id~"    OUTER1 =~"rdoc.tit_id~" )    JOIN (LEFT=~"titolo.tit_met_id~"    OP =~"=~"RIGHT=~"metallo.met_id~"    OUTER1 =~"titolo.tit_met_id~" )    JOIN (LEFT=~"rdoc.rdoc_art_id~"    OP =~"=~"RIGHT=~"art.art_id~"    OUTER1 =~"rdoc.rdoc_art_id~" )    JOIN (LEFT=~"rdoc.um_id~"    OP =~"=~"RIGHT=~"u_misura.um_id~"    OUTER1 =~"rdoc.um_id~" )    JOIN (LEFT=~"doc.reg_id~"    OP =~"=~"RIGHT=~"registro.reg_id~" )    JOIN (LEFT=~"registro.reg_ese_id~"    OP =~"=~"RIGHT=~"esercizio.ese_id~" )    JOIN (LEFT=~"rdoc.causale_id~"    OP =~"=~"RIGHT=~"causale.caus_id~" )    JOIN (LEFT=~"doc.doc_conto_id~"    OP =~"=~"RIGHT=~"conto.conto_id~" )    JOIN (LEFT=~"rdoc.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~" )    JOIN (LEFT=~"conto.ana_id~"    OP =~"=~"RIGHT=~"ana.ana_id~" )WHERE(    EXP1 =~"(~~~"dba~~~".~~~"causale~~~".~~~"caus_clfo_euro~~~"~"   OP =~">~"    EXP2 =~"''~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"dba~~~".~~~"causale~~~".~~~"caus_clfo_pezzi~~~"~"   OP =~">~"    EXP2 =~"''~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"dba~~~".~~~"causale~~~".~~~"caus_clfo_fino~~~"~"   OP =~">~"    EXP2 =~"'')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ~~~"doc~~~".~~~"doc_data~~~"~"   OP =~">=~"    EXP2 =~":data_inizio_es )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"dba~~~".~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date)  ARG(NAME = ~"data_inizio_es~" TYPE = date) " arguments=(("da_data", date),("a_data", date),("data_inizio_es", date))  sort="metallo_met_metallo A ana_ana_rag_sociale A causale_caus_partita A doc_doc_data A doc_doc_id A " )
