detail(height=84 color="536870912" )
table(column=(type=long updatewhereclause=yes identity=yes name=rdoc_rdoc_id dbname="rdoc.rdoc_id" )
 column=(type=decimal(4) updatewhereclause=yes name=qta dbname="rdoc.rdoc_qta" )
 column=(type=decimal(6) updatewhereclause=yes name=pr_pezzo dbname="rdoc.rdoc_pr_pezzo" )
 column=(type=char(16) updatewhereclause=yes name=doc_doc_numero dbname="doc.doc_numero" )
 column=(type=date updatewhereclause=yes name=doc_doc_data dbname="doc.doc_data" )
 column=(type=char(8) updatewhereclause=yes name=conto_conto_codice dbname="conto.conto_codice" )
 column=(type=char(80) updatewhereclause=yes name=rag_sociale_cliente dbname="ana.ana_rag_sociale" )
 column=(type=long updatewhereclause=yes name=rdoc_rdoc_art_id dbname="rdoc.rdoc_art_id" )
 column=(type=long updatewhereclause=yes name=val_base_art_sconto_punti dbname="val_base.art_sconto_punti" )
 column=(type=char(80) updatewhereclause=yes name=anab_rag_sociale dbname="ana.ana_rag_sociale" )
 retrieve="  SELECT ~"rdoc~".~"rdoc_id~",   
         ~"rdoc~".~"rdoc_qta~",   
         ~"rdoc~".~"rdoc_pr_pezzo~",   
         ~"doc~".~"doc_numero~",   
         ~"doc~".~"doc_data~",   
         ~"conto_a~".~"conto_codice~",   
         ~"ana_a~".~"ana_rag_sociale~",   
         ~"rdoc~".~"rdoc_art_id~",   
         ~"val_base~".~"art_sconto_punti~",   
         ~"ana_b~".~"ana_rag_sociale~"  
    FROM ~"conto~" ~"conto_a~",   
         ~"doc~",   
         ~"rdoc~",   
         ~"lega_conto_a_presentante~",   
         ~"conto~" ~"conto_b~",   
         ~"ana~" ~"ana_a~",   
         ~"ana~" ~"ana_b~",   
         ~"val_base~"  
   WHERE ( ~"doc~".~"doc_conto_id~" = ~"conto_a~".~"conto_id~" ) and  
         ( ~"rdoc~".~"rdoc_doc_id~" = ~"doc~".~"doc_id~" ) and  
         ( ~"lega_conto_a_presentante~".~"id_conto_cliente~" = ~"conto_a~".~"conto_id~" ) and  
         ( ~"lega_conto_a_presentante~".~"id_conto_presentante~" = ~"conto_b~".~"conto_id~" ) and  
         ( ~"ana_a~".~"ana_id~" = ~"conto_a~".~"ana_id~" ) and  
         ( ~"ana_b~".~"ana_id~" = ~"conto_b~".~"ana_id~" ) and  
         ( ( ~"conto_b~".~"id_tipo_conto~" = 1 ) AND  
         ( ~"doc~".~"doc_data~" >= :da_data ) AND  
         ( ~"doc~".~"doc_data~" <= :a_data ) )    
" arguments=(("perc", number),("da_data", date),("a_data", date))  sort="anab_rag_sociale A doc_doc_data A " )
