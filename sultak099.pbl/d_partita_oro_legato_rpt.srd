 column=(type=date updatewhereclause=yes name=doc_data_scarico dbname="doc.doc_data" )
 column=(type=decimal(4) updatewhereclause=yes name=rdoc_peso_scarico dbname="rdoc.rdoc_peso" )
 column=(type=decimal(4) updatewhereclause=yes name=rdoc_finoecalo_scarico dbname="rdoc.finoecalo" )
 column=(type=char(80) updatewhereclause=yes name=ana_rag_sociale dbname="ana.ana_rag_sociale" )
 column=(type=char(2) updatewhereclause=yes name=caus_partita dbname="causale.caus_partita" )
 column=(type=decimal(2) updatewhereclause=yes name=tot_scarico dbname="tot_scarico" )
 column=(type=long updatewhereclause=yes name=rdoc_numero dbname="rdoc.rdoc_numero" )
 column=(type=long updatewhereclause=yes name=doc_conto_id dbname="doc.doc_conto_id" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"doc~" ALIAS=~"doc_a~" )  TABLE(NAME=~"partita_scarico~" )  TABLE(NAME=~"rdoc~" ALIAS=~"rdoc_a~" )  TABLE(NAME=~"titolo~" )  TABLE(NAME=~"metallo~" )  TABLE(NAME=~"doc~" ALIAS=~"doc_b~" )  TABLE(NAME=~"rdoc~" ALIAS=~"rdoc_b~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"ana~" )  TABLE(NAME=~"causale~" ) COLUMN(NAME=~"doc_a.doc_numero~") COLUMN(NAME=~"doc_a.doc_data~") COLUMN(NAME=~"rdoc_a.rdoc_peso~") COLUMN(NAME=~"rdoc_a.finoecalo~") COLUMN(NAME=~"metallo.met_metallo~") COLUMN(NAME=~"titolo.tit_titolo~") COLUMN(NAME=~"rdoc_a.rdoc_calo~") COLUMN(NAME=~"partita_scarico.scarico~") COLUMN(NAME=~"partita_scarico.numero~") COLUMN(NAME=~"partita_scarico.id_apertura~") COLUMN(NAME=~"doc_b.doc_numero~") COLUMN(NAME=~"doc_b.doc_data~") COLUMN(NAME=~"rdoc_b.rdoc_peso~") COLUMN(NAME=~"rdoc_b.finoecalo~") COLUMN(NAME=~"ana.ana_rag_sociale~") COLUMN(NAME=~"causale.caus_partita~") COMPUTE(NAME=~"cast(ifnull((select sum(scarico) from partita_scarico where id_apertura=rdoc_a.rdoc_id),0, (select sum(scarico) from partita_scarico where id_apertura=rdoc_a.rdoc_id)) as decimal(10,2)) as tot_scarico~") COLUMN(NAME=~"rdoc_b.rdoc_numero~") COLUMN(NAME=~"doc_a.doc_conto_id~")    JOIN (LEFT=~"rdoc_a.rdoc_id~"    OP =~"=~"RIGHT=~"partita_scarico.id_apertura~"    OUTER1 =~"rdoc_a.rdoc_id~" )    JOIN (LEFT=~"partita_scarico.id_scarico~"    OP =~"=~"RIGHT=~"rdoc_b.rdoc_id~"    OUTER1 =~"partita_scarico.id_scarico~" )    JOIN (LEFT=~"rdoc_b.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc_b.doc_id~"    OUTER1 =~"rdoc_b.rdoc_doc_id~" )    JOIN (LEFT=~"rdoc_a.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc_a.doc_id~" )    JOIN (LEFT=~"rdoc_a.tit_id~"    OP =~"=~"RIGHT=~"titolo.tit_id~" )    JOIN (LEFT=~"metallo.met_id~"    OP =~"=~"RIGHT=~"titolo.tit_met_id~" )    JOIN (LEFT=~"doc_a.doc_conto_id~"    OP =~"=~"RIGHT=~"conto.conto_id~" )    JOIN (LEFT=~"ana.ana_id~"    OP =~"=~"RIGHT=~"conto.ana_id~" )    JOIN (LEFT=~"rdoc_a.causale_id~"    OP =~"=~"RIGHT=~"causale.caus_id~" )WHERE(    EXP1 =~"~~~"doc_a~~~".~~~"doc_conto_id~~~"~"   OP =~"=~"    EXP2 =~":id_conto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"doc_a~~~".~~~"doc_data~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"doc_a~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"causale~~~".~~~"caus_c_s~~~"~"   OP =~"=~"    EXP2 =~"'C'~" ) ) ARG(NAME = ~"id_conto~" TYPE = number)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " arguments=(("id_conto", number),("da_data", date),("a_data", date))  sort="caus_partita A metallo_met_metallo A doc_doc_data A doc_doc_numero A partita_scarico_id_apertura A rdoc_numero A " )
