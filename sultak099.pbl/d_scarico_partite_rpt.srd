 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"doc~" ALIAS=~"doc_a~" )  TABLE(NAME=~"partita_scarico~" )  TABLE(NAME=~"rdoc~" ALIAS=~"rdoc_a~" )  TABLE(NAME=~"doc~" ALIAS=~"doc_b~" )  TABLE(NAME=~"rdoc~" ALIAS=~"rdoc_b~" ) COLUMN(NAME=~"doc_a.doc_id~") COLUMN(NAME=~"doc_a.doc_num_prog~") COLUMN(NAME=~"doc_a.doc_data_prog~") COLUMN(NAME=~"doc_a.doc_numero~") COLUMN(NAME=~"doc_a.doc_data~") COLUMN(NAME=~"rdoc_a.rdoc_id~") COLUMN(NAME=~"rdoc_a.rdoc_numero~") COLUMN(NAME=~"rdoc_a.tit_id~") COLUMN(NAME=~"rdoc_a.rdoc_peso~") COLUMN(NAME=~"rdoc_a.rdoc_qta~") COLUMN(NAME=~"rdoc_a.rdoc_calo~") COLUMN(NAME=~"rdoc_a.finoecalo~") COLUMN(NAME=~"partita_scarico.id_scarico~") COLUMN(NAME=~"partita_scarico.id_apertura~") COLUMN(NAME=~"partita_scarico.scarico~") COLUMN(NAME=~"partita_scarico.numero~") COLUMN(NAME=~"doc_b.doc_id~") COLUMN(NAME=~"doc_b.doc_num_prog~") COLUMN(NAME=~"doc_b.doc_data_prog~") COLUMN(NAME=~"doc_b.doc_numero~") COLUMN(NAME=~"doc_b.doc_data~") COLUMN(NAME=~"rdoc_b.rdoc_id~") COLUMN(NAME=~"rdoc_b.rdoc_numero~") COLUMN(NAME=~"rdoc_b.tit_id~") COLUMN(NAME=~"rdoc_b.rdoc_peso~") COLUMN(NAME=~"rdoc_b.rdoc_qta~") COLUMN(NAME=~"rdoc_b.rdoc_calo~") COLUMN(NAME=~"rdoc_b.finoecalo~") COLUMN(NAME=~"doc_a.doc_conto_id~")    JOIN (LEFT=~"rdoc_a.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc_a.doc_id~" )    JOIN (LEFT=~"rdoc_b.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc_b.doc_id~" )    JOIN (LEFT=~"partita_scarico.id_scarico~"    OP =~"=~"RIGHT=~"rdoc_b.rdoc_id~" )    JOIN (LEFT=~"partita_scarico.id_apertura~"    OP =~"=~"RIGHT=~"rdoc_a.rdoc_id~" )WHERE(    EXP1 =~"~~~"doc_a~~~".~~~"doc_conto_id~~~"~"   OP =~"=~"    EXP2 =~":id_conto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"doc_b~~~".~~~"doc_data~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"doc_b~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" ) ) ARG(NAME = ~"id_conto~" TYPE = number)  ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " update="partita_scarico" updatewhere=1 updatekeyinplace=yes arguments=(("id_conto", number),("da_data", date),("a_data", date))  sort="partita_scarico_id_scarico A doc_doc_data A " )
