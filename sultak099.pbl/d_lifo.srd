release 10;
datawindow(units=0 timer_interval=0 color=1073741824 processing=0 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes hidegrayline=no )
header(height=132 color="536870912" )
summary(height=424 color="536870912" )
footer(height=128 color="536870912" )
detail(height=0 color="134217857~tif(  causale_lifo ='A', rgb(255,255,255), 255)" )
table(column=(type=char(32) updatewhereclause=yes name=art_art_codice dbname="art.art_codice" )
 column=(type=decimal(6) updatewhereclause=yes name=pr_pezzo dbname="rdoc.rdoc_pr_pezzo" )
 column=(type=char(1) updatewhereclause=yes name=caus_mag_pezzi dbname="causale.caus_mag_pezzi" )
 column=(type=decimal(4) updatewhereclause=yes name=sqta dbname="sqta" )
 column=(type=date updatewhereclause=yes name=doc_doc_data dbname="doc.doc_data" )
 column=(type=char(16) updatewhereclause=yes name=doc_doc_numero dbname="doc.doc_numero" )
 column=(type=decimal(4) updatewhereclause=yes name=qta_originale dbname="qta_originale" )
 column=(type=decimal(6) updatewhereclause=yes name=pr_man dbname="rdoc.rdoc_pr_man" )
 column=(type=decimal(6) updatewhereclause=yes name=pr_gr_complessivo dbname="rdoc.rdoc_pr_gr_complessivo" )
 column=(type=decimal(4) updatewhereclause=yes name=cpeso dbname="cpeso" )
 column=(type=decimal(4) updatewhereclause=yes name=cpeso_originale dbname="cpeso_originale" )
 column=(type=char(1) updatewhereclause=yes name=um_tipo dbname="u_misura.um_tipo" )
 column=(type=char(1) updatewhereclause=yes name=causale_lifo dbname="causale.lifo" )
 column=(type=decimal(2) updatewhereclause=yes name=rdoc_calo dbname="rdoc.rdoc_calo" )
 column=(type=decimal(6) updatewhereclause=yes name=rdoc_quotazione dbname="rdoc.rdoc_quotazione" )
 column=(type=char(2) updatewhereclause=yes name=u_misura_um_codice dbname="u_misura.um_codice" )
 column=(type=long updatewhereclause=yes name=art_id_codifica dbname="art.art_id_codifica" )
 column=(type=char(2) updatewhereclause=yes name=met_metallo dbname="metallo.met_metallo" )
 column=(type=long updatewhereclause=yes name=met_id dbname="metallo.met_id" )
 retrieve="  SELECT  ~"art~".~"art_codice~" , 
          ~"rdoc~".~"rdoc_pr_pezzo~" , 
          ~"causale~".~"caus_mag_pezzi~" ,   
        Cast(sum(rdoc_qta) as decimal) as sqta,    
       ~"doc~".~"doc_data~" ,           ~"doc~".~"doc_numero~" ,       
    Cast(sum(rdoc_qta) as decimal) as qta_originale,           ~"rdoc~".~"rdoc_pr_man~" ,        
   ~"rdoc~".~"rdoc_pr_gr_complessivo~" ,           Cast(sum(rdoc_peso) as decimal) as cpeso,     
      Cast(sum(rdoc_peso) as decimal) as cpeso_originale,           ~"u_misura~".~"um_tipo~" ,   
        ~"causale~".~"lifo~", ~"rdoc~".~"rdoc_calo~", ~"rdoc~".~"rdoc_quotazione~", ~"u_misura~".~"um_codice~",
~"art~".~"art_id_codifica~", ~"metallo~".~"met_metallo~", ~"metallo~".~"met_id~" 

     FROM {oj ~"rdoc~" LEFT OUTER JOIN ~"titolo~" ON ~"rdoc~".~"tit_id~" = ~"titolo~".~"tit_id~" LEFT OUTER JOIN ~"metallo~" ON ~"titolo~".~"tit_met_id~" = ~"metallo~".~"met_id~" }, 
~"art~" ,           ~"doc~" ,           ~"rdoc~" ,           ~"causale~" ,  
         ~"u_misura~"     

WHERE ( ~"rdoc~".~"rdoc_doc_id~" = ~"doc~".~"doc_id~" ) and        
  ( ~"rdoc~".~"rdoc_art_id~" = ~"art~".~"art_id~" ) and     
     ( ~"rdoc~".~"causale_id~" = ~"causale~".~"caus_id~" ) and          ( ~"rdoc~".~"um_id~" = ~"u_misura~".~"um_id~" ) 
and          (~"causale~".~"lifo~" = 'V' or          ( ~"causale~".~"lifo~" = 'A') ) and  
        ( ~"doc~".~"doc_data~" >= :da_data ) and          ( ~"doc~".~"doc_data~" <= :a_data )  
GROUP BY ~"art~".~"art_codice~" ,           ~"rdoc~".~"rdoc_pr_pezzo~" ,    
       ~"causale~".~"caus_mag_pezzi~" ,           ~"doc~".~"doc_data~" ,       
    ~"causale~".~"lifo~" ,           ~"u_misura~".~"um_tipo~" ,           ~"doc~".~"doc_numero~" ,  
         ~"rdoc~".~"rdoc_pr_man~" ,           ~"rdoc~".~"rdoc_pr_gr_complessivo~",
 ~"rdoc~".~"rdoc_calo~", ~"rdoc~".~"rdoc_quotazione~", ~"u_misura~".~"um_codice~", ~"art~".~"art_id_codifica~",
~"metallo~".~"met_metallo~",~"metallo~".~"met_id~" 

ORDER BY ~"art~".~"art_codice~"          ASC  " arguments=(("da_data", date),("a_data", date))  sort="art_art_codice A doc_doc_data A caus_mag_pezzi D causale_lifo A pr_pezzo A pr_man A " )
group(level=1 header.height=0 trailer.height=308 by=("art_art_codice" ) header.color="536870912" trailer.color="536870912" )
