 retrieve="  SELECT  ~"ana~".~"ana_id~" ,           ~"ana~".~"ana_rag_sociale~" ,           ~"ana~".~"ana_indirizzo~" ,           ~"ana~".~"ana_localita~" ,           ~"ana~".~"ana_cap~" ,      
     ~"ana~".~"ana_citta~" ,           ~"ana~".~"ana_provincia~" ,           ~"ana~".~"ana_p_iva~" ,           ~"ana~".~"ana_c_f~" ,           ~"lingua~".~"lingua_codice~" ,           ~"valuta~".~"val_codice~" ,  
         ~"ana~".~"bollo~" ,           ~"ana~".~"nota~" ,           ~"tipo_conto~".~"tipo~" ,           ~"ana~".~"e_mail_1~" ,           ~"ana~".~"e_mail_2~" ,           ~"ana~".~"pec~"  FROM {oj ~"ana~" LEFT OUTER JOIN ~"lingua~" ON ~"ana~".~"lingua_id~" = ~"lingua~".~"lingua_id~" LEFT OUTER JOIN ~"valuta~" ON ~"ana~".~"val_id~" = ~"valuta~".~"val_id~" LEFT OUTER JOIN ~"conto~" ON ~"ana~".~"ana_id~" = ~"conto~".~"ana_id~"}, {oj ~"tipo_conto~" RIGHT OUTER JOIN ~"conto~" ON ~"tipo_conto~".~"id_tipo_conto~" = ~"conto~".~"id_tipo_conto~"}   "  sort="ana_ana_rag_sociale A " )
