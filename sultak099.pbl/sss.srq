PBSELECT( VERSION(400) TABLE(NAME="art" )  TABLE(NAME="doc" )  TABLE(NAME="rdoc" ) COLUMN(NAME="art.art_codice") COLUMN(NAME="doc.doc_num_prog") COLUMN(NAME="doc.doc_data_prog") COLUMN(NAME="doc.doc_numero") COLUMN(NAME="doc.doc_data") COLUMN(NAME="rdoc.rdoc_peso") COLUMN(NAME="rdoc.rdoc_qta")    JOIN (LEFT="rdoc.rdoc_doc_id"    OP ="="RIGHT="doc.doc_id" )    JOIN (LEFT="rdoc.rdoc_art_id"    OP ="="RIGHT="art.art_id" )) 