compute(band=detail alignment="0" expression="if(isnull( rdoc_rdoc_quotazione), 0,  rdoc_rdoc_quotazione  * rdoc_finoecalo )"border="0" color="33554432" x="1833" y="16" height="64" width="215" format="[GENERAL]" html.valueishtml="0"  name=c_val_metallo visible="1"  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=detail alignment="1" expression="if( causale_caus_mag_pezzi ='+',  rdoc_rdoc_qta , if(causale_caus_mag_fino  ='-', rdoc_rdoc_qta * -1,0))"border="0" color="33554432" x="1129" y="28" height="64" width="215" format="[GENERAL]" html.valueishtml="0"  name=c_qta visible="1"  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=detail alignment="1" expression="if( causale_caus_mag_euro ='+', if( rdoc_rdoc_pr_man >0,  rdoc_rdoc_pr_man , if( rdoc_rdoc_pr_pezzo>0 ,  rdoc_rdoc_pr_pezzo ,  rdoc_rdoc_pr_gr_complessivo )), if( causale_caus_mag_euro ='-',  if( rdoc_rdoc_pr_man >0,  rdoc_rdoc_pr_man , if( rdoc_rdoc_pr_pezzo>0 ,  rdoc_rdoc_pr_pezzo ,  rdoc_rdoc_pr_gr_complessivo )) * - 1, 0))"border="0" color="0" x="1435" y="24" height="76" width="256" format="#,0.0000" html.valueishtml="0"  name=c_prezzo visible="1"  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="0" expression="if( causale_caus_mag_euro ='+', if( rdoc_rdoc_pr_man >0 or  rdoc_rdoc_pr_gr_complessivo >0,   c_prezzo * rdoc_rdoc_peso ,  rdoc_rdoc_pr_pezzo * rdoc_rdoc_qta ), if( causale_caus_mag_euro ='-', if( rdoc_rdoc_pr_man >0 or  rdoc_rdoc_pr_gr_complessivo >0,   c_prezzo * rdoc_rdoc_peso ,  rdoc_rdoc_pr_pezzo * rdoc_rdoc_qta ) * -1, 0))"border="0" color="0" x="2162" y="8" height="64" width="215" format="[GENERAL]" html.valueishtml="0"  name=c_valore visible="1"  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=detail alignment="1" expression="if(  causale_caus_mag_fino  ='+',   rdoc_rdoc_peso ,  if(causale_caus_mag_fino  ='-', rdoc_rdoc_peso * -1, 0))"border="0" color="33554432" x="786" y="28" height="64" width="215" format="[GENERAL]" html.valueishtml="0"  name=c_peso visible="1"  font.face="Arial" font.height="-10" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
