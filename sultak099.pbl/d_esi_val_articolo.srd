release 10;
datawindow(units=0 timer_interval=0 color=1073741824 processing=0 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes hidegrayline=no )
header(height=232 color="536870912" )
summary(height=88 color="536870912" )
footer(height=0 color="536870912" )
detail(height=0 color="536870912" )
table(column=(type=char(32) updatewhereclause=yes name=art_art_codice dbname="art.art_codice" )
 column=(type=char(80) updatewhereclause=yes name=art_art_descrizione dbname="art.art_descrizione" )
 column=(type=decimal(4) updatewhereclause=yes name=rdoc_rdoc_peso dbname="rdoc.rdoc_peso" )
 column=(type=decimal(4) updatewhereclause=yes name=rdoc_rdoc_qta dbname="rdoc.rdoc_qta" )
 column=(type=char(2) updatewhereclause=yes name=metallo_met_metallo dbname="metallo.met_metallo" )
 column=(type=decimal(2) updatewhereclause=yes name=titolo_tit_titolo dbname="titolo.tit_titolo" )
 column=(type=decimal(6) updatewhereclause=yes name=rdoc_rdoc_pr_man dbname="rdoc.rdoc_pr_man" )
 column=(type=decimal(6) updatewhereclause=yes name=rdoc_rdoc_quotazione dbname="rdoc.rdoc_quotazione" )
 column=(type=decimal(6) updatewhereclause=yes name=rdoc_rdoc_pr_gr_complessivo dbname="rdoc.rdoc_pr_gr_complessivo" )
 column=(type=decimal(6) updatewhereclause=yes name=rdoc_rdoc_pr_pezzo dbname="rdoc.rdoc_pr_pezzo" )
 column=(type=decimal(4) updatewhereclause=yes name=rdoc_rdoc_non_prezioso dbname="rdoc.rdoc_non_prezioso" )
 column=(type=decimal(4) updatewhereclause=yes name=rdoc_finoecalo dbname="rdoc.finoecalo" )
 column=(type=char(1) updatewhereclause=yes name=causale_caus_mag_fino dbname="causale.caus_mag_fino" )
 column=(type=char(1) updatewhereclause=yes name=causale_caus_mag_euro dbname="causale.caus_mag_euro" )
 column=(type=char(1) updatewhereclause=yes name=causale_caus_mag_pezzi dbname="causale.caus_mag_pezzi" )
 column=(type=date updatewhereclause=yes name=doc_doc_data dbname="doc.doc_data" )
 column=(type=char(16) updatewhereclause=yes name=doc_doc_numero dbname="doc.doc_numero" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"art~" )  TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"titolo~" )  TABLE(NAME=~"causale~" )  TABLE(NAME=~"metallo~" )  TABLE(NAME=~"doc~" ) COLUMN(NAME=~"art.art_codice~") COLUMN(NAME=~"art.art_descrizione~") COLUMN(NAME=~"rdoc.rdoc_peso~") COLUMN(NAME=~"rdoc.rdoc_qta~") COLUMN(NAME=~"metallo.met_metallo~") COLUMN(NAME=~"titolo.tit_titolo~") COLUMN(NAME=~"rdoc.rdoc_pr_man~") COLUMN(NAME=~"rdoc.rdoc_quotazione~") COLUMN(NAME=~"rdoc.rdoc_pr_gr_complessivo~") COLUMN(NAME=~"rdoc.rdoc_pr_pezzo~") COLUMN(NAME=~"rdoc.rdoc_non_prezioso~") COLUMN(NAME=~"rdoc.finoecalo~") COLUMN(NAME=~"causale.caus_mag_fino~") COLUMN(NAME=~"causale.caus_mag_euro~") COLUMN(NAME=~"causale.caus_mag_pezzi~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"doc.doc_numero~")    JOIN (LEFT=~"art.art_id~"    OP =~"=~"RIGHT=~"rdoc.rdoc_art_id~" )    JOIN (LEFT=~"titolo.tit_id~"    OP =~"=~"RIGHT=~"rdoc.tit_id~" )    JOIN (LEFT=~"causale.caus_id~"    OP =~"=~"RIGHT=~"rdoc.causale_id~" )    JOIN (LEFT=~"metallo.met_id~"    OP =~"=~"RIGHT=~"titolo.tit_met_id~" )    JOIN (LEFT=~"doc.doc_id~"    OP =~"=~"RIGHT=~"rdoc.rdoc_doc_id~" )WHERE(    EXP1 =~"~~~"causale~~~".~~~"caus_mag_fino~~~"~"   OP =~">~"    EXP2 =~"' '~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"causale~~~".~~~"caus_mag_pezzi~~~"~"   OP =~">~"    EXP2 =~"' '~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"causale~~~".~~~"caus_mag_euro~~~"~"   OP =~">~"    EXP2 =~"' '~" ) ) "  sort="art_art_codice A doc_doc_data A doc_doc_numero A " )
