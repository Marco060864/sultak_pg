 column=(type=long updatewhereclause=yes identity=yes name=causale_caus_id dbname="causale.caus_id" )
 column=(type=char(1) updatewhereclause=yes name=causale_caus_fiscale dbname="causale.caus_fiscale" )
 column=(type=char(1) updatewhereclause=yes name=causale_caus_mag_fino dbname="causale.caus_mag_fino" )
 column=(type=char(1) updatewhereclause=yes name=causale_caus_mag_pezzi dbname="causale.caus_mag_pezzi" )
 column=(type=long updatewhereclause=yes name=doc_guida_id dbname="doc.guida_id" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"art~" )  TABLE(NAME=~"doc~" )  TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"causale~" ) COLUMN(NAME=~"art.art_id~") COLUMN(NAME=~"art.art_codice~") COLUMN(NAME=~"doc.doc_id~") COLUMN(NAME=~"doc.doc_num_prog~") COLUMN(NAME=~"doc.doc_data_prog~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"rdoc.rdoc_peso~") COLUMN(NAME=~"rdoc.rdoc_qta~") COLUMN(NAME=~"rdoc.finoecalo~") COLUMN(NAME=~"causale.caus_codice~") COLUMN(NAME=~"causale.caus_id~") COLUMN(NAME=~"causale.caus_fiscale~") COLUMN(NAME=~"causale.caus_mag_fino~") COLUMN(NAME=~"causale.caus_mag_pezzi~") COLUMN(NAME=~"doc.guida_id~")    JOIN (LEFT=~"rdoc.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~" )    JOIN (LEFT=~"rdoc.rdoc_art_id~"    OP =~"=~"RIGHT=~"art.art_id~" )    JOIN (LEFT=~"rdoc.causale_id~"    OP =~"=~"RIGHT=~"causale.caus_id~" )WHERE(    EXP1 =~"(~~~"causale~~~".~~~"caus_mag_fino~~~"~"   OP =~"=~"    EXP2 =~"'+'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"causale~~~".~~~"caus_mag_fino~~~"~"   OP =~"=~"    EXP2 =~"'-')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"art~~~".~~~"art_id~~~"~"   OP =~"=~"    EXP2 =~":id_art~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"causale~~~".~~~"caus_fiscale~~~"~"   OP =~"=~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"id_art~" TYPE = number)  ARG(NAME = ~"peso_esistente~" TYPE = string) " arguments=(("id_art", number),("peso_esistente", string))  sort="doc_doc_data A art_art_codice A " )
