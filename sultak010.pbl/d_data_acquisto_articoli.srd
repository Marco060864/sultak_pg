table(column=(type=long updatewhereclause=yes identity=yes name=art_art_id dbname="art.art_id" )
 column=(type=char(32) updatewhereclause=yes name=art_art_codice dbname="art.art_codice" )
 column=(type=long updatewhereclause=yes identity=yes name=doc_doc_id dbname="doc.doc_id" )
 column=(type=long updatewhereclause=yes name=doc_doc_num_prog dbname="doc.doc_num_prog" )
 column=(type=date updatewhereclause=yes name=doc_doc_data_prog dbname="doc.doc_data_prog" )
 column=(type=char(16) updatewhereclause=yes name=doc_doc_numero dbname="doc.doc_numero" )
 column=(type=date updatewhereclause=yes name=doc_doc_data dbname="doc.doc_data" )
 column=(type=decimal(4) updatewhereclause=yes name=rdoc_rdoc_peso dbname="rdoc.rdoc_peso" )
 column=(type=decimal(4) updatewhereclause=yes name=rdoc_qta dbname="rdoc.rdoc_qta" )
 column=(type=decimal(4) updatewhereclause=yes name=rdoc_finoecalo dbname="rdoc.finoecalo" )
