 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"doc~" )  TABLE(NAME=~"esercizio~" )  TABLE(NAME=~"registro~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"ana~" ) COLUMN(NAME=~"doc.doc_id~") COLUMN(NAME=~"doc.doc_num_prog~") COLUMN(NAME=~"doc.doc_data_prog~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"doc.doc_conto_id~") COLUMN(NAME=~"doc.reg_id~") COLUMN(NAME=~"registro.reg_numero~") COLUMN(NAME=~"esercizio.ese_codice~") COLUMN(NAME=~"esercizio.ese_data_inizio~") COLUMN(NAME=~"esercizio.ese_data_fine~") COLUMN(NAME=~"conto.conto_codice~") COLUMN(NAME=~"ana.ana_rag_sociale~")    JOIN (LEFT=~"registro.reg_id~"    OP =~"=~"RIGHT=~"doc.reg_id~" )    JOIN (LEFT=~"registro.reg_ese_id~"    OP =~"=~"RIGHT=~"esercizio.ese_id~" )    JOIN (LEFT=~"conto.conto_id~"    OP =~"=~"RIGHT=~"doc.doc_conto_id~" )    JOIN (LEFT=~"conto.ana_id~"    OP =~"=~"RIGHT=~"ana.ana_id~" )WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~">~"    EXP2 =~"~~~"esercizio~~~".~~~"ese_data_fine~~~"~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<~"    EXP2 =~"~~~"esercizio~~~".~~~"ese_data_inizio~~~"~" ) ) " )
