detail(height=83 color="536870912" )
table(column=(type=long updatewhereclause=yes name=art_art_id dbname="art.art_id" )
 column=(type=char(32) updatewhereclause=yes name=art_art_codice dbname="art.art_codice" )
 column=(type=decimal(4) updatewhereclause=yes name=giacenza dbname="giacenza" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"art~" )  TABLE(NAME=~"doc~" )  TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"causale~" ) COLUMN(NAME=~"art.art_id~") COLUMN(NAME=~"art.art_codice~") COMPUTE(NAME=~"SUM(CASE caus_mag_fino WHEN '+' THEN rdoc_peso ELSE rdoc_peso* -1 END) AS Giacenza~")    JOIN (LEFT=~"rdoc.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~" )    JOIN (LEFT=~"rdoc.rdoc_art_id~"    OP =~"=~"RIGHT=~"art.art_id~" )    JOIN (LEFT=~"rdoc.causale_id~"    OP =~"=~"RIGHT=~"causale.caus_id~" )WHERE(    EXP1 =~"(~~~"causale~~~".~~~"caus_mag_fino~~~"~"   OP =~"=~"    EXP2 =~"'+'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"causale~~~".~~~"caus_mag_fino~~~"~"   OP =~"=~"    EXP2 =~"'-')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"causale~~~".~~~"caus_fiscale~~~"~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"rdoc_peso~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~">=~"    EXP2 =~":da_data~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"~~~"doc~~~".~~~"doc_data~~~"~"   OP =~"<=~"    EXP2 =~":a_data~" )  GROUP(NAME=~"art.art_codice~") GROUP(NAME=~"art.art_id~")) ORDER(NAME=~"art.art_codice~" ASC=yes )  ORDER(NAME=~"art.art_id~" ASC=yes ) ARG(NAME = ~"da_data~" TYPE = date)  ARG(NAME = ~"a_data~" TYPE = date) " filter=" giacenza <>0"arguments=(("da_data", date),("a_data", date))  sort="art_art_codice A " )
