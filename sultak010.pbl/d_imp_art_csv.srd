 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"art~" ) COLUMN(NAME=~"art.art_id~") COLUMN(NAME=~"art.art_codice~") COLUMN(NAME=~"art.art_descrizione~") COLUMN(NAME=~"art.art_creato~") COLUMN(NAME=~"art.art_modificato~") COLUMN(NAME=~"art.art_tit_preferenziale~") COLUMN(NAME=~"art.art_calo_preferenziale~") COLUMN(NAME=~"art.ruota~") COLUMN(NAME=~"art.st_in_catalogo~") COLUMN(NAME=~"art.peso~") COLUMN(NAME=~"art.um_id~") COLUMN(NAME=~"art.misura~") COLUMN(NAME=~"art.usa_in_magazzino~") COLUMN(NAME=~"art.peso_non_prezioso~") COLUMN(NAME=~"art.barcode~") COLUMN(NAME=~"art.id_taglia~") COLUMN(NAME=~"art.id_colore~") COLUMN(NAME=~"art.iva_id~") COMPUTE(NAME=~"cast('  ' as char(2)) as metallo~") COLUMN(NAME=~"art.art_id_codifica~")) " update="art" updatewhere=1 updatekeyinplace=yes )
