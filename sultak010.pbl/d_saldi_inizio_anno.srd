 column=(type=char(1) updatewhereclause=yes name=causale_caus_mag_pezzi dbname="causale.caus_mag_pezzi" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"conto~" )  TABLE(NAME=~"doc~" )  TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"causale~" ) COLUMN(NAME=~"conto.conto_id~") COLUMN(NAME=~"conto.conto_codice~") COLUMN(NAME=~"doc.doc_id~") COLUMN(NAME=~"doc.doc_num_prog~") COLUMN(NAME=~"doc.doc_data_prog~") COLUMN(NAME=~"doc.doc_numero~") COLUMN(NAME=~"doc.doc_data~") COLUMN(NAME=~"rdoc.rdoc_id~") COLUMN(NAME=~"rdoc.rdoc_numero~") COLUMN(NAME=~"rdoc.rdoc_peso~") COLUMN(NAME=~"rdoc.rdoc_qta~") COLUMN(NAME=~"rdoc.rdoc_art_id~") COLUMN(NAME=~"rdoc.finoecalo~") COLUMN(NAME=~"rdoc.rdoc_non_prezioso~") COLUMN(NAME=~"causale.caus_id~") COLUMN(NAME=~"causale.caus_codice~") COLUMN(NAME=~"causale.caus_mag_fino~") COLUMN(NAME=~"causale.caus_mag_pezzi~")    JOIN (LEFT=~"doc.doc_conto_id~"    OP =~"=~"RIGHT=~"conto.conto_id~" )    JOIN (LEFT=~"rdoc.rdoc_doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~" )    JOIN (LEFT=~"rdoc.causale_id~"    OP =~"=~"RIGHT=~"causale.caus_id~" )WHERE(    EXP1 =~"~~~"causale~~~".~~~"caus_mag_pezzi~~~"~"   OP =~"=~"    EXP2 =~"'+'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"causale~~~".~~~"caus_mag_pezzi~~~"~"   OP =~"=~"    EXP2 =~"'-'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"causale~~~".~~~"caus_mag_fino~~~"~"   OP =~"=~"    EXP2 =~"'+'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"~~~"causale~~~".~~~"caus_mag_fino~~~"~"   OP =~"=~"    EXP2 =~"'-'~" ) ) "  sort="conto_conto_codice A doc_doc_data A doc_doc_numero A causale_caus_codice A " )
