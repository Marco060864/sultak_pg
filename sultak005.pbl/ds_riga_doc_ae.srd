 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"rdoc~" )  TABLE(NAME=~"iva~" )  TABLE(NAME=~"u_misura~" )  TABLE(NAME=~"art~" ) COLUMN(NAME=~"rdoc.rdoc_id~") COLUMN(NAME=~"rdoc.rdoc_doc_id~") COLUMN(NAME=~"rdoc.rdoc_numero~") COLUMN(NAME=~"iva.iva_aliquota~") COLUMN(NAME=~"iva.natura~") COLUMN(NAME=~"u_misura.um_codice~") COLUMN(NAME=~"u_misura.um_tipo~") COLUMN(NAME=~"rdoc.rdoc_id_riga_madre~") COLUMN(NAME=~"rdoc.rdoc_peso~") COLUMN(NAME=~"rdoc.rdoc_qta~") COLUMN(NAME=~"rdoc.rdoc_pr_pezzo~") COLUMN(NAME=~"rdoc.rdoc_pr_man~") COLUMN(NAME=~"rdoc.rdoc_pr_gr_complessivo~") COLUMN(NAME=~"rdoc.rdoc_descrizione~") COLUMN(NAME=~"rdoc.tit_id~") COLUMN(NAME=~"rdoc.rdoc_calo~") COLUMN(NAME=~"rdoc.rdoc_quotazione~") COLUMN(NAME=~"rdoc.rdoc_non_prezioso~") COLUMN(NAME=~"art.art_codice~") COLUMN(NAME=~"rdoc.rdoc_art_id~")    JOIN (LEFT=~"rdoc.rdoc_art_id~"    OP =~"=~"RIGHT=~"art.art_id~"    OUTER1 =~"rdoc.rdoc_art_id~" )    JOIN (LEFT=~"rdoc.iva_id~"    OP =~"=~"RIGHT=~"iva.iva_id~" )    JOIN (LEFT=~"rdoc.um_id~"    OP =~"=~"RIGHT=~"u_misura.um_id~" )WHERE(    EXP1 =~"~~~"rdoc~~~".~~~"rdoc_doc_id~~~"~"   OP =~"=~"    EXP2 =~":al_id_doc~" ) ) ARG(NAME = ~"al_id_doc~" TYPE = number) " arguments=(("al_id_doc", number))  sort="rdoc_numero A " )
