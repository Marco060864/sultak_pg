PBSELECT( VERSION(400) TABLE(NAME="rdoc" )  TABLE(NAME="iva" )  TABLE(NAME="u_misura" ) COLUMN(NAME="rdoc.rdoc_id") COLUMN(NAME="rdoc.rdoc_doc_id") COLUMN(NAME="rdoc.rdoc_numero") COLUMN(NAME="iva.iva_aliquota") COLUMN(NAME="iva.natura") COLUMN(NAME="u_misura.um_codice") COLUMN(NAME="u_misura.um_tipo") COLUMN(NAME="rdoc.rdoc_id_riga_madre") COLUMN(NAME="rdoc.rdoc_peso") COLUMN(NAME="rdoc.rdoc_qta") COLUMN(NAME="rdoc.rdoc_pr_pezzo") COLUMN(NAME="rdoc.rdoc_pr_man") COLUMN(NAME="rdoc.rdoc_pr_gr_complessivo") COLUMN(NAME="rdoc.rdoc_descrizione")    JOIN (LEFT="rdoc.iva_id"    OP ="="RIGHT="iva.iva_id" )    JOIN (LEFT="rdoc.um_id"    OP ="="RIGHT="u_misura.um_id" )WHERE(    EXP1 ="~"rdoc~".~"rdoc_doc_id~""   OP ="="    EXP2 =":al_id_doc" ) ) ARG(NAME = "al_id_doc" TYPE = number) 