table(column=(type=long update=yes updatewhereclause=yes name=doc_id dbname="scadenza.doc_id" )
 column=(type=date update=yes updatewhereclause=yes name=scad_data dbname="scadenza.scad_data" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=scad_importo dbname="scadenza.scad_importo" )
 column=(type=char(1) update=yes updatewhereclause=yes name=scad_pagato dbname="scadenza.scad_pagato" )
 column=(type=long update=yes updatewhereclause=yes name=ins_manualmente dbname="scadenza.ins_manualmente" )
 column=(type=date update=yes updatewhereclause=yes name=data_pagamento dbname="scadenza.data_pagamento" )
 column=(type=long update=yes updatewhereclause=yes identity=yes name=id_scadenza dbname="scadenza.id_scadenza" )
 column=(type=char(4) updatewhereclause=yes name=tipo_pagamento dbname="pagamento.tipo_pagamento" )
 column=(type=char(4) updatewhereclause=yes name=mod_pagamento dbname="pagamento.mod_pagamento" )
 column=(type=char(4) updatewhereclause=yes name=cin_internazionale dbname="conto_banca.cin_internazionale" )
 column=(type=char(1) updatewhereclause=yes name=cin dbname="conto_banca.cin" )
 column=(type=char(12) updatewhereclause=yes name=conto_corrente dbname="conto_banca.c_c" )
 column=(type=char(5) updatewhereclause=yes name=cod_abi dbname="banca.banca_cod_abi" )
 column=(type=char(5) updatewhereclause=yes name=cod_cab dbname="banca.banca_cod_cab" )
 column=(type=decimal(0) updatewhereclause=yes name=gg_decorrenza dbname="rpaga.rpaga_gg_decorrenza" )
 column=(type=decimal(0) updatewhereclause=yes name=gg_rate dbname="rpaga.rpaga_gg_rate" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"pagamento~" )  TABLE(NAME=~"doc~" )  TABLE(NAME=~"banca~" )  TABLE(NAME=~"conto_banca~" )  TABLE(NAME=~"rpaga~" ) COLUMN(NAME=~"scadenza.doc_id~") COLUMN(NAME=~"scadenza.scad_data~") COLUMN(NAME=~"scadenza.scad_importo~") COLUMN(NAME=~"scadenza.scad_pagato~") COLUMN(NAME=~"scadenza.ins_manualmente~") COLUMN(NAME=~"scadenza.data_pagamento~") COLUMN(NAME=~"scadenza.id_scadenza~") COLUMN(NAME=~"pagamento.tipo_pagamento~") COLUMN(NAME=~"pagamento.mod_pagamento~") COLUMN(NAME=~"conto_banca.cin_internazionale~") COLUMN(NAME=~"conto_banca.cin~") COLUMN(NAME=~"conto_banca.c_c~") COLUMN(NAME=~"banca.banca_cod_abi~") COLUMN(NAME=~"banca.banca_cod_cab~") COLUMN(NAME=~"rpaga.rpaga_gg_decorrenza~") COLUMN(NAME=~"rpaga.rpaga_gg_rate~")    JOIN (LEFT=~"pagamento.paga_id~"    OP =~"=~"RIGHT=~"rpaga.paga_id~"    OUTER1 =~"pagamento.paga_id~" )    JOIN (LEFT=~"doc.banca_id~"    OP =~"=~"RIGHT=~"banca.banca_id~"    OUTER1 =~"doc.banca_id~" )    JOIN (LEFT=~"doc.banca_id~"    OP =~"=~"RIGHT=~"conto_banca.banca_id~"    OUTER1 =~"doc.banca_id~" )   JOIN (LEFT=~"doc.paga_id~"    OP =~"=~"RIGHT=~"pagamento.paga_id~" )    JOIN (LEFT=~"scadenza.doc_id~"    OP =~"=~"RIGHT=~"doc.doc_id~" ) WHERE(    EXP1 =~"~~~"scadenza~~~".~~~"doc_id~~~"~"   OP =~"=~"    EXP2 =~":al_id_doc~" ) ) ARG(NAME = ~"al_id_doc~" TYPE = number) " arguments=(("al_id_doc", number)) )
