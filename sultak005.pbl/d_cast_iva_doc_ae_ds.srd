 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cast_iva~" )  TABLE(NAME=~"iva~" ) COLUMN(NAME=~"cast_iva.doc_id~") COLUMN(NAME=~"cast_iva.iva_id~") COLUMN(NAME=~"cast_iva.civa_spese~") COLUMN(NAME=~"cast_iva.civa_tot_imp~") COLUMN(NAME=~"cast_iva.civa_tot_iva~") COLUMN(NAME=~"cast_iva.acconto~") COLUMN(NAME=~"iva.iva_codice~") COLUMN(NAME=~"iva.iva_aliquota~") COLUMN(NAME=~"iva.esigibilita~") COLUMN(NAME=~"iva.iva_des~") COLUMN(NAME=~"iva.natura~")    JOIN (LEFT=~"iva.iva_id~"    OP =~"=~"RIGHT=~"cast_iva.iva_id~" )WHERE(    EXP1 =~"~~~"cast_iva~~~".~~~"doc_id~~~"~"   OP =~"=~"    EXP2 =~":al_id_doc~" ) ) ARG(NAME = ~"al_id_doc~" TYPE = number) " arguments=(("al_id_doc", number)) )
