global type f_trova_inizio_esercizio from function_object
end type

forward prototypes
global function date f_trova_inizio_esercizio (date adt_data_doc)
end prototypes

global function date f_trova_inizio_esercizio (date adt_data_doc);
date ldt_data_inizio


select ese_data_inizio
into :ldt_data_inizio
from dba.esercizio
where ese_data_inizio<=:adt_data_doc
and ese_data_fine>=:adt_data_doc
;
return ldt_data_inizio

end function

