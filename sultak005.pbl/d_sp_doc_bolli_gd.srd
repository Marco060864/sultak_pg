 column=(type=decimal(6) update=yes updatewhereclause=yes name=sp_doc_importo dbname="sp_doc.sp_doc_importo" dbalias=".sp_doc_importo" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=sp_doc_percentuale dbname="sp_doc.sp_doc_percentuale" dbalias=".sp_doc_percentuale" )
 column=(type=char(16) updatewhereclause=yes name=spesa_codice dbname="spesa.spesa_codice" dbalias=".spesa_codice" )
