 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"sp_doc~" )  TABLE(NAME=~"spesa~" )  TABLE(NAME=~"iva~" ) COLUMN(NAME=~"sp_doc.spesa_id~") COLUMN(NAME=~"sp_doc.doc_id~") COLUMN(NAME=~"sp_doc.iva_id~") COLUMN(NAME=~"sp_doc.sp_doc_importo~") COLUMN(NAME=~"sp_doc.sp_doc_percentuale~") COLUMN(NAME=~"spesa.spesa_codice~") COLUMN(NAME=~"iva.iva_aliquota~") COLUMN(NAME=~"iva.esigibilita~") COLUMN(NAME=~"iva.iva_des~") COLUMN(NAME=~"iva.natura~")    JOIN (LEFT=~"sp_doc.spesa_id~"    OP =~"=~"RIGHT=~"spesa.spesa_id~" )    JOIN (LEFT=~"sp_doc.iva_id~"    OP =~"=~"RIGHT=~"iva.iva_id~" )WHERE(    EXP1 =~"~~~"dba~~~".~~~"sp_doc~~~".~~~"doc_id~~~"~"   OP =~"=~"    EXP2 =~":al_id_doc~" ) ) ARG(NAME = ~"al_id_doc~" TYPE = number) " update="sp_doc" updatewhere=1 updatekeyinplace=yes arguments=(("al_id_doc", number))  sort="spesa_codice A " )
