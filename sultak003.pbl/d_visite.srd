table(column=(type=long update=yes updatewhereclause=yes name=ana_id dbname="visite.ana_id" dbalias=".ana_id" )
 column=(type=long update=yes updatewhereclause=yes key=yes identity=yes name=visite_id dbname="visite.visite_id" dbalias=".visite_id" )
 column=(type=date update=yes updatewhereclause=yes name=visite_data dbname="visite.visite_data" dbalias=".visite_data" initial="today" )
 column=(type=char(32766) update=yes updatewhereclause=yes name=visite_desc dbname="visite.visite_desc" dbalias=".visite_desc" )
 column=(type=char(1) update=yes updatewhereclause=yes name=visite_giudizio dbname="visite.visite_giudizio" dbalias=".visite_giudizio" values="Ottimo	O/Buono	B/Discreto	D/Sufficiente	S/Insufficiente	I/Nota F2	N/" )
 column=(type=time update=yes updatewhereclause=yes name=visite_arrivo dbname="visite.visite_arrivo" dbalias=".visite_arrivo" )
 column=(type=time update=yes updatewhereclause=yes name=visite_partenza dbname="visite.visite_partenza" dbalias=".visite_partenza" )
 column=(type=char(1) update=yes updatewhereclause=yes name=visite_riscosso dbname="visite.visite_riscosso" dbalias=".visite_riscosso" initial="N" values="	S/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=visite_viaggio dbname="visite.visite_viaggio" dbalias=".visite_viaggio" initial="N" values="	S/	N" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=visite_prepagato dbname="visite.visite_prepagato" dbalias=".visite_prepagato" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=visite_costo_ora dbname="visite.visite_costo_ora" dbalias=".visite_costo_ora" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=visite_costo_viaggio dbname="visite.visite_costo_viaggio" dbalias=".visite_costo_viaggio" )
 column=(type=char(1) update=yes updatewhereclause=yes name=stato dbname="visite.stato" dbalias=".stato" initial="A" values="	C/	A" )
 column=(type=char(32766) update=yes updatewhereclause=no name=nota dbname="visite.nota" dbalias=".nota" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"visite~" ) COLUMN(NAME=~"visite.ana_id~") COLUMN(NAME=~"visite.visite_id~") COLUMN(NAME=~"visite.visite_data~") COLUMN(NAME=~"visite.visite_desc~") COLUMN(NAME=~"visite.visite_giudizio~") COLUMN(NAME=~"visite.visite_arrivo~") COLUMN(NAME=~"visite.visite_partenza~") COLUMN(NAME=~"visite.visite_riscosso~") COLUMN(NAME=~"visite.visite_viaggio~") COLUMN(NAME=~"visite.visite_prepagato~") COLUMN(NAME=~"visite.visite_costo_ora~") COLUMN(NAME=~"visite.visite_costo_viaggio~") COLUMN(NAME=~"visite.stato~") COLUMN(NAME=~"visite.nota~")WHERE(    EXP1 =~"( ~~~"dba~~~".~~~"visite~~~".~~~"ana_id~~~"~"   OP =~"=~"    EXP2 =~":ll_id )~" ) ) ARG(NAME = ~"ll_id~" TYPE = number) " update="visite" updatewhere=1 updatekeyinplace=yes arguments=(("ll_id", number))  sort="visite_data A " )
