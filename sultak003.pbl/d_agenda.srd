 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"agenda~" )  TABLE(NAME=~"ana~" ) COLUMN(NAME=~"agenda.agenda_id_ana~") COLUMN(NAME=~"agenda.agenda_tel1~") COLUMN(NAME=~"agenda.agenda_tel2~") COLUMN(NAME=~"agenda.agenda_cell~") COLUMN(NAME=~"agenda.agenda_mail~") COLUMN(NAME=~"agenda.agenda_giudizio~") COLUMN(NAME=~"agenda.agenda_nota~") COLUMN(NAME=~"ana.ana_rag_sociale~") COLUMN(NAME=~"agenda.agenda_fax~") COLUMN(NAME=~"agenda.agenda_primo_contatto~") COLUMN(NAME=~"agenda.agenda_tipo~") COLUMN(NAME=~"agenda.agenda_gruppo~") COLUMN(NAME=~"ana.ana_indirizzo~") COLUMN(NAME=~"ana.ana_localita~") COLUMN(NAME=~"ana.ana_cap~") COLUMN(NAME=~"ana.ana_citta~") COLUMN(NAME=~"ana.ana_provincia~") COLUMN(NAME=~"ana.ana_p_iva~") COLUMN(NAME=~"ana.ana_c_f~")    JOIN (LEFT=~"agenda.agenda_id_ana~"    OP =~"=~"RIGHT=~"ana.ana_id~"    OUTER2 =~"ana.ana_id~" )) " update="agenda" updatewhere=1 updatekeyinplace=yes  sort="rag_sociale A " )
