compute(band=detail alignment="0" expression=" space(1) +
'30' +
right('0000000' + riga_dis_banca_num_riga, 7) +

left( 
if( isnull(destinazione_rag_soc_1) or destinazione_rag_soc_1=~"~",  if(isnull(rag_soc_1) or  rag_soc_1=~"~" , space(30), rag_soc_1),
 destinazione_rag_soc_1) 
+ space(30), 30) +

left( 
if(isnull(destinazione_rag_soc_2) or destinazione_rag_soc_2=~"~" , if(isnull(rag_soc_2) or rag_soc_2=~"~", space(30), rag_soc_2),
destinazione_rag_soc_2 ) 
+ space(30), 30) +

left( if(isnull(cod_fiscale),  space(16), cod_fiscale)  + space(16), 16) +
space(34)
