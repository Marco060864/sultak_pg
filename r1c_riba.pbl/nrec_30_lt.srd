release 10;
datawindow(units=0 timer_interval=0 color=78682240 processing=0 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes hidegrayline=no )
header(height=122 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=77 color="536870912" )
table(column=(type=long updatewhereclause=yes name=dis_banca_id_distinta_banca dbname="distinta_banca.id_dist_banca" )
 column=(type=long updatewhereclause=yes name=riga_dis_banca_num_riga dbname="riga_dis_banca.num_riga" )
 column=(type=char(80) updatewhereclause=yes name=rag_soc_1 dbname="ana.ana_rag_sociale" )
 column=(type=char(16) updatewhereclause=yes name=cod_fiscale dbname="ana.ana_c_f" )
 column=(type=char(16) updatewhereclause=yes name=par_iva dbname="ana.ana_p_iva" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_rag_soc_1 dbname="destinazione.dest_rag_soc" )
 retrieve="  SELECT ~"distinta_banca~".~"id_dist_banca~",   
         ~"riga_dis_banca~".~"num_riga~",   
         ~"ana~".~"ana_rag_sociale~",   
            
         ~"ana~".~"ana_c_f~",   
         ~"ana~".~"ana_p_iva~",   
         ~"destinazione~".~"dest_rag_soc~"
    FROM 
		dba.~"distinta_banca~",   
         dba.~"riga_dis_banca~",   
         dba.~"scadenza~",   
         dba.~"ana~",
		dba.~"conto~",
		dba.~"destinazione~",
		dba.~"doc~"
  
 WHERE ~"distinta_banca~".~"id_dist_banca~" = :rn_id_dis AND
			~"riga_dis_banca~".~"id_distinta_banca~" = ~"distinta_banca~".~"id_dist_banca~" AND
         ~"scadenza~".~"id_scadenza~"  = ~"riga_dis_banca~".~"id_scadenza~" AND
         ~"conto~".~"conto_id~" = ~"doc~".~"doc_conto_id~" AND
		scadenza.doc_id=doc.doc_id  and
         ~"ana~".~"ana_id~" = ~"conto~".~"ana_id~" and
			~"destinazione~".~"ana_id~"	=* ~"ana~".~"ana_id~" AND
			~"destinazione~".~"dest_tipo~" = 'R'
GROUP BY ~"distinta_banca~".~"id_dist_banca~",   
         ~"riga_dis_banca~".~"num_riga~",   
         ~"ana~".~"ana_rag_sociale~",   
         
         ~"ana~".~"ana_c_f~",   
         ~"ana~".~"ana_p_iva~",   
         ~"destinazione~".~"dest_rag_soc~" 
        
ORDER BY ~"riga_dis_banca~".~"num_riga~" ASC   
" arguments=(("rn_id_dis", number)) )
