 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dis_banca~" )  TABLE(NAME=~"riga_dis_banca~" )  TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"banca_sog_commerciale~" )  TABLE(NAME=~"banca_azienda~" )  TABLE(NAME=~"banca_appoggio~" ALIAS=~"banca_appoggio_a~" )  TABLE(NAME=~"banca_appoggio~" ALIAS=~"banca_appoggio_b~" ) COMPUTE(NAME=~"cast(' ' as char) as u1~") COMPUTE(NAME=~"cast('14' as char) as u2~") COLUMN(NAME=~"riga_dis_banca.num_riga~") COMPUTE(NAME=~"cast('     ' as char) as u3~") COLUMN(NAME=~"scadenza.data_scadenza~") COMPUTE(NAME=~"cast('30000' as char) as u4~") COMPUTE(NAME=~"cast('-' as char) as u5~") COLUMN(NAME=~"banca_appoggio_a.cod_abi~") COLUMN(NAME=~"banca_appoggio_a.cod_cab~") COMPUTE(NAME=~"cast('           ' as char) as u6~") COLUMN(NAME=~"banca_appoggio_b.cod_abi~") COLUMN(NAME=~"banca_appoggio_b.cod_cab~") COMPUTE(NAME=~"cast('           ' as char) as u7~") COLUMN(NAME=~"sog_commerciale.codice~") COMPUTE(NAME=~"cast('4' as char) as u8~") COLUMN(NAME=~"banca_azienda.codice_sia~") COLUMN(NAME=~"dis_banca.id_distinta_banca~") COLUMN(NAME=~"dis_banca.num_distinta~") COLUMN(NAME=~"banca_azienda.conto_corrente~") COMPUTE(NAME=~"cast(DATEFORMAT(~~~"scadenza~~~".~~~"data_scadenza~~~", 'ddmmyy') AS CHAR(6)) as d_crea_sup~") COMPUTE(NAME=~"CAST(fn_valuta_riba(~~~"dis_banca~~~".~~~"id_valuta~~~") as char(1)) as codice_divisa~") COMPUTE(NAME=~"CAST('' as char(13)) as importo_euro~") COLUMN(NAME=~"riga_dis_banca.imp_totale~")    JOIN (LEFT=~"scadenza.id_banca_sog_commerciale~"    OP =~"=~"RIGHT=~"banca_sog_commerciale.id_banca_sog_commerciale~"    OUTER1 =~"scadenza.id_banca_sog_commerciale~" )    JOIN (LEFT=~"banca_sog_commerciale.id_banca_appoggio~"    OP =~"=~"RIGHT=~"banca_appoggio_b.id_banca_appoggio~"    OUTER1 =~"banca_sog_commerciale.id_banca_appoggio~" )    JOIN (LEFT=~"riga_dis_banca.id_distinta_banca~"    OP =~"=~"RIGHT=~"dis_banca.id_distinta_banca~" )    JOIN (LEFT=~"scadenza.id_riga_distinta_banca~"    OP =~"=~"RIGHT=~"riga_dis_banca.id_riga_distinta_banca~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"scadenza.id_sog_commerciale~" )    JOIN (LEFT=~"banca_azienda.id_banca_azienda~"    OP =~"=~"RIGHT=~"dis_banca.id_banca_azienda~" )    JOIN (LEFT=~"banca_appoggio_a.id_banca_appoggio~"    OP =~"=~"RIGHT=~"banca_azienda.id_banca_appoggio~" )WHERE(    EXP1 =~"~~~"dis_banca~~~".~~~"id_distinta_banca~~~"~"   OP =~"=~"    EXP2 =~":rn_id_dis~" )  GROUP(NAME=~"dis_banca.id_distinta_banca~") GROUP(NAME=~"dis_banca.num_distinta~") GROUP(NAME=~"dis_banca.id_valuta~") GROUP(NAME=~"riga_dis_banca.num_riga~") GROUP(NAME=~"riga_dis_banca.imp_totale~") GROUP(NAME=~"banca_azienda.codice_sia~") GROUP(NAME=~"banca_azienda.conto_corrente~") GROUP(NAME=~"sog_commerciale.codice~") GROUP(NAME=~"scadenza.data_scadenza~") GROUP(NAME=~"banca_appoggio_b.cod_cab~") GROUP(NAME=~"banca_appoggio_b.cod_abi~") GROUP(NAME=~"banca_appoggio_a.cod_cab~") GROUP(NAME=~"banca_appoggio_a.cod_abi~")) ORDER(NAME=~"riga_dis_banca.num_riga~" ASC=yes ) ARG(NAME = ~"rn_id_dis~" TYPE = number) " arguments=(("rn_id_dis", number)) )
