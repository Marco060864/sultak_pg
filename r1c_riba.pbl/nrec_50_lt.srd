header(height=122 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=77 color="536870912" )
table(column=(type=long updatewhereclause=yes name=riga_dis_banca_num_riga dbname="riga_dis_banca.num_riga" )
 column=(type=long updatewhereclause=yes name=dis_banca_id_distinta_banca dbname="distinta_banca.id_dist_banca" )
 column=(type=char(40) updatewhereclause=yes name=rif_documento_1 dbname="rif_documento_1" )
 retrieve="  SELECT  ~"riga_dis_banca~".~"num_riga~" ,           ~"distinta_banca~".~"id_dist_banca~" , 
cast('Num.'+doc.doc_numero+' del ' + string(doc.doc_data) as char(40) )as rif_documento_1

FROM  dba.~"distinta_banca~" ,           dba.~"riga_dis_banca~" ,           dba.~"scadenza~"  , dba.~"doc~"   
WHERE  ~"riga_dis_banca~".~"id_distinta_banca~" = ~"distinta_banca~".~"id_dist_banca~" 
and           ~"scadenza~".~"id_scadenza~" = ~"riga_dis_banca~".~"id_scadenza~" 
and 		 ~"scadenza~".~"doc_id~"=~"doc~".~"doc_id~"
and           ~"distinta_banca~".~"id_dist_banca~" = :rn_id_dis  
GROUP BY ~"riga_dis_banca~".~"num_riga~" ,           ~"distinta_banca~".~"id_dist_banca~" ,rif_documento_1

 ORDER BY ~"riga_dis_banca~".~"num_riga~"          ASC  " arguments=(("rn_id_dis", number)) )
compute(band=header alignment="0" expression="/* c3 + space(1) + n_doc */"border="0" color="0" x="3840" y="176" height="58" width="183" format="[general]" html.valueishtml="0"  name=documento visible="1"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
