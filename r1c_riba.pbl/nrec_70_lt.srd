table(column=(type=long updatewhereclause=yes name=dis_banca_id_distinta_banca dbname="distinta_banca.id_dist_banca" )
 column=(type=long updatewhereclause=yes name=riga_dis_banca_num_riga dbname="riga_dis_banca.num_riga" )
 retrieve="  SELECT  ~"distinta_banca~".~"id_dist_banca~" ,           ~"riga_dis_banca~".~"num_riga~"     
FROM dba.~"distinta_banca~" ,           dba.~"riga_dis_banca~" ,           dba.~"scadenza~"     
WHERE ( ~"riga_dis_banca~".~"id_distinta_banca~" = ~"distinta_banca~".~"id_dist_banca~" ) 
and          ( ~"scadenza~".~"id_scadenza~" = ~"riga_dis_banca~".~"id_scadenza~" ) 
and          ( ( ~"distinta_banca~".~"id_dist_banca~" = :rn_id_dis ) )  
GROUP BY ~"distinta_banca~".~"id_dist_banca~" ,           ~"riga_dis_banca~".~"num_riga~"  
ORDER BY ~"riga_dis_banca~".~"num_riga~"          ASC  " arguments=(("rn_id_dis", number)) )
