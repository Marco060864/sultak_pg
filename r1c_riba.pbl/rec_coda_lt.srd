 column=(type=char(2) updatewhereclause=yes name=rb_2 dbname="rb_2" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_importi_negativi dbname="tot_importi_negativi" )
 column=(type=char(1) updatewhereclause=yes name=codice_divisa dbname="codice_divisa" )
 column=(type=char(15) updatewhereclause=yes name=tot_importi_negativi_euro dbname="tot_importi_negativi_euro" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"azienda~" )  TABLE(NAME=~"banca_appoggio~" )  TABLE(NAME=~"banca_azienda~" )  TABLE(NAME=~"dis_banca~" ) COMPUTE(NAME=~"cast(' ' as char) as rb_1~") COMPUTE(NAME=~"SUBSTR(~~~"banca_azienda~~~".~~~"codice_sia~~~" || '00000', 1, 5) AS codice_sia~") COMPUTE(NAME=~"SUBSTR(~~~"banca_appoggio~~~".~~~"cod_abi~~~" || '00000', 1, 5) AS cod_abi~") COMPUTE(NAME=~"cast(DATEFORMAT(:rd_data_riba, 'ddmmyy') as char(6)) as d_crea_sup~") COMPUTE(NAME=~"SUBSTR(~~~"azienda~~~".~~~"rag_soc_1~~~" || '                    ', 1, 20) AS rag_soc_1~") COMPUTE(NAME=~"SUBSTR(~~~"dis_banca~~~".~~~"id_distinta_banca~~~" || '                    ', 1, 6) AS dis_banca_id_distinta_banca~") COMPUTE(NAME=~"CAST(' ' as char(1)) as filler~") COMPUTE(NAME=~"CAST('00000' as char(5)) as centro_applicativo~") COMPUTE(NAME=~"CAST('                                                                    ' as char(69)) as rb_3~") COMPUTE(NAME=~"CAST(:rn_num_disp AS INTEGER) AS num_disp~") COMPUTE(NAME=~"cast('EF' as char) as rb_2~") COMPUTE(NAME=~"CAST(:rn_tot_importi_negativi AS DECIMAL(18, 4)) AS tot_importi_negativi~") COMPUTE(NAME=~"CAST(fn_valuta_riba(~~~"dis_banca~~~".~~~"id_valuta~~~") as char(1)) as codice_divisa~") COMPUTE(NAME=~"cast('' as char(15)) as tot_importi_negativi_euro~")    JOIN (LEFT=~"banca_azienda.id_banca_appoggio~"    OP =~"=~"RIGHT=~"banca_appoggio.id_banca_appoggio~" )    JOIN (LEFT=~"dis_banca.id_banca_azienda~"    OP =~"=~"RIGHT=~"banca_azienda.id_banca_azienda~" )WHERE(    EXP1 =~"( ( ~~~"dis_banca~~~".~~~"id_distinta_banca~~~"~"   OP =~"=~"    EXP2 =~":rn_id_dis ) )~" ) ) ARG(NAME = ~"rn_id_dis~" TYPE = number)  ARG(NAME = ~"rd_data_riba~" TYPE = date)  ARG(NAME = ~"rn_num_disp~" TYPE = number)  ARG(NAME = ~"rn_tot_importi_negativi~" TYPE = number) " arguments=(("rn_id_dis", number),("rd_data_riba", date),("rn_num_disp", number),("rn_tot_importi_negativi", number)) )
