 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ana~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"distinta_banca~" )  TABLE(NAME=~"riga_dis_banca~" )  TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"doc~" )  TABLE(NAME=~"azienda~" ) COLUMN(NAME=~"distinta_banca.id_dist_banca~") COLUMN(NAME=~"riga_dis_banca.num_riga~") COLUMN(NAME=~"ana.ana_rag_sociale~") COLUMN(NAME=~"ana.ana_indirizzo~") COLUMN(NAME=~"ana.ana_localita~") COLUMN(NAME=~"azienda.az_rag_sociale~") COLUMN(NAME=~"azienda.rag_soc2~")    JOIN (LEFT=~"ana.ana_id~"    OP =~"=~"RIGHT=~"conto.ana_id~" )    JOIN (LEFT=~"riga_dis_banca.id_scadenza~"    OP =~"=~"RIGHT=~"scadenza.id_scadenza~" )    JOIN (LEFT=~"distinta_banca.id_dist_banca~"    OP =~"=~"RIGHT=~"riga_dis_banca.id_distinta_banca~" )    JOIN (LEFT=~"doc.doc_id~"    OP =~"=~"RIGHT=~"scadenza.doc_id~" )    JOIN (LEFT=~"doc.doc_conto_id~"    OP =~"=~"RIGHT=~"conto.conto_id~" )WHERE(    EXP1 =~"~~~"distinta_banca~~~".~~~"id_dist_banca~~~"~"   OP =~"=~"    EXP2 =~":rn_id_dis~" )  GROUP(NAME=~"distinta_banca.id_dist_banca~") GROUP(NAME=~"riga_dis_banca.num_riga~") GROUP(NAME=~"ana.ana_indirizzo~") GROUP(NAME=~"ana.ana_rag_sociale~") GROUP(NAME=~"ana.ana_localita~") GROUP(NAME=~"azienda.rag_soc2~") GROUP(NAME=~"azienda.az_rag_sociale~")) ORDER(NAME=~"riga_dis_banca.num_riga~" ASC=yes ) ARG(NAME = ~"rn_id_dis~" TYPE = number) " arguments=(("rn_id_dis", number)) )
