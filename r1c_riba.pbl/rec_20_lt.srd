table(column=(type=long updatewhereclause=yes identity=yes name=dis_banca_id_distinta_banca dbname="dis_banca.id_distinta_banca" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_dis_banca_num_riga dbname="riga_dis_banca.num_riga" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_1 dbname="anagrafica.rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=indirizzo dbname="anagrafica.indirizzo" )
 column=(type=char(40) updatewhereclause=yes name=localita dbname="anagrafica.localita" )
 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_1 dbname="azienda.rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=azienda_rag_soc_2 dbname="azienda.rag_soc_2" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dis_banca~" )  TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"riga_dis_banca~" )  TABLE(NAME=~"sog_commerciale~" )  TABLE(NAME=~"anagrafica~" )  TABLE(NAME=~"azienda~" ) COLUMN(NAME=~"dis_banca.id_distinta_banca~") COLUMN(NAME=~"riga_dis_banca.num_riga~") COLUMN(NAME=~"anagrafica.rag_soc_1~") COLUMN(NAME=~"anagrafica.indirizzo~") COLUMN(NAME=~"anagrafica.localita~") COLUMN(NAME=~"azienda.rag_soc_1~") COLUMN(NAME=~"azienda.rag_soc_2~")    JOIN (LEFT=~"riga_dis_banca.id_riga_distinta_banca~"    OP =~"=~"RIGHT=~"scadenza.id_riga_distinta_banca~" )    JOIN (LEFT=~"riga_dis_banca.id_distinta_banca~"    OP =~"=~"RIGHT=~"dis_banca.id_distinta_banca~" )    JOIN (LEFT=~"sog_commerciale.id_sog_commerciale~"    OP =~"=~"RIGHT=~"scadenza.id_sog_commerciale~" )    JOIN (LEFT=~"anagrafica.id_anagrafica~"    OP =~"=~"RIGHT=~"sog_commerciale.id_anagrafica~" )    JOIN (LEFT=~"anagrafica.id_azienda~"    OP =~"=~"RIGHT=~"azienda.id_azienda~" )WHERE(    EXP1 =~"~~~"dis_banca~~~".~~~"id_distinta_banca~~~"~"   OP =~"=~"    EXP2 =~":rn_id_dis~" )  GROUP(NAME=~"dis_banca.id_distinta_banca~") GROUP(NAME=~"riga_dis_banca.num_riga~") GROUP(NAME=~"anagrafica.indirizzo~") GROUP(NAME=~"anagrafica.rag_soc_1~") GROUP(NAME=~"anagrafica.localita~") GROUP(NAME=~"azienda.rag_soc_2~") GROUP(NAME=~"azienda.rag_soc_1~")) ORDER(NAME=~"riga_dis_banca.num_riga~" ASC=yes ) ARG(NAME = ~"rn_id_dis~" TYPE = number) " arguments=(("rn_id_dis", number)) )
