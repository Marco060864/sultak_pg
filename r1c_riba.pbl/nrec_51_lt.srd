table(column=(type=char(64) updatewhereclause=yes name=rag_soc_1 dbname="azienda.az_rag_sociale" )
 column=(type=long updatewhereclause=yes name=num_riga dbname="riga_dis_banca.num_riga" )
 retrieve="  SELECT  ~"azienda~".~"az_rag_sociale~" ,           ~"riga_dis_banca~".~"num_riga~"    
 FROM ~"distinta_banca~" ,           ~"azienda~" ,           ~"scadenza~" ,           ~"riga_dis_banca~"    
 WHERE ( ~"riga_dis_banca~".~"id_scadenza~" = ~"scadenza~".~"id_scadenza~" ) 
and          ( ~"riga_dis_banca~".~"id_distinta_banca~" = ~"distinta_banca~".~"id_dist_banca~" )
 // and          ( ~"azienda~".~"id_azienda~" = ~"distinta_banca~".~"id_azienda~" )
 and          ( ( ~"distinta_banca~".~"id_dist_banca~" = :rn_id_dis ) )  
GROUP BY  ~"azienda~".~"az_rag_sociale~"  ,           ~"riga_dis_banca~".~"num_riga~" 
 ORDER BY ~"riga_dis_banca~".~"num_riga~"          ASC  " arguments=(("rn_id_dis", number)) )
