 column=(type=char(69) updatewhereclause=yes name=rb_3 dbname="rb_3" )
 column=(type=char(1) updatewhereclause=yes name=codice_divisa dbname="codice_divisa" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"azienda~" )  TABLE(NAME=~"banca_appoggio~" )  TABLE(NAME=~"banca_azienda~" )  TABLE(NAME=~"dis_banca~" ) COMPUTE(NAME=~"cast(' ' as char) as rb_1~") COMPUTE(NAME=~"cast('IB' as char) as rb_2~") COMPUTE(NAME=~"SUBSTR(~~~"banca_azienda~~~".~~~"codice_sia~~~" || '00000', 1, 5) AS codice_sia~") COMPUTE(NAME=~"SUBSTR(~~~"banca_appoggio~~~".~~~"cod_abi~~~" || '00000', 1, 5) AS cod_abi~") COMPUTE(NAME=~"cast(DATEFORMAT(:rd_data_riba, 'ddmmyy') as char(6)) as d_crea_sup~") COMPUTE(NAME=~"SUBSTR(~~~"azienda~~~".~~~"rag_soc_1~~~" || '                    ', 1, 20) AS rag_soc_1~") COMPUTE(NAME=~"SUBSTR(~~~"dis_banca~~~".~~~"id_distinta_banca~~~" || '                    ', 1, 6) AS dis_banca_id_distinta_banca~") COMPUTE(NAME=~"CAST(' ' as char(1)) as filler~") COMPUTE(NAME=~"CAST('00000' as char(5)) as centro_applicativo~") COMPUTE(NAME=~"CAST('                                                                    ' as char(69)) as rb_3~") COMPUTE(NAME=~"CAST(fn_valuta_riba(~~~"dis_banca~~~".~~~"id_valuta~~~") as char(1)) as codice_divisa~")    JOIN (LEFT=~"banca_azienda.id_banca_appoggio~"    OP =~"=~"RIGHT=~"banca_appoggio.id_banca_appoggio~" )    JOIN (LEFT=~"dis_banca.id_banca_azienda~"    OP =~"=~"RIGHT=~"banca_azienda.id_banca_azienda~" )WHERE(    EXP1 =~"( ( ~~~"dis_banca~~~".~~~"id_distinta_banca~~~"~"   OP =~"=~"    EXP2 =~":rn_id_dis ) )~" ) ) ARG(NAME = ~"rn_id_dis~" TYPE = number)  ARG(NAME = ~"rd_data_riba~" TYPE = date) " arguments=(("rn_id_dis", number),("rd_data_riba", date)) )
