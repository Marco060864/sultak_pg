 column=(type=char(12) updatewhereclause=yes name=conto_corrente dbname="conto_banca.c_c" )
 column=(type=char(6) updatewhereclause=yes name=d_crea_sup dbname="d_crea_sup" )
 column=(type=char(1) updatewhereclause=yes name=codice_divisa dbname="codice_divisa" )
 column=(type=char(13) updatewhereclause=yes name=importo_euro dbname="importo_euro" )
 column=(type=decimal(4) updatewhereclause=yes name=scad_importo dbname="scadenza.scad_importo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"distinta_banca~" )  TABLE(NAME=~"riga_dis_banca~" )  TABLE(NAME=~"scadenza~" )  TABLE(NAME=~"banca~" ALIAS=~"banca_a~" )  TABLE(NAME=~"doc~" )  TABLE(NAME=~"conto~" )  TABLE(NAME=~"conto_banca~" )  TABLE(NAME=~"banca~" ALIAS=~"banca_b~" )  TABLE(NAME=~"az_banca~" ) COMPUTE(NAME=~"cast(' ' as char) as u1~") COMPUTE(NAME=~"cast('14' as char) as u2~") COLUMN(NAME=~"riga_dis_banca.num_riga~") COMPUTE(NAME=~"cast('     ' as char) as u3~") COLUMN(NAME=~"scadenza.scad_data~") COMPUTE(NAME=~" cast('30000' as char) as u4~") COMPUTE(NAME=~"cast('-' as char) as u5~") COLUMN(NAME=~"banca_a.banca_cod_abi~") COLUMN(NAME=~"banca_a.banca_cod_cab~") COMPUTE(NAME=~"cast('           ' as char) as u6~") COLUMN(NAME=~"banca_b.banca_cod_abi~") COLUMN(NAME=~"banca_b.banca_cod_cab~") COMPUTE(NAME=~"cast('           ' as char) as u7~") COLUMN(NAME=~"conto.conto_codice~") COMPUTE(NAME=~"cast('4' as char) as u8~") COLUMN(NAME=~"az_banca.cod_sia~") COLUMN(NAME=~"distinta_banca.id_dist_banca~") COLUMN(NAME=~"distinta_banca.numero~") COLUMN(NAME=~"conto_banca.c_c~") COMPUTE(NAME=~" cast(DATEFORMAT(~~~"scadenza~~~".~~~"scad_data~~~", 'ddmmyy') AS CHAR(6)) as d_crea_sup~") COMPUTE(NAME=~"CAST('E' as char(1)) as codice_divisa~") COMPUTE(NAME=~"CAST('' as char(13)) as importo_euro~") COLUMN(NAME=~"scadenza.scad_importo~")    JOIN (LEFT=~"conto.conto_id~"    OP =~"=~"RIGHT=~"doc.doc_conto_id~"    OUTER2 =~"doc.doc_conto_id~" )    JOIN (LEFT=~"conto.conto_id~"    OP =~"=~"RIGHT=~"conto_banca.conto_id~"    OUTER1 =~"conto.conto_id~" )    JOIN (LEFT=~"conto_banca.banca_id~"    OP =~"=~"RIGHT=~"banca_b.banca_id~"    OUTER1 =~"conto_banca.banca_id~" )    JOIN (LEFT=~"distinta_banca.id_banca_ditta~"    OP =~"=~"RIGHT=~"az_banca.id_banca_azienda~"    OUTER1 =~"distinta_banca.id_banca_ditta~" )    JOIN (LEFT=~"az_banca.id_banca~"    OP =~"=~"RIGHT=~"banca_a.banca_id~"    OUTER1 =~"az_banca.id_banca~" )    JOIN (LEFT=~"riga_dis_banca.id_scadenza~"    OP =~"=~"RIGHT=~"scadenza.id_scadenza~" )    JOIN (LEFT=~"distinta_banca.id_dist_banca~"    OP =~"=~"RIGHT=~"riga_dis_banca.id_distinta_banca~" )    JOIN (LEFT=~"doc.doc_id~"    OP =~"=~"RIGHT=~"scadenza.doc_id~" )WHERE(    EXP1 =~"~~~"distinta_banca~~~".~~~"id_dist_banca~~~"~"   OP =~"=~"    EXP2 =~":id_dist~" ) ) ARG(NAME = ~"id_dist~" TYPE = number) " arguments=(("id_dist", number)) )
