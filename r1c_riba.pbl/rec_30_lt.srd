release 6;
datawindow(units=0 timer_interval=0 color=78682240 processing=0 print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=120 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=long updatewhereclause=yes name=dis_banca_id_distinta_banca dbname="dis_banca.id_distinta_banca" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_dis_banca_num_riga dbname="riga_dis_banca.num_riga" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_1 dbname="anagrafica.rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=rag_soc_2 dbname="anagrafica.rag_soc_2" )
 column=(type=char(16) updatewhereclause=yes name=cod_fiscale dbname="anagrafica.cod_fiscale" )
 column=(type=char(16) updatewhereclause=yes name=par_iva dbname="anagrafica.par_iva" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_rag_soc_1 dbname="destinazione.rag_soc_1" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_rag_soc_2 dbname="destinazione.rag_soc_2" )
 retrieve="  SELECT ~"dis_banca~".~"id_distinta_banca~",   
         ~"riga_dis_banca~".~"num_riga~",   
         ~"anagrafica~".~"rag_soc_1~",   
         ~"anagrafica~".~"rag_soc_2~",   
         ~"anagrafica~".~"cod_fiscale~",   
         ~"anagrafica~".~"par_iva~",   
         ~"destinazione~".~"rag_soc_1~",   
         ~"destinazione~".~"rag_soc_2~"  
    FROM ~"dis_banca~",   
         ~"riga_dis_banca~",   
         ~"scadenza~",   
         ~"anagrafica~",
			~"sog_commerciale~",
			~"destinazione~"
   WHERE ~"dis_banca~".~"id_distinta_banca~" = :rn_id_dis AND
			~"riga_dis_banca~".~"id_distinta_banca~" = ~"dis_banca~".~"id_distinta_banca~" AND
         ~"scadenza~".~"id_riga_distinta_banca~"  = ~"riga_dis_banca~".~"id_riga_distinta_banca~" AND
         ~"sog_commerciale~".~"id_sog_commerciale~" = ~"scadenza~".~"id_sog_commerciale~" AND
         ~"anagrafica~".~"id_anagrafica~" = ~"sog_commerciale~".~"id_anagrafica~" and
			~"destinazione~".~"id_sog_commerciale~"	=* ~"sog_commerciale~".~"id_sog_commerciale~" AND
			~"destinazione~".~"tipo_destinazione~" = 'R'
GROUP BY ~"dis_banca~".~"id_distinta_banca~",   
         ~"riga_dis_banca~".~"num_riga~",   
         ~"anagrafica~".~"rag_soc_1~",   
         ~"anagrafica~".~"rag_soc_2~",   
         ~"anagrafica~".~"cod_fiscale~",   
         ~"anagrafica~".~"par_iva~",   
         ~"destinazione~".~"rag_soc_1~",   
         ~"destinazione~".~"rag_soc_2~"
ORDER BY ~"riga_dis_banca~".~"num_riga~" ASC   
" arguments=(("rn_id_dis", number)) )
