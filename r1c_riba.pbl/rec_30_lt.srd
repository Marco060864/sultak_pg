text(band=header alignment="2" text="Dis Banca
Id Distinta Banca"border="0" color="0" x="5" y="4" height="112" width="366"  name=dis_banca_id_distinta_banca_t  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
text(band=header alignment="2" text="Riga Dis Banca
Num Riga"border="0" color="0" x="379" y="4" height="112" width="334"  name=riga_dis_banca_num_riga_t  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=detail alignment="0" expression="space(1) +
'30' +
right('0000000' + riga_dis_banca_num_riga, 7) +

left( 
if( isnull(destinazione_rag_soc_1),  if(isnull(rag_soc_1), space(30), rag_soc_1),
 destinazione_rag_soc_1) 
+ space(30), 30) +

left( 
if(isnull(destinazione_rag_soc_2), if(isnull(rag_soc_2), space(30), rag_soc_2),
destinazione_rag_soc_2 ) 
+ space(30), 30) +

left( if(isnull(cod_fiscale),  space(16), cod_fiscale)  + space(16), 16) +
space(34)
