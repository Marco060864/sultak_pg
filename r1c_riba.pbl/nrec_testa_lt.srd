table(column=(type=char(1) updatewhereclause=yes name=rb_1 dbname="rb_1" )
 column=(type=char(2) updatewhereclause=yes name=rb_2 dbname="rb_2" )
 column=(type=char(5) updatewhereclause=yes name=codice_sia dbname="codice_sia" )
 column=(type=char(5) updatewhereclause=yes name=cod_abi dbname="cod_abi" )
 column=(type=char(6) updatewhereclause=yes name=d_crea_sup dbname="d_crea_sup" )
 column=(type=char(20) updatewhereclause=yes name=rag_sociale dbname="rag_sociale" )
 column=(type=char(6) updatewhereclause=yes name=distinta_banca_id_distinta_banca dbname="distinta_banca_id_distinta_banca" )
 column=(type=char(1) updatewhereclause=yes name=filler dbname="filler" )
 column=(type=char(5) updatewhereclause=yes name=centro_applicativo dbname="centro_applicativo" )
 column=(type=char(69) updatewhereclause=yes name=rb_3 dbname="rb_3" )
 column=(type=char(1) updatewhereclause=yes name=codice_divisa dbname="codice_divisa" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"banca~" )  TABLE(NAME=~"distinta_banca~" )  TABLE(NAME=~"azienda~" )  TABLE(NAME=~"az_banca~" ) COMPUTE(NAME=~"cast(' ' as char) as rb_1~") COMPUTE(NAME=~"cast('IB' as char) as rb_2~") COMPUTE(NAME=~"SUBSTR(~~~"az_banca~~~".~~~"cod_sia~~~" || '00000', 1, 5) AS codice_sia~") COMPUTE(NAME=~"SUBSTR(~~~"banca~~~".~~~"banca_cod_abi~~~" || '00000', 1, 5) AS cod_abi~") COMPUTE(NAME=~"cast(DATEFORMAT(:r_data_riba, 'ddmmyy') as char(6)) as d_crea_sup~") COMPUTE(NAME=~"SUBSTR(~~~"azienda~~~".~~~"az_rag_sociale~~~" || '                    ', 1, 20) AS rag_sociale~") COMPUTE(NAME=~"SUBSTR(~~~"distinta_banca~~~".~~~"id_dist_banca~~~" || '                    ', 1, 6) AS distinta_banca_id_distinta_banca~") COMPUTE(NAME=~"CAST(' ' as char(1)) as filler~") COMPUTE(NAME=~"CAST('00000' as char(5)) as centro_applicativo~") COMPUTE(NAME=~"CAST('                                                                    ' as char(69)) as rb_3~") COMPUTE(NAME=~"CAST('E' as char(1)) as codice_divisa~")    JOIN (LEFT=~"distinta_banca.id_banca_ditta~"    OP =~"=~"RIGHT=~"az_banca.id_banca_azienda~" )    JOIN (LEFT=~"az_banca.id_banca~"    OP =~"=~"RIGHT=~"banca.banca_id~" )WHERE(    EXP1 =~"~~~"distinta_banca~~~".~~~"id_dist_banca~~~"~"   OP =~"=~"    EXP2 =~":id_dist~" ) ) ARG(NAME = ~"id_dist~" TYPE = number)  ARG(NAME = ~"r_data_riba~" TYPE = date) " arguments=(("id_dist", number),("r_data_riba", date)) )
