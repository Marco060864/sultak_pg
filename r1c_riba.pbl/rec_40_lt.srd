footer(height=0 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=long updatewhereclause=yes name=dis_banca_id_distinta_banca dbname="dis_banca.id_distinta_banca" )
 column=(type=char(40) updatewhereclause=yes name=indirizzo dbname="anagrafica.indirizzo" )
 column=(type=char(40) updatewhereclause=yes name=localita dbname="anagrafica.localita" )
 column=(type=char(10) updatewhereclause=yes name=cap dbname="anagrafica.cap" )
 column=(type=char(5) updatewhereclause=yes name=provincia dbname="anagrafica.provincia" )
 column=(type=decimal(0) updatewhereclause=yes name=riga_dis_banca_num_riga dbname="riga_dis_banca.num_riga" )
 column=(type=char(25) updatewhereclause=yes name=loc_prov dbname="loc_prov" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_indirizzo dbname="destinazione.indirizzo" )
 column=(type=char(10) updatewhereclause=yes name=destinazione_cap dbname="destinazione.cap" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_localita dbname="destinazione.localita" )
 column=(type=char(5) updatewhereclause=yes name=destinazione_provincia dbname="destinazione.provincia" )
 column=(type=char(25) updatewhereclause=yes name=destinazione_loc_prov dbname="destinazione_loc_prov" )
 retrieve="  SELECT ~"dis_banca~".~"id_distinta_banca~",   
         ~"anagrafica~".~"indirizzo~",   
         ~"anagrafica~".~"localita~",   
         ~"anagrafica~".~"cap~",   
         ~"anagrafica~".~"provincia~",   
         ~"riga_dis_banca~".~"num_riga~",   
         CAST(SUBSTR(~"anagrafica~".~"localita~" || ' ' || ~"anagrafica~".~"provincia~", 1, 25) AS CHAR(25)) AS loc_prov,   
         ~"destinazione~".~"indirizzo~",   
         ~"destinazione~".~"cap~",   
         ~"destinazione~".~"localita~",   
         ~"destinazione~".~"provincia~",   
         CAST(SUBSTR( ~"destinazione~".~"localita~" || ' ' || ~"destinazione~".~"provincia~" , 1, 25) AS CHAR(25)) AS destinazione_loc_prov  
    FROM ~"dis_banca~",   
         ~"riga_dis_banca~",   
         ~"scadenza~",   
         ~"anagrafica~",
			~"sog_commerciale~",
			~"destinazione~"
   WHERE ~"dis_banca~".~"id_distinta_banca~" = :rn_id_dis AND
			~"riga_dis_banca~".~"id_distinta_banca~" = ~"dis_banca~".~"id_distinta_banca~" AND
         ~"scadenza~".~"id_riga_distinta_banca~"  = ~"riga_dis_banca~".~"id_riga_distinta_banca~" AND
         ~"sog_commerciale~".~"id_sog_commerciale~" = ~"scadenza~".~"id_sog_commerciale~" AND
         ~"anagrafica~".~"id_anagrafica~" = ~"sog_commerciale~".~"id_anagrafica~" and
			~"destinazione~".~"id_sog_commerciale~"	=* ~"sog_commerciale~".~"id_sog_commerciale~" AND
			~"destinazione~".~"tipo_destinazione~" = 'R'
GROUP BY ~"dis_banca~".~"id_distinta_banca~",   
         ~"anagrafica~".~"indirizzo~",   
         ~"anagrafica~".~"localita~",   
         ~"anagrafica~".~"cap~",   
         ~"anagrafica~".~"provincia~",   
         ~"riga_dis_banca~".~"num_riga~",
			~"destinazione~".~"indirizzo~", 
         ~"destinazione~".~"cap~",   
         ~"destinazione~".~"localita~",   
         ~"destinazione~".~"provincia~"
ORDER BY ~"riga_dis_banca~".~"num_riga~" ASC   
" arguments=(("rn_id_dis", number)) )
