table(column=(type=long updatewhereclause=yes name=dis_banca_id_distinta_banca dbname="distinta_banca.id_dist_banca" )
 column=(type=char(40) updatewhereclause=yes name=indirizzo dbname="ana.ana_indirizzo" )
 column=(type=char(40) updatewhereclause=yes name=localita dbname="ana.ana_localita" )
 column=(type=char(5) updatewhereclause=yes name=cap dbname="ana.ana_cap" )
 column=(type=char(2) updatewhereclause=yes name=provincia dbname="ana.ana_provincia" )
 column=(type=long updatewhereclause=yes name=riga_dis_banca_num_riga dbname="riga_dis_banca.num_riga" )
 column=(type=char(25) updatewhereclause=yes name=loc_prov dbname="loc_prov" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_indirizzo dbname="destinazione.dest_indirizzo" )
 column=(type=char(10) updatewhereclause=yes name=destinazione_cap dbname="destinazione.dest_cap" )
 column=(type=char(40) updatewhereclause=yes name=destinazione_localita dbname="destinazione.dest_localita" )
 column=(type=char(5) updatewhereclause=yes name=destinazione_provincia dbname="destinazione.dest_provincia" )
 column=(type=char(25) updatewhereclause=yes name=destinazione_loc_prov dbname="destinazione_loc_prov" )
 retrieve="  SELECT ~"distinta_banca~".~"id_dist_banca~",   
         ~"ana~".~"ana_indirizzo~",   
         ~"ana~".~"ana_localita~",   
         ~"ana~".~"ana_cap~",   
         ~"ana~".~"ana_provincia~",   
         ~"riga_dis_banca~".~"num_riga~",   
         CAST(SUBSTR(~"ana~".~"ana_localita~" || ' ' || ~"ana~".~"ana_provincia~", 1, 25) AS CHAR(25)) AS loc_prov,   
         ~"destinazione~".~"dest_indirizzo~",   
         ~"destinazione~".~"dest_cap~",   
         ~"destinazione~".~"dest_localita~",   
         ~"destinazione~".~"dest_provincia~",   
         CAST(SUBSTR( ~"destinazione~".~"dest_localita~" || ' ' || ~"destinazione~".~"dest_provincia~" , 1, 25) AS CHAR(25)) AS destinazione_loc_prov  
    FROM dba.~"distinta_banca~",   
         dba.~"riga_dis_banca~",   
         dba.~"scadenza~",   
         dba.~"ana~",
			dba.~"conto~",
			dba.~"destinazione~", 
dba.~"doc~"
   WHERE ~"distinta_banca~".~"id_dist_banca~" = :rn_id_dis AND
			~"riga_dis_banca~".~"id_distinta_banca~" = ~"distinta_banca~".~"id_dist_banca~" AND
         ~"scadenza~".~"id_scadenza~"  = ~"riga_dis_banca~".~"id_scadenza~" AND
		~"scadenza~".~"doc_id~"=~"doc~".~"doc_id~" and
         ~"conto~".~"conto_id~" = ~"doc~".~"doc_conto_id~" AND

         ~"ana~".~"ana_id~" = ~"conto~".~"ana_id~" and
			~"destinazione~".~"ana_id~"	=* ~"conto~".~"ana_id~" AND
			~"destinazione~".~"dest_tipo~" = 'R'
GROUP BY ~"distinta_banca~".~"id_dist_banca~",   
         ~"ana~".~"ana_indirizzo~",   
         ~"ana~".~"ana_localita~",   
         ~"ana~".~"ana_cap~",   
         ~"ana~".~"ana_provincia~",   
         ~"riga_dis_banca~".~"num_riga~", 
			~"destinazione~".~"dest_indirizzo~",   
         ~"destinazione~".~"dest_cap~",   
         ~"destinazione~".~"dest_localita~",   
         ~"destinazione~".~"dest_provincia~"
ORDER BY ~"riga_dis_banca~".~"num_riga~" ASC   
" arguments=(("rn_id_dis", number)) )
