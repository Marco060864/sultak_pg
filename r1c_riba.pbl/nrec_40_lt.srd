compute(band=detail alignment="0" expression=" space(1) +
'40' +
right('0000000' + riga_dis_banca_num_riga, 7) +

if ( not isnull(  destinazione_indirizzo ) ,   
   (left(destinazione_indirizzo + space(30), 30) +
   left(if(isnull(  destinazione_cap  ), space(5),  destinazione_cap ) + space(5), 5)  +
   left(if(isnull(   destinazione_loc_prov  ), space(25),   destinazione_loc_prov  ) +         space(25), 25 ) ),

   (left(if(isnull( indirizzo ), space(30), indirizzo) + space(30), 30) +
   left(if(isnull( cap ), space(5), cap) + space(5), 5)  +
   left(if(isnull(  loc_prov ), space(25),  loc_prov ) + space(25), 25) )
   ) +

