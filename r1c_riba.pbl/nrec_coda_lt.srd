table(column=(type=char(1) updatewhereclause=yes name=rb_1 dbname="rb_1" )
 column=(type=char(5) updatewhereclause=yes name=codice_sia dbname="codice_sia" )
 column=(type=char(5) updatewhereclause=yes name=cod_abi dbname="cod_abi" )
 column=(type=char(6) updatewhereclause=yes name=d_crea_sup dbname="d_crea_sup" )
 column=(type=char(20) updatewhereclause=yes name=rag_sociale dbname="rag_sociale" )
 column=(type=char(6) updatewhereclause=yes name=dis_banca_id_distinta_banca dbname="dis_banca_id_distinta_banca" )
 column=(type=char(1) updatewhereclause=yes name=filler dbname="filler" )
 column=(type=char(5) updatewhereclause=yes name=centro_applicativo dbname="centro_applicativo" )
 column=(type=char(69) updatewhereclause=yes name=rb_3 dbname="rb_3" )
 column=(type=long updatewhereclause=yes name=num_disp dbname="num_disp" )
 column=(type=char(2) updatewhereclause=yes name=rb_2 dbname="rb_2" )
 column=(type=decimal(4) updatewhereclause=yes name=tot_importi_negativi dbname="tot_importi_negativi" )
 column=(type=char(1) updatewhereclause=yes name=codice_divisa dbname="codice_divisa" )
 column=(type=char(15) updatewhereclause=yes name=tot_importi_negativi_euro dbname="tot_importi_negativi_euro" )
 retrieve="  SELECT  cast(' ' as char) as rb_1,          
 SUBSTR(~"az_banca~".~"cod_sia~" || '00000', 1, 5) AS codice_sia,         
  SUBSTR(~"banca~".~"banca_cod_abi~" || '00000', 1, 5) AS cod_abi,       
    cast(DATEFORMAT(:rd_data_riba, 'ddmmyy') as char(6)) as d_crea_sup,           
SUBSTR(~"azienda~".~"az_rag_sociale~" || '                    ', 1, 20) AS rag_sociale,         
  SUBSTR(~"distinta_banca~".~"id_dist_banca~" || '                    ', 1, 6) AS dis_banca_id_distinta_banca,      
     CAST(' ' as char(1)) as filler,          
 CAST('00000' as char(5)) as centro_applicativo,           
CAST('                                                                    ' as char(69)) as rb_3,          
 CAST(:rn_num_disp AS INTEGER) AS num_disp,          
 cast('EF' as char) as rb_2,          
 CAST(:rn_tot_importi_negativi AS DECIMAL(18, 4)) AS tot_importi_negativi,           
CAST('E' as char(1)) as codice_divisa,          
 cast('' as char(15)) as tot_importi_negativi_euro    


FROM dba.~"azienda~" ,           dba.~"banca~" ,          dba.~"distinta_banca~"     , dba.~"az_banca~"
WHERE    ~"distinta_banca~".~"id_banca_ditta~" = ~"az_banca~".~"id_banca_azienda~"  
and ~"az_banca~".~"id_banca~"=~"banca~".~"banca_id~"
and  ~"distinta_banca~".~"id_dist_banca~" = :rn_id_dis   
" arguments=(("rn_id_dis", number),("rd_data_riba", date),("rn_num_disp", number),("rn_tot_importi_negativi", number)) )
